    namiont:osmId "2408277376" ;
    namiont:textTeaser "Schweizer Klassiker und von der Welt inspirierte Gerichte mitten im Airport Center am Flughafen."@de,
        "Swiss classics and internationally inspired dishes at the Airport Center at Zurich Airport."@en,
        "Classiques suisses et plats d’inspiration internationale à l’Airport Center de l’aéroport."@fr,
        "Classici svizzeri e pietanze internazionali nel cuore dell’Airport Center dell’aeroporto di Zurigo."@it ;
    namiont:titleTeaser "Restaurant Upperdeck"@de,
        "Upperdeck Restaurant"@en,
