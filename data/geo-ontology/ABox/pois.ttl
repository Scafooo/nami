    schema:priceRange "<table class=\"MsoNormalTable\"><tbody><tr><td><p>Im Ticket inbegriffen:</p><ul><li>5 x 33 cl gekühlte hopfige Biere</li><li>3-Gang Geniessermenü bei der Station «Hopfentropfen»</li><li>Digitale Beschreibung der Biere</li></ul></td></tr></tbody></table>"@de,
        "<table class=\"MsoNormalTable\"><tbody><tr><td><p>Included in the ticket:</p><ul><li>5 x 33 cl chilled, hoppy beers</li><li>3-course gourmet menu at the “Hopfentropfen” station</li><li>Digital description of the beers</li></ul></td></tr></tbody></table>"@en,
        "<table class=\"MsoNormalTable\"><tbody><tr><td><p>Inclus dans le ticket&nbsp;:</p><ul><li>5 x 33 cl de bières houblonnées réfrigérées</li><li>Un menu gourmand à 3 plats à la station «&nbsp;Hopfentropfen&nbsp;»</li><li>Description numérique des bières</li></ul></td></tr></tbody></table>"@fr,
        "<table class=\"MsoNormalTable\"><tbody><tr><td><p>Il biglietto comprende:</p><ul><li>&nbsp;5 birre luppolate fresche da 33 cl</li><li>un menu da 3 portate alla tappa “Hopfentropfen”</li><li>la descrizione digitale delle birre</li></ul></td></tr></tbody></table>"@it ;
    schema:telephone "+41 52 301 21 21" ;
    schema:url <https://www.zuercher-weinland.ch/region-entdecken/ausfluege-touren/fuehrungen/gruppenfuehrung/hopfen-bierpfad/> .

