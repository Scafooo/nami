    namiont:specialOpeningHoursNote "<p>Montag bis Freitag, 11.30 Uhr &ndash; sp&auml;t<br> Samstag und Sonntag, 16.00 Uhr &ndash; sp&auml;t</p>"@de,
        "<p>Monday &ndash; Friday, 11.30 am &ndash; late<br> Saturday &amp; Sunday, 4pm &ndash; late</p>"@en,
        "<p>Du lundi au vendredi, 11h30 jusqu&rsquo;&agrave; tard dans la nuit<br>Samedi et dimanche, 16h jusqu&rsquo;&agrave; tard dans la nuit</p>"@fr,
