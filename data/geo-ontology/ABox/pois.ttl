            schema:caption "Hotel Allegra Lodge - Suite"@de ;
            schema:contentUrl <https://www.zuerich.com/sites/default/files/web_zuerich_hotel_allegra_lodge_1280x960_29726.jpg> ] ;
    schema:license "CC BY-SA" ;
