            schema:contentUrl <https://www.zuerich.com/sites/default/files/image/2021/web_zurich_natur-und-sport_rickenloipe_1280x960.jpg> ] ;
    schema:license "CC BY-SA" ;
    schema:telephone "+41 55 284 18 38" ;
    schema:url <https://www.rickenloipe.ch/> .

