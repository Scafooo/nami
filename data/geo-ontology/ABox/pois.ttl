    namiont:specialOpeningHoursNote "<p>Finden Sie hier alle&nbsp;<a href=\"https://www.juckerfarm.ch/hoferlebnis/baechlihof/\">&Ouml;ffnungszeiten</a>&nbsp;im Detail.</p>"@de,
