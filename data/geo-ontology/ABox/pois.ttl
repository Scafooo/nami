    namiont:detailedInformation "Blick auf den Zürichsee und den Sechseläutenplatz"@de,
        "Französische Küche"@de,
        "Historisches Flair"@de,
        "French cuisine"@en,
        "Historic flair"@en,
        "View of Lake Zurich and Sechseläutenplatz"@en,
        "Ambiance historique"@fr,
        "Cuisine française"@fr,
