        <https://example.org/nami/data/category/89> ;
    geo:hasGeometry _:N1214056e5d0e47c69dab46403abbe4d0 ;
    namiont:detailedInformation "Kostenloses «Museum» in einem Parkhaus"@de,
        "Kurzer Überblick über einstige Pfahlbauten"@de,
        "Zweitälteste erhaltene Holztür der Welt"@de,
        "Free “museum” in an underground car park "@en,
        "Short overview of prehistoric pile dwellings"@en,
        "The second oldest preserved wooden door in the world "@en,
        "Bref aperçu sur les anciens sites lacustres"@fr,
        "La 2e plus vieille porte en bois du monde encore préservée"@fr,
        "Le « musée » gratuit du parking souterrain"@fr,
        "Breve panoramica delle antiche palafitte"@it,
        "Seconda porta in legno più antica del mondo"@it,
        "“Museo” gratuito in un autosilo"@it ;
    namiont:osmId "1740683849" ;
    namiont:specialOpeningHoursNote "<p>Durchgehend und &ouml;ffentlich zug&auml;nglich</p>"@de,
