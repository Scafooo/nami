    namiont:specialOpeningHoursNote "<p>Warme K&uuml;che bis 21.30 Uhr<p><strong>&Ouml;ffnungszeiten Metzgerei</strong></p><p>Dienstag &ndash; Freitag: 11.45 &ndash; 14.00 Uhr / 17.00 &ndash; 19.00 Uhr</p><p>Samstag: 12.00 &ndash; 17.00 Uhr</p><p>Weitere Infos zu den &Ouml;ffnungszeiten sind <a href=\"https://www.williamsbutcherstable.ch/oeffnungszeiten-kontakt/zuerich-hegibachplatz/\">hier</a> zu finden.</p></p>"@de,
        "<p>Hot meals served until 9:30pm<p><strong>Butcher Shop Hours</strong></p><p>Tuesday &ndash; Friday: 11:45am &ndash; 2pm / 5 &ndash; 7pm</p><p>Saturday: 12pm &ndash; 5pm</p><p>Further information about the hours of operation is available <a href=\"https://www.williamsbutcherstable.ch/en/opening-hours-contact/zuerich-hegibachplatz/\">here</a>.</p></p>"@en,
        "<p>Plats chauds jusqu'&agrave; 21h30<p><strong>Horaires d'ouverture de la boucherie</strong></p><p>Du mardi au vendredi : de 11h45 &agrave; 14h / de 17h &agrave; 19h</p><p>Samedi : de 12h &agrave; 17h</p><p>De plus amples informations sur les horaires d'ouverture sont disponibles <a href=\"https://www.williamsbutcherstable.ch/en/opening-hours-contact/zuerich-hegibachplatz/\">ici</a>.</p></p>"@fr,
        "<p>Cucina calda fino alle 21.30<p><strong>Orari di apertura della macelleria</strong></p><p>Da marted&igrave; a venerd&igrave;: da 11.45 a 14.00 / da 17.00 a 19.00</p><p>Sabato: da 12.00 a 17.00</p><p>Maggiori informazioni sugli orari di apertura sono disponibili <a href=\"https://www.williamsbutcherstable.ch/en/opening-hours-contact/zuerich-hegibachplatz/\">qui</a>.</p></p>"@it ;
