    geo:hasGeometry _:N87ad31d60f4e4e6bb835a52d8d90bfce ;
    namiont:detailedInformation "Gemütliche kleine Bar"@de,
        "Nahe Langstrasse"@de,
        "Close to Langstrasse"@en,
        "Cozy little bar"@en,
