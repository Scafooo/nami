    geo:hasGeometry _:N95dbe4cda78b4ad4a67fdc10a013d976 ;
    namiont:customType "Market" ;
    namiont:detailedInformation "Frischwarenmärkte"@de,
        "In der Zuger Altstadt"@de,
        "Regionale Produkte"@de,
        "Fresh produce markets"@en,
        "In the Old Town of Zug "@en,
        "Regional produce"@en,
        "Dans la vieille ville de Zoug"@fr,
        "Marchés de produits frais"@fr,
        "Produits régionaux"@fr,
        "Mercati di prodotti freschi"@it,
        "Nel centro storico di Zugo"@it,
