        "Hotel MyWay"@it ;
    schema:address [ a schema:PostalAddress ;
            schema:addressCountry "CH" ;
            schema:addressLocality "Wallisellen" ;
            schema:postalCode "8304" ;
            schema:streetAddress "Bahnhofstrasse 6" ] ;
