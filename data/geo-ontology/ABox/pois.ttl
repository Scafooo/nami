                "Bergwerk Käpfnach - ancienne mine de lignite et de marne à Horgen"@fr,
                "Miniera di Käpfnach: una ex miniera di lignite e marna a Horgen"@it ;
            schema:contentUrl <https://www.zuerich.com/sites/default/files/keyvisual/web_zurich_kultur_bergwerk-kaepfnach_01.jpg> ] ;
    schema:license "CC BY-SA" ;
    schema:openingHours "Sa 13:00:00-16:30:00" ;
    schema:photo [ a schema:ImageObject ;
