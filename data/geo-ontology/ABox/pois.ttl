    namiont:specialOpeningHoursNote "<p><strong>Tropenh&auml;user</strong><br> T&auml;glich, 09.30 &ndash; 16.45 Uhr</p>"@de,
        "<p><strong>Tropical greenhouses</strong><br> Open daily, 9.30am &ndash; 4.45pm</p>"@en,
        "<p><strong>Serres tropicales</strong><br> tous les jours 9.30h - 16.45h</p>"@fr,
