    namiont:specialOpeningHoursNote "<p>Bar Freilager:<br> Montag &ndash; Samstag, 14.30 Uhr &ndash; 24.00 Uhr<br> Sonntag geschlossen</p>"@de,
        "<p>Bar Freilager:<br> Monday &ndash; Saturday, 2.30pm &ndash; 12.00 midnight<br> Sunday closed</p>"@en,
