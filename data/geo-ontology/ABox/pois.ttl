    namiont:specialOpeningHoursNote "<p><strong>Thai Street Food Market</strong><br>Dienstag und Mittwoch ab 17.00 Uhr<p><strong>&Agrave; la carte</strong><br>Donnerstag bis Samstag ab 17.00 Uhr</p><p><strong>Lazy Sunday Thai Market</strong><br>Sonntag ab 18.00 Uhr</p></p>"@de,
        "<p><strong>Thai Street Food Market</strong><br>Tuesday and Wednesday from 5.00pm<p><strong>&Agrave; la carte</strong><br>Thursday to Saturday from 5.00pm</p><p><strong>Lazy Sunday Thai Market</strong><br>Sunday from 6.00pm</p></p>"@en,
        "<p><strong>Thai Street Food Market</strong><br>Mardi et mercredi &agrave; partir de 17.00h<p><strong>&Agrave; la carte</strong><br>Du jeudi au samedi &agrave; partir de 17.00h</p><p><strong>Lazy Sunday Thai Market</strong><br>Dimanche &agrave; partir de 18h</p></p>"@fr,
        "<p><strong>Thai Street Food Market</strong><br>Marted&igrave; e mercoled&igrave; dalle 17.00<p><strong>&Agrave; la carte</strong><br>Da gioved&igrave; a sabato dalle 17.00</p><p><strong>Lazy Sunday Thai Market</strong><br>Domenica dalle ore 18.00</p></p>"@it ;
    namiont:textTeaser "Das thailändische Restaurant mit Lounge ist ein einzigartiges Erlebnis."@de,
        "The Thai restaurant with lounge is a unique experience."@en,
        "Le restaurant thaïlandais avec lounge est une expérience unique."@fr,
        "Il ristorante thailandese con lounge promette esperienze straordinarie."@it ;
    namiont:titleTeaser "Himmapan Lodge"@de,
        "Himmapan Lodge"@en,
