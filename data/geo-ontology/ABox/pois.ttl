    namiont:placeType namiont:Indoors ;
    namiont:specialOpeningHoursNote "<p>Sonntag: nur Lesesaal<br> Spezielle &Ouml;ffnungszeiten w&auml;hrend den Feiertagen</p>"@de,
        "<p>Sunday: reading room only<br> Special opening hours during the holidays</p>"@en,
