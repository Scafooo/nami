    geo:hasGeometry _:Nb823b4412e3248b0814160f9c53e88c1 ;
    namiont:detailedInformation "Authentische Kleinbrauerei"@de,
        "Frisches Bier direkt aus den Biertanks"@de,
        "Rampenverkauf"@de,
        "Authentic microbrewery"@en,
