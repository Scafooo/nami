    geo:hasGeometry _:N5b37952be4fd4f7c86e6650933a28d67 ;
    namiont:textTeaser "Urbanes Boutique-Hotel an bester Lage mitten in der Zürcher Altstadt."@de,
        "Charming boutique hotel in a prime location very close to Zurich’s Bahnhofstrasse."@en,
        "Hôtel-boutique urbain idéalement situé au cœur de la vieille ville zurichoise."@fr,
        "Boutique hotel urbano in posizione ideale nel cuore del centro storico zurighese."@it ;
    namiont:titleTeaser "Hotel St. Peter – A Sorell Experience"@de,
        "Hotel St. Peter – A Sorell Experience"@en,
        "Hotel St. Peter – A Sorell Experience"@fr,
        "Hotel St. Peter – A Sorell Experience"@it ;
    schema:address [ a schema:PostalAddress ;
            schema:addressCountry "CH" ;
