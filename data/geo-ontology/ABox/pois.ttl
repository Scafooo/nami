            schema:addressCountry "CH" ;
            schema:addressLocality "Kloten" ;
            schema:postalCode "8302" ;
            schema:streetAddress "Kirchgasse 16" ] ;
    schema:copyrightHolder "Zürich Tourismus www.zuerich.com"@de,
