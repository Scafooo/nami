    namiont:specialOpeningHoursNote "<p><strong>Restaurant &laquo;ZETT&raquo;</strong><br> Montag - Freitag<br> 10.00 - 16.00 Uhr<p><strong>Sportsbar &laquo;1930&raquo;</strong><br> Montag - Sonntag<br> 16.00 - 23.00 Uhr</p></p>"@de,
        "<p><strong>Restaurant &laquo;ZETT&raquo;</strong><br> Monday - Friday<br> 10.00am - 4.00pm<p><strong>Sportsbar &laquo;1930&raquo;</strong><br> Monday - Sunday<br> 4.00pm - 11.00pm</p></p>"@en,
