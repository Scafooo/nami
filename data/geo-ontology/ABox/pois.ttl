    schema:priceRange "<div class=\"table-container\"><table class=\"is-fullwidth table\"><tbody><tr><th>&nbsp;</th><td><strong>Tageseintritt</strong></td></tr><tr><th>&nbsp;Thermalbad inkl. Infinity Dachbad</th><td>CHF 42 (ab 15 Jahre)<br>CHF 22 (7 bis 14 Jahre)<br>CHF 14 (4 bis 6 Jahre)<br>gratis (0 bis 3 Jahre)</td></tr><tr><th>Römisch-Irisches Spa-Ritual inkl. Infinity Dachbad</th><td>&nbsp;CHF 68 (ab 16 Jahre)</td></tr><tr><th>Zürich Card-Besitzer:innen</th><td>10% Ermässigung</td></tr></tbody></table></div>"@de,
        "<div class=\"table-container\"><table class=\"table\"><tbody><tr><th>&nbsp;</th><td><strong>Day admission</strong></td></tr><tr><th>&nbsp;Thermalbad incl. Infinity rooftop bpool</th><td>CHF 42 (age&nbsp;15+)<br>CHF 22 (age 7 to 14)<br>CHF 14 (age 4 to&nbsp;6)<br>free (age 0 to 3)</td></tr><tr><th>Roman-Irish Spa Ritual incl. Infinity rooftop pool</th><td>&nbsp;CHF 68 (age 16+)</td></tr><tr><th>Zürich Card holders</th><td>10% discount</td></tr></tbody></table></div>"@en,
        """<div class="table-container">&nbsp;\r
<table>\r
	<thead>\r
	</thead>\r
	<tbody>\r
		<tr>\r
			<th>&nbsp;</th>\r
			<td><strong>Entrée journalière </strong></td>\r
		</tr>\r
		<tr>\r
			<th>&nbsp;Thermalisme avec piscine Infinity sur le toit</th>\r
			<td>\r
			<p>CHF 42 (a partir de 15 ans)<br />\r
			CHF 22 (de 7 à 14 ans)<br />\r
			CHF 14 (de 4 à&nbsp;6 ans)<br />\r
			Gratuit (de 0 à 3 ans)</p>\r
			</td>\r
		</tr>\r
		<tr>\r
			<th>Rituel spa romano-irlandais, y compris bain sur le toit</th>\r
