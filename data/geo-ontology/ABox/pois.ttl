    dct:subject <https://example.org/nami/data/category/97> ;
    geo:hasGeometry _:N19d3eb38d7e04b3b83c38df67b771530 ;
    namiont:detailedInformation "Flugschule"@de,
        "Passagierflüge buchbar"@de,
        "Umgeben von den Glarner Alpen"@de,
        "Flying school"@en,
        "Passenger flights bookabled"@en,
        "Set amidst the Glarner Alps"@en,
        "Ecole de vol"@fr,
        "Entouré par les Alpes glaronaises"@fr,
        "Réservation de vols passagers"@fr,
