    schema:address [ a schema:PostalAddress ;
            schema:addressCountry "CH" ;
            schema:addressLocality "Zürich" ;
            schema:postalCode "8001" ;
            schema:streetAddress "Stadelhoferstrasse 28" ] ;
    schema:copyrightHolder "Zürich Tourismus www.zuerich.com"@de,
        "Zurich Tourism www.zuerich.com"@en,
        "Zürich Tourisme www.zuerich.com"@fr,
        "Zürich Tourismo www.zuerich.com"@it ;
    schema:dateModified "2026-02-10T17:46:00"^^xsd:dateTime ;
    schema:dayOfWeek schema:Friday,
        schema:Monday,
        schema:Saturday,
        schema:Thursday,
        schema:Tuesday,
        schema:Wednesday ;
    schema:description "<p>Die B&auml;ckerei John Baker begl&uuml;ckt Brot-Liebhaber mit vielf&auml;ltigen und kreativen Brot-Kreationen am Bahnhof Stadelhofen in der N&auml;he von Bellevue und Sechsel&auml;utenplatz. Dabei setzt das Team von &laquo;John Baker&raquo; auf regionale und saisonale Ware. Im Winter werden daher beispielsweise keine Sonnenblumenkern-Brote hergestellt und die Hefe f&uuml;r den Brotteig wird in der hauseigenen Backstube selbst gez&uuml;chtet. Auch Ern&auml;hrungstrends wie vegane Produkte oder &laquo;No-Carb-Brote&raquo; werden in dieser B&auml;ckerei ernst genommen, weshalb stets an neuen Rezepten gefeilt wird.<p>&Uuml;brigens: Wer auf die Tragetasche verzichtet, erh&auml;lt als Dank einen Preisabschlag.</p></p>"@de,
        "<p>The John Baker bakery treats bread lovers to a wide and creative variety of breads at Stadelhofen Train Station, just a stone&rsquo;s throw from Bellevue and Sechsel&auml;utenplatz. For the kitchen team set great store by using regional and seasonal products. For example, in winter they do not make sunflower seed bread, and they culture their own yeast on the premises. Nutrition trends, such as vegan products or no-carb bread, are also taken very seriously, with the result that the bakery staff are always working on new recipes.<p>Incidentally, customers who dispense with a plastic bag are given a discount as a token of thanks for their eco-friendly behavior.</p></p>"@en,
        "<p>La boulangerie John Baker offre aux amateurs de pains des cr&eacute;ations vari&eacute;es et insolites, &agrave; la gare Stadelhofen pr&egrave;s de Bellevue et de la Sechsel&auml;utenplatz. L&rsquo;&eacute;quipe de &laquo;&nbsp;John Baker&nbsp;&raquo; mise sur des produits r&eacute;gionaux et saisonniers. L&rsquo;hiver, on ne fait pas de pain aux graines de tournesol et la levure pour la p&acirc;te &agrave; pain est cultiv&eacute;e dans le fournil de la maison. On y prend aussi au s&eacute;rieux l&rsquo;&eacute;volution de la di&eacute;t&eacute;tique avec des produits v&eacute;g&eacute;taliens ou les pains &laquo;&nbsp;no-carb&nbsp;&raquo;, c&rsquo;est pourquoi de nouvelles recettes sont constamment &eacute;labor&eacute;es.<p>D&rsquo;ailleurs, si vous n&rsquo;utilisez pas de sac, vous obtiendrez une r&eacute;duction en remerciement.</p></p>"@fr,
        "<p>Il panificio John Baker propone agli amanti del pane prodotti vari e creativi presso la stazione di Stadelhofen, nei pressi del Bellevue e della Sechsel&auml;utenplatz. Per farlo, il team di John Baker impiega prodotti regionali e stagionali. In inverno, per esempio, non si produce pane ai semi di girasole. E il lievito per la pasta del pane viene fatto in casa. Qui vengono prese sul serio anche le tendenze alimentari come prodotti vegani o pane &ldquo;no carb&rdquo;, pertanto si lavora costantemente a nuove ricette.<p>Da non dimenticare che, rinunciando alla borsa della spesa, si riceve uno sconto a titolo di ringraziamento.</p></p>"@it ;
    schema:disambiguatingDescription "Die sympathische Bäckerei John Baker mitten in Zürich setzt auf regionale und saisonale Produkte."@de,
        "The friendly John Baker bakery in the heart of Zurich attaches great importance to regional and seasonal products."@en,
        "La sympathique boulangerie John Baker au cœur de Zurich mise sur les produits régionaux et saisonniers."@fr,
        "Il simpatico panificio John Baker, in centro a Zurigo, punta su prodotti regionali e stagionali."@it ;
    schema:email "john@johnbaker.ch" ;
