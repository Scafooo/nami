    schema:priceRange "<table><tbody><tr><th>Regulär</th><td>CHF 15</td></tr><tr><th>Ermässigt</th><td>CHF 10</td></tr><tr><th>Kombiticket (regulär)</th><td>CHF 20 (alle Standorte)</td></tr><tr><th>Kombiticket (ermässigt)</th><td>CHF 15 (alle Standorte)</td></tr><tr><th>Zürich Card-Besitzer:innen</th><td>gratis</td></tr><tr><th>Unter 20 Jahren</th><td>gratis</td></tr></tbody></table><p>Info: Freier Eintritt jeden Donnerstag ab 17 Uhr</p>"@de,
        "<table><tbody><tr><th>Regular</th><td>CHF 15</td></tr><tr><th>Reduced</th><td>CHF 10</td></tr><tr><th>Combined ticket (regular)</th><td>CHF 20 (all locations)</td></tr><tr><th>Combined ticket&nbsp;(reduced)</th><td>CHF 15 (all locations)</td></tr><tr><th>Zürich Card holders</th><td>free</td></tr><tr><th>Under 20 years</th><td>free</td></tr></tbody></table><p>Info: Free admission every Thursday from 5 pm</p>"@en,
        "<table><tbody><tr><th>Tarif normal</th><td>CHF 15</td></tr><tr><th>Tarif réduit</th><td>CHF 10</td></tr><tr><th>Billet combiné (tarif normal)</th><td>CHF 15 (tous les sites)</td></tr><tr><th>Billet combiné (tarif réduit)</th><td>CHF 10 (tous les sites)</td></tr><tr><th>Zürich Card</th><td>gratuit</td></tr><tr><th>Moins de 20 ans</th><td>gratuit</td></tr></tbody></table><p>Info : entrée gratuite tous les jeudis à partir de 17h</p>"@fr,
        "<table><tbody><tr><th>Normale</th><td>CHF 15</td></tr><tr><th>Ridotto</th><td>CHF 10</td></tr><tr><th>Biglietto combinato (normale)</th><td>CHF 20 (tutte le sedi)</td></tr><tr><th>Biglietto combinato (ridotto)</th><td>CHF 15 (tutte le sedi)</td></tr><tr><th>Possessori di Zürich Card</th><td>gratuito</td></tr><tr><th>Minori di 20 anni</th><td>gratuito</td></tr></tbody></table><p>Info: Ingresso gratuito ogni giovedì dalle 17.00</p>"@it ;
