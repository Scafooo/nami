        <https://example.org/nami/data/category/182>,
        <https://example.org/nami/data/category/96> ;
    geo:hasGeometry _:Ne9307da168a24352baab6a30a2688431 ;
    namiont:detailedInformation "Für kleine und grosse Dino-Fans"@de,
        "Mit Museums-Shop"@de,
        "Original-Fossilien"@de,
        "Saurier-Skelette"@de,
