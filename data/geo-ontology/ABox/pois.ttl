    namiont:specialOpeningHoursNote "<p><strong>M&auml;rz bis Oktober:</strong><br> Montag bis Samstag 10.00 &ndash; 18.00 Uhr<br> Sonntag in Anschluss an den Gottesdienst offen<p><strong>November bis Februar:</strong><br> Montag bis Samstag 10.00 &ndash; 17.00 Uhr<br> Sonntag in Anschluss an den Gottesdienst offen</p></p>"@de,
        "<p><strong>March to October:</strong><br> Monday to Saturday 10.00am &ndash; 6.00pm<br> Open on Sundays after the service<p><strong>November to February:</strong><br> Monday to Saturday 10.00am &ndash; 5.00pm<br> Open on Sundays after the service</p></p>"@en,
        "<p><strong>De mars &agrave; octobre :</strong><br> De lundi &agrave; samedi : de 10h &agrave; 18h<br> Dimanche : ouverte apr&egrave;s la messe<p><strong>De novembre &agrave; f&eacute;vrier :</strong><br> De lundi &agrave; samedi : de 10h &agrave; 17h<br> Dimanche : ouverte apr&egrave;s la messe</p></p>"@fr,
        "<p><strong>Da marzo a ottobre:</strong><br> da luned&igrave; a sabato dalle 10.00 alle 18.00<br> Domenica aperta dopo la messa<p><strong>Da novembre a febbraio:</strong><br> da luned&igrave; a sabato dalle 10.00 alle 17.00<br> Domenica aperta dopo la messa</p></p>"@it ;
