    namiont:specialOpeningHoursNote "<p><a href=\"https://www.google.ch/maps/place/Victorinox+Flagship+Store+Z%C3%BCrich/@47.374067,8.5368667,17z/data=!3m1!4b1!4m5!3m4!1s0x47900a06f9cb9675:0x8a9d840e046b283a!8m2!3d47.374067!4d8.5390554\">Aktuelle &Ouml;ffnungszeiten</a></p>"@de,
