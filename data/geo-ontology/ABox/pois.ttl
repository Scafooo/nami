                "Gran Café Motta Zurigo"@it ;
            schema:contentUrl <https://www.zuerich.com/sites/default/files/keyvisual/web_zurich_gastronomie_gradn_cafe_motta_02_0.jpg> ] ;
    schema:license "CC BY-SA" ;
