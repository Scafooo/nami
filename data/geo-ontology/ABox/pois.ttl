        "<div class=\"table-container\"><table><tbody><tr><th>Normale</th><td>CHF 15</td></tr><tr><th>Ridotto</th><td>CHF 10</td></tr><tr><th>Biglietto combinato (normale)</th><td>CHF 20 (tutte le sedi)</td></tr><tr><th>Biglietto combinato (ridotto)</th><td>CHF 15 (tutte le sedi)</td></tr><tr><th>Possessori di Zürich Card</th><td>gratuito</td></tr><tr><th>Minori di 20 anni</th><td>gratuito</td></tr></tbody></table><p>Info: Ingresso gratuito ogni giovedì dalle 17.00</p></div>"@it ;
