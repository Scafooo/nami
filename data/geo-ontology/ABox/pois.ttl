    namiont:osmId "4281153" ;
    namiont:placeType namiont:Indoors ;
    namiont:specialOpeningHoursNote "<p><a href=\"https://www.landesmuseum.ch/de/ihr-besuch/oeffnungszeiten\">Spezielle &Ouml;ffnungszeiten Landesmuseum</a> w&auml;hrend den Feiertagen</p>"@de,
        "<p><a href=\"https://www.landesmuseum.ch/en/your-visit/opening-times\">Special opening hours Swiss National Museum</a> during the holidays</p>"@en,
        "<p><a href=\"https://www.landesmuseum.ch/fr/visite/horaires\">Heures d'ouverture sp&eacute;ciales Mus&eacute;e national suisse</a> pendant les jours f&eacute;ri&eacute;s</p>"@fr,
        "<p><a href=\"https://www.landesmuseum.ch/it/visita/orari-dapertura\">Orari d'apertura speciali Museo Nationale Svizzero</a> durante i giorni festivi</p>"@it ;
    namiont:textTeaser "Schmökern und stöbern könnte man hier stundenlang: Vom Souvenir bis zum Sachbuch gibt es alles."@de,
        "You can browse for hours here: from souvenirs to specialized books, there is something for everyone."@en,
        "On passerait des heures à explorer ses trésors : du souvenir à l’ouvrage spécialisé, tout est là."@fr,
        "Qui si potrebbe leggere e curiosare per ore: da souvenir a saggi, il negozio propone di tutto."@it ;
    namiont:titleTeaser "Shop Landesmuseum"@de,
        "National Museum Shop"@en,
        "Shop du Musée National"@fr,
        "Shop del Museo Nazionale"@it ;
    namiont:zurichCard false ;
