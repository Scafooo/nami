                "Buchmann Beck Rennweg"@en ;
            schema:contentUrl <https://www.zuerich.com/sites/default/files/keyvisual/web_zuerich_buchmann_rennweg_17668.jpg> ] ;
    schema:license "CC BY-SA" ;
