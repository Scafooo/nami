    geo:hasGeometry _:Ncb1698ce23fe45a0bb844824983caba0 ;
    namiont:placeType namiont:Outdoors ;
    namiont:textTeaser "In Uznach gibt es eine Kolonie mit rund 30 Störchen"@de,
        "Uznach is home to a colony of around 30 storks"@en,
        "A Uznacht on peut observer une colonie d’une trentaine de cigognes"@fr,
        "A Uznach si trova una colonia con circa 30 cicogne"@it ;
    namiont:titleTeaser "Storchenkolonie Uznach"@de,
        "Uznach Stork Colony"@en,
        "Les cigognes d'Uznach"@fr,
        "Colonia di cicogne"@it ;
    namiont:zurichCard false ;
    schema:address [ a schema:PostalAddress ;
            schema:addressCountry "CH" ;
            schema:addressLocality "Uznach" ;
            schema:postalCode "8730" ;
            schema:streetAddress "Im Zübli" ] ;
    schema:copyrightHolder "Zürich Tourismus www.zuerich.com"@de,
        "Zurich Tourism www.zuerich.com"@en,
        "Zürich Tourisme www.zuerich.com"@fr,
        "Zürich Tourismo www.zuerich.com"@it ;
    schema:dateModified "2025-11-21T11:27:00"^^xsd:dateTime ;
    schema:dayOfWeek schema:Friday,
        schema:Monday,
        schema:Saturday,
        schema:Sunday,
        schema:Thursday,
        schema:Tuesday,
        schema:Wednesday ;
    schema:description "<p>Neben den 150 Vogelarten im Kaltbrunner Ried hat auch der Storch seinen Platz in Uznach gefunden.<p>Hinter der Kreuzkirche, unweit des Bahnhofs, hat Storchenvater Ernst Friedrich eine Storchenkolonie aufgebaut, welche das ganze Jahr hindurch von rund 30 St&ouml;rchen bewohnt wird.</p></p>"@de,
        "<p>The storks live at the Kaltbrunner Riet along with the other 150 bird species that have made this region their home.<p>Through the years, Ernst Friedrich has built-up a stork colony behind the Kreuz church not far from the train station. The colony is now home to 30 storks throughout the year.</p></p>"@en,
        "<p>A c&ocirc;t&eacute; des 150 esp&egrave;ces d'oiseaux du Kaltbrunner Ried (zone humide prot&eacute;g&eacute;e), la cigogne a &eacute;galement trouv&eacute; sa place &agrave; Uznach.<p>Derri&egrave;re l'&eacute;glise Kreuzkirche, pr&egrave;s de la gare, le &laquo; p&egrave;re des cigognes &raquo; Ernst Friedrich a fond&eacute; une colonie de cigognes de pr&egrave;s de 30 individus qui y demeurent toute l'ann&eacute;e.</p></p>"@fr,
        "<p>Oltre alle 150 specie di uccelli che abitano la palude di Kaltbrunn, anche la cicogna ha trovato il proprio posto a Uznach.<p>Dietro alla chiesa Kreuzkirche, poco distante dalla stazione, il padre delle cicogne Ernst Friedrich ha creato una colonia che conta circa 30 esemplari tutto l'anno.</p></p>"@it ;
    schema:disambiguatingDescription "Die Storchenkolonie Uznach beherbergt 30 Störche, diese kann man hier live von ganz nahe beobachten."@de,
        "The Uznach stork colony contains around 30 storks, which can be observed live and up close"@en,
        "La colonie d’Uznacht compte environ 30 cigognes que vous pouvez les observer en liberté, de tout près."@fr,
        "La colonia di Uznach ospita 30 cicogne, che possono essere osservate da vicino."@it ;
    schema:email "praesident@storchenverein-uznach.ch" ;
    schema:geo _:Ncb1698ce23fe45a0bb844824983caba0 ;
    schema:identifier "2882" ;
    schema:image [ a schema:ImageObject ;
            schema:caption "Die Storchenkolonie Uznach"@de,
                "The Uznach stork colony"@en,
                "La colonie de cigognes Uznach"@fr,
                "La colonia di cicogne a Uznach"@it ;
            schema:contentUrl <https://www.zuerich.com/sites/default/files/keyvisual/web_zurich_natur_und_sport_storchenkolonie-uznach_01.jpg> ] ;
    schema:license "CC BY-SA" ;
    schema:photo [ a schema:ImageObject ;
            schema:contentUrl <https://www.zuerich.com/sites/default/files/web_zuerich_storch_uznach_26002.jpg> ] ;
    schema:telephone "+41 55 280 46 59" ;
    schema:url <http://www.storchenverein-uznach.ch> .

<https://example.org/nami/data/poi/2883> a schema:LocalBusiness,
