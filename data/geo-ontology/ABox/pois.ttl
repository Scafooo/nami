    namiont:detailedInformation "Entlang des Limmatufers"@de,
        "Gemütlicher Spaziergang"@de,
        "Restaurants am Wegrand"@de,
        "Along the banks of the Limmat"@en,
        "Leisurely walk"@en,
        "Restaurants along the way"@en,
        "Le long des rives de la Limmat"@fr,
        "Promenade agréable"@fr,
        "Restaurants au bord du chemin"@fr,
