    namiont:textTeaser "Ein Einblick in die 5000 Jahre alten Pfahlbauten von Zürich gibt’s in der Tiefgarage beim Opernhaus."@de,
        "The Opéra underground garage gives an insight into Zurich’s 5,000-year-old pile dwellings."@en,
        "Aperçu sur des cités lacustres de Zurich datant de 5.000 ans dans le parking souterrain de l’opéra."@fr,
        "Uno sguardo alle palafitte zurighesi di 5.000 anni fa nell’autosilo del Teatro dell’Opera."@it ;
    namiont:titleTeaser "Archäologisches Fenster Opéra"@de,
        "Opéra Archaeological Window"@en,
        "Archéologie sous l’Opéra"@fr,
        "Vetrina archeologica Opéra"@it ;
    namiont:zurichCard false ;
    schema:address [ a schema:PostalAddress ;
            schema:addressCountry "CH" ;
