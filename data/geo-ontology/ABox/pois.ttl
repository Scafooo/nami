    namiont:specialOpeningHoursNote "<p><strong>Goethe Bar</strong><br> Montag bis Donnerstag, 08.00 &ndash; 24.00 Uhr<br> Freitag&nbsp; 08.00 - 02.00 Uhr<br> Samstag 09.00 - 02.00 Uhr<br> Sonntag 10.00 - 23.00 Uhr</p>"@de,
