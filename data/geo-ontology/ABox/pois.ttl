    geo:hasGeometry _:N112918c2ab914f65b7267750c766eff4 ;
    namiont:detailedInformation "Im Hauptbahnhof Zürich"@de,
        "Professionelle Beratung"@de,
        "Viele Insidertipps"@de,
        "At Zurich Main Station"@en,
        "Competent advice"@en,
        "Many insider tips"@en,
        "Conseils compétents"@fr,
        "Et plus encore !"@fr,
        "À la gare centrale de Zurich "@fr,
