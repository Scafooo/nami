    geo:hasGeometry _:N3f6b359841534aa989c84ea44f963fd9 ;
    namiont:detailedInformation "3.1 km Länge"@de,
        "330 Höhenmeter"@de,
        "Anspruchsvoll"@de,
        "Verpflegung in der Nähe"@de,
        "«Schlitteltelefon» gibt Auskunft über Pistenzustand"@de,
