    schema:priceRange "<div class=\"table-container\"><table class=\"table\"><thead><tr><th><strong>Ganze Rundfahrt ohne Unterbruch</strong></th><th>&nbsp;</th></tr></thead><tbody><tr><th>Erwachsene</th><td>CHF 4.60</td></tr><tr><th>Kinder (6 – 16 Jahre), Halbtax, Hunde</th><td>CHF 3.20</td></tr></tbody></table></div>"@de,
        "<div class=\"table-container\"><table class=\"table\"><thead><tr><th><strong>Entire round trip without a break</strong></th><th>&nbsp;</th></tr></thead><tbody><tr><th>Adults</th><td>CHF 4.60</td></tr><tr><th>Children (6–16 years), Swiss Half-Fare Card holders, dogs</th><td>CHF 3.20</td></tr></tbody></table></div>"@en,
        "<div class=\"table-container\"><table class=\"table\"><thead><tr><th><strong>Circuit complet sans interruption</strong></th><th>&nbsp;</th></tr></thead><tbody><tr><th>Adultes</th><td>CHF 4,60</td></tr><tr><th>Enfants (de 6 à 16 ans), demi-tarif Chiens</th><td>CHF 3.20</td></tr></tbody></table></div>"@fr,
        "<div class=\"table-container\"><table class=\"table\"><thead><tr><th><strong>Giro intero senza soste</strong></th><th>&nbsp;</th></tr></thead><tbody><tr><th>Adulti</th><td>CHF 4.60</td></tr><tr><th>Bambini (6-16 anni) metà prezzo, cani</th><td>CHF 3.20</td></tr></tbody></table></div>"@it ;
