    geo:hasGeometry _:N0465cd00eee44a289cc77ab4d836dcb2 ;
    namiont:detailedInformation "Fondue-Plausch"@de,
        "Gruppenanlass"@de,
        "Zürich entdecken"@de,
        "neues Event-Tram"@de,
        "Discover Zurich"@en,
