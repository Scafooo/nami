    namiont:textTeaser "Unkomplizierte, lokal inspirierte Küche mit internationalem Flair."@de,
        "Uncomplicated, locally inspired cuisine with international flair."@en,
        "Cuisine simple d’inspiration locale dans une atmosphère internationale."@fr,
        "Cucina semplice, di ispirazione locale, con un tocco internazionale."@it ;
