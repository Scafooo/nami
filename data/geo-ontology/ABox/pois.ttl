    namiont:detailedInformation "Direkter Seeanstoss"@de,
        "Fischgerichte und Barbecue"@de,
        "Gemütlich, unkompliziert"@de,
        "Cozy & uncomplicated"@en,
        "Directly on the lakeshore"@en,
        "Fish dishes and BBQ food"@en,
        "Accès direct au lac"@fr,
        "Confortable, simple"@fr,
        "Plats de poissons et grillades"@fr,
