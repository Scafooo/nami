    namiont:specialOpeningHoursNote "<p><strong>Ausseneisfeld</strong><br>18. Oktober 2025 bis 9. M&auml;rz 2026<p><a href=\"https://www.stadt-zuerich.ch/de/stadtleben/sport-und-erholung/sport-und-badeanlagen/kunsteisbahnen/sportzentrum-heuried.html\">Mehr zur &Ouml;ffnungszeiten</a></p></p>"@de,
        "<p><strong>Ice-skating rink</strong><br>October 18, 2025 &ndash; March 8, 2026<p><a href=\"https://www.stadt-zuerich.ch/de/stadtleben/sport-und-erholung/sport-und-badeanlagen/kunsteisbahnen/sportzentrum-heuried.html\">More information</a></p></p>"@en,
        "<p><strong>Patinoire artificielle</strong><br>Du 18 octobre 2025 au 8 mars 2026<p><a href=\"https://www.stadt-zuerich.ch/de/stadtleben/sport-und-erholung/sport-und-badeanlagen/kunsteisbahnen/sportzentrum-heuried.html\">Plus d&rsquo;informations</a></p></p>"@fr,
        "<p><strong>Pista di pattinaggio</strong><br>18.10.2025 &ndash; 8.03.2026<p><a href=\"https://www.stadt-zuerich.ch/de/stadtleben/sport-und-erholung/sport-und-badeanlagen/kunsteisbahnen/sportzentrum-heuried.html\">Pi&ugrave;&nbsp;informazioni</a></p></p>"@it ;
    namiont:textTeaser "Im Sommer Freibad, im Winter Eisfeld: das geht im Sportzentrum Heuried unterhalb des Uetlibergs."@de,
        "Heuried sports center: in summer an open-air bathing facility, in winter an ice-skating rink."@en,
        "Piscine en plein air l’été et patinoire l’hiver au centre sportif Heuried, juste sous l’Uetliberg."@fr,
        "Il centro sportivo Heuried offre una piscina scoperta in estate e una pista di pattinaggio in inverno."@it ;
    namiont:titleTeaser "Sportzentrum Heuried"@de,
        "Heuried Sports Center"@en,
        "Centre sportif Heuried"@fr,
        "Centro sportivo Heuried"@it ;
