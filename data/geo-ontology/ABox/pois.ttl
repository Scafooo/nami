        <https://example.org/nami/data/category/97> ;
    geo:hasGeometry _:N84e46f9ef9e04810928d058bcb428978 ;
    namiont:detailedInformation "Diverse Schwierigkeitsgrade"@de,
        "Teilweise sehr steil "@de,
        "Zwei Biketrails am Uetliberg"@de,
        "Two bike trails on the Uetliberg"@en,
        "Various degrees of difficulty"@en,
        "Very steep in parts"@en,
        "Deux trails cyclistes sur l’Uetliberg"@fr,
        "Différents niveaux de difficulté "@fr,
        "En partie très abrupt"@fr,
        "Diversi gradi di difficoltà"@it,
        "Due bike trail sull’Uetliberg"@it,
