    schema:priceRange "<div class=\"table-container\"><table class=\"is-fullwidth table\"><thead><tr><th>&nbsp;</th><th>Eintritt</th></tr></thead><tbody><tr><th>Erwachsene</th><td>CHF 49</td></tr><tr><th>Auszubildende bis 30 (ID vorweisen)</th><td>CHF 40</td></tr><tr><th>Teenager (8 – 16)</th><td>CHF 30</td></tr><tr><th>Kinder (6 – 7)</th><td>CHF 25</td></tr><tr><th>Kleine Kinder (4 – 5)</th><td>CHF 15</td></tr><tr><th>«Fyrabig Klettere» (2 Stunden gültig)</th><td>CHF 35</td></tr></tbody></table></div>"@de,
        "<div class=\"table-container\"><table class=\"is-fullwidth table\"><thead><tr><th>&nbsp;</th><th>Entry</th></tr></thead><tbody><tr><th>Adults</th><td>CHF 49</td></tr><tr><th>Apprentices under 30 (ID required)</th><td>CHF 40</td></tr><tr><th>Teens (8 – 16)</th><td>CHF 30</td></tr><tr><th>Kids (6 – 7)</th><td>CHF 25</td></tr><tr><th>Young Children (4 – 5)</th><td>CHF 15</td></tr><tr><th>\"After Work Climbing\" (valid for 2 hours)</th><td>CHF 35</td></tr></tbody></table></div>"@en,
        "<div class=\"table-container\"><table class=\"table is-fullwidth\"><thead><tr><th>&nbsp;</th><th>Entry</th></tr></thead><tbody><tr><th>Adultes</th><td>CHF 45</td></tr><tr><th>Apprentis jusqu'à 25 (sur présentation d'une pièce d'identité)</th><td>CHF 40</td></tr><tr><th>Jeunes (8 – 16)</th><td>CHF 30</td></tr><tr><th>Enfants (6 – 7)</th><td>CHF 25</td></tr><tr><th>Enfants en bas âge (4 – 5)</th><td>CHF 15</td></tr><tr><th>« Escalade After Work » (valable 2 heures)</th><td>CHF 35</td></tr></tbody></table></div>"@fr,
        "<div class=\"table-container\"><table class=\"table is-fullwidth\"><thead><tr><th>&nbsp;</th><th>Entry</th></tr></thead><tbody><tr><th>Adulti</th><td>CHF 45</td></tr><tr><th>Apprendisti fino a 25 (mostrare la carta d'identità)</th><td>CHF 40</td></tr><tr><th>Giovani (8 – 16)</th><td>CHF 30</td></tr><tr><th>Bambini (6 – 7)</th><td>CHF 25</td></tr><tr><th>Bambini piccoli (4 – 5)</th><td>CHF 15</td></tr><tr><th>\"Roccia dopo il lavore\" (valido 2 ore)</th><td>CHF 35</td></tr></tbody></table></div>"@it .

