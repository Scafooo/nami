    dct:subject <https://example.org/nami/data/category/76> ;
    geo:hasGeometry _:N0834480b0a9f441886ce21a6e1eb0268 ;
    namiont:textTeaser "Traditioneller Gasthof am Fusse des Uetlibergs, unweit vom Stadtzentrum entfernt."@de,
        "Traditional guesthouse at the foot of the Uetliberg, not far from the city center."@en,
        "Hôtel traditionnel au pied de l’Uetliberg, non loin du centre-ville."@fr,
        "Tradizionale albergo ai piedi dell’Uetliberg, poco distante dal centro."@it ;
    namiont:titleTeaser "Landgasthof Leuen"@de,
