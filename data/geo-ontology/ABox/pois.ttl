    namiont:textTeaser "Das Schloss Kyburg ist Museum und Ausflugsort zugleich. Hier erleben Besuchende Geschichte hautnah."@de,
        "Kyburg Castle is a museum and an excursion destination. Here visitors experience history close up."@en,
        "Musée et lieu d’excursions, le château de Kybourg invite les visiteurs à la découverte de l’histoire."@fr,
        "Il castello di Kyburg è museo e meta escursionistica al tempo stesso. Qui si vive la storia da vicino."@it ;
    namiont:titleTeaser "Museum Schloss Kyburg"@de,
        "Museum Schloss Kyburg"@en,
        "Musée du château de Kybourg"@fr,
        "Museo del castello di Kyburg"@it ;
    namiont:zurichCard false ;
    schema:address [ a schema:PostalAddress ;
