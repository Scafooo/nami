    namiont:specialOpeningHoursNote "<p>Bar<br> Montag &ndash; Mittwoch, 08.00&nbsp;&ndash; 00.00 Uhr<br> Donnerstag und Freitag, 08.00&nbsp;&ndash; 01.00 Uhr<br> Samstag, 09.00&nbsp;&ndash; 01.00 Uhr<br> Sonntag, 09.00&nbsp;&ndash; 00.00 Uhr&nbsp;<p>Samstag und Sonntag Brunch bis 18.00 Uhr</p></p>"@de,
        "<p>Bar<br> Monday &ndash; Wednesday, 8.00am &ndash; 12.00am<br> Thursday and Friday, 8.00am &ndash; 1.00am<br> Saturday, 9.00am &ndash; 1.00am<br> Sunday, 9.00am &ndash; 12.00am<p>Every Saturday and Sunday Brunch until 6pm.</p></p>"@en,
        "<p>Bar<br> Du lundi au mercredi, 08.00h &ndash; 00.00h<br> Jeudi et vendredi, 08.00h &ndash; 01.00h<br> Samedi, 09.00h &ndash; 01.00h<br> Dimanche, 09.00h &ndash; 00.00h<p>Le Samedi et le Dimanche: Brunch jusqu'&agrave; 18h</p></p>"@fr,
        "<p>Bar<br> Dal luned&igrave; al mercoled&igrave;, 08.00 &ndash; 00.00<br> Gioved&igrave; e venerd&igrave;, 08.00 &ndash; 01.00<br> Sabato, 09.00 &ndash; 01.00<br> Domenica, 09.00 &ndash; 00.00<p>Il sabato e la domenica: Brunch fino alle 18.00</p></p>"@it ;
    namiont:textTeaser "Italienische Küche und Lebensart geniessen Gäste im Zürcher Seefeld-Quartier."@de,
        "Guests can enjoy Italian cuisine and way of life in Zurich’s Seefeld quarter."@en,
