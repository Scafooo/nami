    geo:hasGeometry _:N267c5f84b52641a58dc4755908de1874 ;
    namiont:detailedInformation " In einzelnen Etappen machbar"@de,
        "Insgesamt 43.5 km Laufstrecke"@de,
        "Joggingroute durch und um die Stadt"@de,
        "43.5 km (27 miles) long in total"@en,
        "Can be tackled in individual sections"@en,
        "Jogging route through and around the city"@en,
        "Distance totale de 43.5 km "@fr,
