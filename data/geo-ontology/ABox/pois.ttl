    namiont:detailedInformation "Circle Park "@de,
        "Direkt am Flughafen Zürich"@de,
        "Restaurants und Shops"@de,
        "Circle Park "@en,
        "Restaurants and stores"@en,
        "Right beside Zurich Airport"@en,
        "Parc « The Circle »"@fr,
        "Restaurants et boutiques"@fr,
        "Situé directement à l’aéroport de Zurich"@fr,
        "Circle Park"@it,
        "Direttamente all’aeroporto di Zurigo"@it,
        "Ristoranti e negozi"@it ;
    namiont:placeType namiont:Indoors,
        namiont:Outdoors ;
    namiont:textTeaser "Direkt am Flughafen gelegen, lädt The Circle mit Restaurants, Shops und einem Park zum Verweilen ein."@de,
        "Directly by the airport, The Circle invites visitors to linger, with restaurants, stores, and a park."@en,
        "Restaurants, boutiques et parc du The Circle situés directement à l'aéroport invitent à s’attarder."@fr,
        "Al The Circle, all’aeroporto, si trascorrono istanti piacevoli grazie a ristoranti, negozi e un parco."@it ;
    namiont:titleTeaser "The Circle"@de,
        "The Circle"@en,
        "The Circle"@fr,
        "The Circle"@it ;
