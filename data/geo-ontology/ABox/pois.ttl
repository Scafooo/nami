    namiont:specialOpeningHoursNote "<h4>Brunch<p>Sonntags, 11.00 &ndash; 15.00 Uhr</p><h4>Baur's Bar</h4><p>Sonntag - Donnerstag, 15.00 &ndash; 24.00 Uhr<br>Freitag &amp; Samstag, 15.00 &ndash;&nbsp;01 .00 Uhr</p></h4>"@de,
        "<h4>Brunch<p>Sundays, 11am &ndash; 3pm</p><h4>Baur's Bar&nbsp;</h4><p>Sunday &ndash; Thursday,&nbsp;3pm &ndash; 12am<br>Friday &amp; Saturday,&nbsp;3pm &ndash; 1am</p></h4>"@en,
