    schema:priceRange "<div class=\"table-container\"><table><thead><tr><th>&nbsp;</th><th>Eintritt</th></tr></thead><tbody><tr><th>Erwachsene</th><td>CHF 10</td></tr><tr><th>Kinder bis 6</th><td>gratis</td></tr><tr><th>Kinder 7 bis 16 Jahre</th><td>CHF 5</td></tr><tr><th>Familien</th><td>CHF 20</td></tr><tr><th>Gruppen: jeder 10. Eintritt</th><td>gratis</td></tr><tr><th><strong>Zürich Card-Besitzer:innen</strong></th><td>gratis</td></tr></tbody></table><p>&nbsp;</p></div>"@de,
        "<div class=\"table-container\"><table><thead><tr><th>&nbsp;</th><th>Ticket</th></tr></thead><tbody><tr><th>Adults</th><td>CHF 10</td></tr><tr><th>Children to 6 years old</th><td>free</td></tr><tr><th>Children (7 to 16 years old)</th><td>CHF 5</td></tr><tr><th>Family</th><td>CHF 20</td></tr><tr><th>Groups</th><td>every 10th person free</td></tr><tr><th><strong>Zürich Card holders</strong></th><td>free</td></tr></tbody></table></div><p>30% discount with a Zurich Cantonal Bank card</p>"@en,
        "<div class=\"table-container\"><table><thead><tr><th>&nbsp;</th><th>Entrée</th></tr></thead><tbody><tr><th>Adultes</th><td>CHF 10</td></tr><tr><th>Enfants (0-6)</th><td>gratuit</td></tr><tr><th>Enfants&nbsp;(7-16)</th><td>CHF 5</td></tr><tr><th>Familles</th><td>CHF 20</td></tr><tr><th>Groupes</th><td>Chaque 10ème entrée est gratuite</td></tr><tr><th><strong>Visiteurs en possession d’une Zürich Card</strong></th><td>gratuit</td></tr></tbody></table></div><p>Réduction de 30 % avec une carte de la banque cantonale zurichoise</p>"@fr,
        "<div class=\"table-container\"><table><thead><tr><th>&nbsp;</th><th>Entrata</th></tr></thead><tbody><tr><th>Adulti</th><td>CHF 10</td></tr><tr><th>Bambini (fino ai 6 anni)</th><td>gratuito</td></tr><tr><th>Bambini (7-16 anni)</th><td>CHF 5</td></tr><tr><th>Famiglie</th><td>CHF 20</td></tr><tr><th>Gruppi</th><td>ogni 10 entrata gratuita</td></tr><tr><th><strong>Visitatori in possesso di una Zürich Card</strong></th><td>gratuito</td></tr></tbody></table></div><p>30% di sconto con una carta della Banca cantonale di Zurigo</p>"@it ;
