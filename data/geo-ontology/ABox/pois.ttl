    namiont:specialOpeningHoursNote "<p>*Am Mittwoch steht der Saunabereich von 10.00 bis 16.00 Uhr exklusiv den Frauen zur Verf&uuml;gung.</p>"@de,
        "<p>*On Wednesdays, the sauna area is exclusively reserved for women from 10am to 4pm.</p>"@en,
