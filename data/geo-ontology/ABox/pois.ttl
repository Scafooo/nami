                "Langstrasse, Zurich"@en ;
            schema:contentUrl <https://www.zuerich.com/sites/default/files/image/2020/web_zuerich_langstrasse_nightlife_1280x960_4584.jpg> ],
        [ a schema:ImageObject ;
