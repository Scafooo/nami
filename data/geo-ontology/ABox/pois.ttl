    schema:priceRange """<p>Der Eintritt ins Historama beinhaltet Zugang zum Belvedere-Weg, zur Aussichtsplattform und zum Panorama-Lift.</p>\r
\r
<div class="table-container">\r
<table class="is-fullwidth table">\r
	<thead>\r
		<tr>\r
			<th>&nbsp;</th>\r
			<th>Pro Person</th>\r
		</tr>\r
	</thead>\r
	<tbody>\r
		<tr>\r
			<th>Erwachsene</th>\r
			<td>CHF 5</td>\r
		</tr>\r
		<tr>\r
			<th>Kinder (6 – 16 Jahre)</th>\r
			<td>CHF 3</td>\r
		</tr>\r
		<tr>\r
			<th>Gruppen von 15 bis 29 Personen</th>\r
			<td>CHF 3</td>\r
		</tr>\r
		<tr>\r
			<th>Gruppen von 30 und mehr Personen</th>\r
			<td>CHF 2</td>\r
		</tr>\r
	</tbody>\r
</table>\r
</div>\r
\r
<p>Tickets für Besucher im Rollstuhl, mit Kinderwagen und Gruppen ab 15 Personen sind ausschliesslich im Besucherzentrum erhältlich.</p>\r
\r
<p><a class="is-external link" href="https://shop.e-guma.ch/schlosslaufen-am-rheinfall/de/tickets/rheinfall-ticket-3670826">Online Tickets kaufen</a></p>"""@de,
        """<p>Admission to the Historama includes access to the Belvedere panoramic trail and the panoramic elevator&nbsp;</p>\r
\r
<div class="table-container">\r
<table class="is-fullwidth table">\r
	<thead>\r
		<tr>\r
			<th>&nbsp;</th>\r
			<th>per person</th>\r
		</tr>\r
	</thead>\r
	<tbody>\r
		<tr>\r
			<th>Adults</th>\r
			<td>CHF 5</td>\r
		</tr>\r
		<tr>\r
			<th>Children (6 – 16 years)</th>\r
			<td>CHF 3</td>\r
		</tr>\r
		<tr>\r
			<th>Groups of 15 up to 29 persons</th>\r
			<td>CHF 3</td>\r
		</tr>\r
		<tr>\r
			<th>Groups of 30 persons or more</th>\r
			<td>CHF 2</td>\r
		</tr>\r
	</tbody>\r
</table>\r
</div>\r
\r
<p>Tickets for visitors in a wheelchair, with a pram and groups of 15 or more&nbsp;are only available in the Visitor Centre.</p>\r
\r
<p><a class="is-external link" href="https://shop.e-guma.ch/schlosslaufen-am-rheinfall/en/tickets/rheinfall-ticket-3670826">Buy Tickets</a>&nbsp;</p>"""@en,
        """<p>L’entrée à l’Historama comprend l’accès au chemin Belvédère, à la plateforme panoramique et à l’ascenseur panoramique</p>\r
\r
<div class="table-container">\r
<table class="is-fullwidth table">\r
	<thead>\r
		<tr>\r
			<th>&nbsp;</th>\r
			<th>par personne</th>\r
		</tr>\r
	</thead>\r
	<tbody>\r
		<tr>\r
			<th>Adultes</th>\r
			<td>CHF 5</td>\r
		</tr>\r
		<tr>\r
			<th>Enfants (6 – 16 ans)</th>\r
			<td>CHF 3</td>\r
		</tr>\r
		<tr>\r
			<th>Groupes de 15 à 29 personnes</th>\r
			<td>CHF 3</td>\r
		</tr>\r
		<tr>\r
			<th>Groupes de 30 personnes min.</th>\r
			<td>CHF 2</td>\r
		</tr>\r
	</tbody>\r
</table>\r
</div>\r
\r
<p>Les billets pour personnes en fateuil roulant, avec poussettes et pour les groupes à partire de 15 personnes sont disponibles exclusivement au centre d'accueil.</p>\r
\r
<p><a class="is-external link" href="https://shop.e-guma.ch/schlosslaufen-am-rheinfall/en/tickets/rheinfall-ticket-3670826">Acheter billets</a></p>"""@fr,
        """<p>L’ingresso all’Historama comprende l’accesso al sentiero Belvedere, alla piattaforma panoramica e all’ascensore di vetro.</p>\r
\r
<div class="table-container">\r
<table class="is-fullwidth table">\r
	<thead>\r
		<tr>\r
			<th>&nbsp;</th>\r
			<th>a persona</th>\r
		</tr>\r
	</thead>\r
	<tbody>\r
		<tr>\r
			<th>Adulti</th>\r
			<td>CHF 5</td>\r
		</tr>\r
		<tr>\r
			<th>Bambini (6 – 16 anni)</th>\r
			<td>CHF 3</td>\r
		</tr>\r
		<tr>\r
			<th>Gruppi da 15 fino a 29 persone</th>\r
			<td>CHF 3</td>\r
		</tr>\r
		<tr>\r
			<th>Gruppi a partire da 30 persone o&nbsp;più</th>\r
			<td>CHF 2</td>\r
		</tr>\r
	</tbody>\r
</table>\r
</div>\r
\r
<p>I biglietti per visitatori in sedia a rotelle, con passeggino&nbsp;e gruppi&nbsp; a partire da 15 persone sono disponibili esclusivamente presso il Visitor Centre.</p>\r
\r
<p><a class="is-external link" href="https://shop.e-guma.ch/schlosslaufen-am-rheinfall/en/tickets/rheinfall-ticket-3670826">Comprare biglietti online</a></p>"""@it ;
