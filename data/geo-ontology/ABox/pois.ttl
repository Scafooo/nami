                "Aspect extérieur du Stadtmuseum Rapperswil-Jona (musée municipal)"@fr,
                "Vista esterna del Stadtmuseum Rapperswil-Jona (museo comunale)"@it ;
            schema:contentUrl <https://www.zuerich.com/sites/default/files/image/2022/web_zuerich_stadtmuseum_rapperswil_1280x960_PT_40776.jpg> ] ;
    schema:license "CC BY-SA" ;
    schema:openingHours "Su,Sa 11:00:00-17:00:00",
        "We,Th,Fr 14:00:00-17:00:00" ;
    schema:photo [ a schema:ImageObject ;
