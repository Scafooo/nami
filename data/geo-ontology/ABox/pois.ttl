    namiont:osmId "4869996376" ;
    namiont:textTeaser "Mitten auf dem Sechseläutenplatz geniessen die Gäste den ganzen Tag italienische Leckereien."@de,
        "In the middle of the Sechseläutenplatz square, guests can enjoy Italian delicacies all day long."@en,
