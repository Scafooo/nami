        <https://example.org/nami/data/category/99> ;
    geo:hasGeometry _:Nf40002f048fc4cb6a9b9ec02a27774ed ;
    namiont:detailedInformation "150 Meter breit, 23 Meter hoch"@de,
        "Grösster Wasserfall Europas"@de,
        "Naturspektakel"@de,
        "150 meters wide, 23 meters high"@en,
        "Largest waterfall in Europe"@en,
        "Natural spectacle"@en,
        "150 mètres de large, 23 mètres de haut"@fr,
        "Les plus grandes chutes d’eau d’Europe"@fr,
        "Spectacle de la nature"@fr,
        "La cascata più grande d’Europa"@it,
        "Larga 150 metri, alta 23"@it,
