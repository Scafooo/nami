    namiont:placeType namiont:Outdoors ;
    namiont:specialOpeningHoursNote "<p>Fr&uuml;hling bis Herbst, bei Regen geschlossen.</p>"@de,
        "<p>Spring through to fall, closed in wet weather.&nbsp;</p>"@en,
        "<p>Du printemps &agrave; l&rsquo;automne, ferm&eacute; les jours de pluie</p>"@fr,
        "<p>Dalla primavera all&rsquo;autunno; chiuso in caso di pioggia</p>"@it ;
    namiont:textTeaser "Ein kleines Paradies am See in Männedorf: Fisch aus dem Zürichsee und feinsten Grillwaren."@de,
        "A tiny paradise on the lakeshore in Männedorf: with fish from Lake Zurich and tasty BBQ dishes."@en,
        "Petit paradis au bord du lac à Männedorf avec poissons du lac de Zurich et savoureuses grillades."@fr,
        "Un piccolo paradiso in riva al lago a Männedorf: pesce del Lago di Zurigo e deliziose grigliate."@it ;
    namiont:titleTeaser "Schiffstation"@de,
        "Schiffstation"@en,
