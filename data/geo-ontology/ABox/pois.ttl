    namiont:detailedInformation "Aussicht auf die Alpen"@de,
        "Gartenterrasse"@de,
        "Stilvolles Landgasthaus"@de,
        "Elegant country inn"@en,
        "Garden terrace"@en,
        "View of the Alps"@en,
        "Restaurant rural raffiné"@fr,
        "Terrasse de jardin"@fr,
        "Vue sur les Alpes"@fr,
        "Elegante ristorante di campagna"@it,
        "Terrazza fiorita"@it,
        "Vista sulle Alpi"@it ;
    namiont:osmId "32967245" ;
    namiont:textTeaser "Essen und Service der Extraklasse mit prächtiger Alpensicht mitten in einem alten Rebberg in Herrliberg."@de,
        "Top-class food and service with a superb view of the Alps set amidst an old vineyard in Herrliberg."@en,
        "Restauration et service haut de gamme au cœur de l’ancien vignoble d’Herrliberg avec superbe vue sur les Alpes."@fr,
        "Cibo e servizio di altissimo livello in un antico vigneto di Herrliberg, con vista sulle Alpi."@it ;
    namiont:titleTeaser "Restaurant Buech, Herrliberg"@de,
        "Restaurant Buech, Herrliberg"@en,
        "Restaurant Buech, Herrliberg"@fr,
        "Ristorante Buech, Herrliberg"@it ;
    namiont:zurichCard false ;
    schema:address [ a schema:PostalAddress ;
            schema:addressCountry "CH" ;
            schema:addressLocality "Herrliberg" ;
            schema:postalCode "8704" ;
            schema:streetAddress "Forchstrasse 267" ] ;
    schema:copyrightHolder "Zürich Tourismus www.zuerich.com"@de,
        "Zurich Tourism www.zuerich.com"@en,
        "Zürich Tourisme www.zuerich.com"@fr,
