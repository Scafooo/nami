    namiont:textTeaser "Für Kultur- und Geschichtsliebhaber, die Zürich hautnah erleben und entdecken wollen."@de,
        "For culture and history lovers who want to experience and explore Zurich at close quarters."@en,
        "Pour les amateurs de culture et d’histoire désireux de connaître et découvrir Zurich de très près."@fr,
        "Per gli appassionati di cultura e storia che vogliono vivere e scoprire Zurigo da vicino."@it ;
    namiont:titleTeaser "Hotel Helmhaus"@de,
        "Hotel Helmhaus"@en,
        "Hôtel Helmhaus"@fr,
        "Hotel Helmhaus"@it ;
    schema:address [ a schema:PostalAddress ;
