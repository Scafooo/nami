    geo:hasGeometry _:N974faf1d41da41548b6a38cf616ed178 ;
    namiont:detailedInformation "3-Gang Menü geniessen"@de,
        "5 hopfige Biere kosten"@de,
        "Bierpfad mit 5 Stationen"@de,
        "Beer trail with 5 stations"@en,
        "Enjoy a 3-course menu"@en,
        "Taste 5 hoppy beers"@en,
        "Dégustation de 5 bières houblonnées"@fr,
        "Dégustation d’un menu à 3 plats"@fr,
        "Sentier de la bière avec 5 stations"@fr,
        "Degustazione di 5 birre luppolate"@it,
        "Menu da 3 portate"@it,
        "Sentiero brassicolo in 5 tappe"@it ;
    namiont:placeType namiont:Outdoors ;
    namiont:textTeaser "Die Vielfalt der Zürcher Bierkultur entdecken und die landschaftliche Schönheit des Stammertals geniessen."@de,
        "Discover the diversity of Zurich’s beer culture and enjoy the scenic beauty of the Stammertal valley."@en,
        "Découvrir la diversité de la culture zurichoise de la bière et apprécier la beauté des paysages de la Stammertal."@fr,
        "Scoprire la varietà della cultura brassicola zurighese e ammirare la bellezza della Stammertal."@it ;
    namiont:titleTeaser "Hopfen Bierpfad"@de,
        "Hops Beer Trail"@en,
        "Sentier de la bière Hopfen Bierpfad"@fr,
        "Sentiero del luppolo"@it ;
