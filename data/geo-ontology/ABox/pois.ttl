                "Volo a vela con \"Schänis Soaring\""@it ;
            schema:contentUrl <https://www.zuerich.com/sites/default/files/keyvisual/web_zuerich_natur-und-sport_segelflug-schanis_01.jpg> ] ;
    schema:license "CC BY-SA" ;
    schema:telephone "+41 055 250 50 00" ;
    schema:url <https://www.flugplatz-schaenis.ch> .

