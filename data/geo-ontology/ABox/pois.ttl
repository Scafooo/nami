    dct:subject <https://example.org/nami/data/category/72>,
        <https://example.org/nami/data/category/92> ;
    geo:hasGeometry _:N09eee539dd794760b220ab6d7d5f9d51 ;
    namiont:detailedInformation "Architekt Alfred Friedrich Bluntschli"@de,
        "Bedeutender Kirchenbau"@de,
        "Neorenaissance-Stil"@de,
        "Reformierte Kirche"@de,
        "Architect Alfred Friedrich Bluntschli"@en,
        "Important church building"@en,
        "Neo-Renaissance style"@en,
        "Reformed Church"@en,
        "Architecte Alfred Friedrich Bluntschli"@fr,
        "Style néo-Renaissance"@fr,
