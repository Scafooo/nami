    geo:hasGeometry _:N179d171f946643199db7ecac9955ce71 ;
    namiont:detailedInformation "Buntes Interieur"@de,
        "In der Zürcher Altstadt"@de,
        "Vielfältige Musik"@de,
        "Colorful interior"@en,
        "Diverse selection of music"@en,
