                "Chiesa di Enge"@it ;
            schema:contentUrl <https://www.zuerich.com/sites/default/files/web_zuerich_kirche_enge_1280x960_29745.jpg> ] ;
    schema:license "CC BY-SA" ;
    schema:url <https://musik-kirche-enge.ch/> .

