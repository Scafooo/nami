    schema:priceRange "<div class=\"table-container\"><table class=\"is-fullwidth table\"><thead><tr><th>Eintritt</th><th>&nbsp;</th></tr></thead><tbody><tr><th>Regulär</th><td>CHF 10</td></tr><tr><th>Kinder (bis 16 Jahre)</th><td>Gratis</td></tr><tr><th>Mitglieder, Sozius, Gönner</th><td>Gratis</td></tr><tr><th>Legi (Schüler, Lehrlinge, Studierende bis 24 Jahre), Kulturlegi</th><td>CHF 5</td></tr><tr><th>mit AHV und IV Ausweis, VMS und ICOM Mitglieder</th><td>CHF 8</td></tr><tr><th>Gruppen (ab 6 Personen)</th><td>CHF 8 pro Person</td></tr><tr><th>Zürich Card-Besitzer:innen</th><td>Gratis</td></tr></tbody></table></div>"@de,
        "<div class=\"table-container\"><table class=\"is-fullwidth table\"><thead><tr><th>Entrance</th><th>&nbsp;</th></tr></thead><tbody><tr><th>Regular</th><td>CHF 10</td></tr><tr><th>Children (up to 16 years)</th><td>Free</td></tr><tr><th>Members, sponsors</th><td>Free</td></tr><tr><th>Student, trainees (up to 24 years), \"Kulturlegi\"</th><td>CHF 5</td></tr><tr><th>Other concessions (AHV, IV, members of VMS &amp; ICOM)</th><td>CHF 8</td></tr><tr><th>Groups (from 6 people)</th><td>CHF 8 per person</td></tr><tr><th>Zürich Card holders</th><td>Free</td></tr></tbody></table></div>"@en,
        "<div class=\"table-container\"><table class=\"is-fullwidth table\"><thead><tr><th>Entrée</th><th>&nbsp;</th></tr></thead><tbody><tr><th>Normal</th><td>CHF 10</td></tr><tr><th>Enfants (jusqu'à 16 ans)</th><td>Gratuit</td></tr><tr><th>Membres</th><td>Gratuit</td></tr><tr><th>Étudiants, apprentis (jusqu'à 24 ans), Carte Culture</th><td>CHF 5</td></tr><tr><th>Autres réduits (AHV, IV, membres VMS &amp; ICOM)</th><td>CHF 8</td></tr><tr><th>Groupes (à partir de 6 personnes)</th><td>CHF 8 p.p.</td></tr><tr><th>Visiteurs en possession d’une Zürich Card</th><td>Gratuit</td></tr></tbody></table></div>"@fr,
