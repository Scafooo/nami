    dct:subject <https://example.org/nami/data/category/72>,
        <https://example.org/nami/data/category/88> ;
    geo:hasGeometry _:N48f1511e443145aa8751f6f11e31907c ;
    namiont:detailedInformation "Blick hinter die Flughafen-Kulissen"@de,
        "Spannende Info-Stationen für Kinder"@de,
        "Start und Landung hautnah erleben"@de,
        "Exciting information stations for children"@en,
        "Glance behind the scenes at the airport"@en,
        "Watch take-offs and landings at close quarters"@en,
        "Jeter un œil dans les coulisses de l’aéroport"@fr,
        "Stations d’informations captivantes pour enfants"@fr,
        "Suivre un décollage et un atterrissage de très près"@fr,
        "Avvincenti postazioni informative per bambini"@it,
