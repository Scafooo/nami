    schema:priceRange "<p>&nbsp;Genaue Angaben zu Einzeleintritten, Behandlungen und Abonnementen gibt es <a href=\"https://www.sihlpark-fitness.ch/preislisten?tag=wellness\" target=\"_blank\">hier</a>.&nbsp;</p>"@de,
