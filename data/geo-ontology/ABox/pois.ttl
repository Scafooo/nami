    schema:license "CC BY-SA" ;
    schema:openingHours "Mo,Tu,We,Th,Fr,Sa 17:00:00-00:30:00" ;
    schema:telephone "+41 43 233 53 35" ;
    schema:url <https://www.oldcrow.ch> .

