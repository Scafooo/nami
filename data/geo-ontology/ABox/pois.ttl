    geo:hasGeometry _:N51d7d70e5e9641908ebc766892968863 ;
    namiont:detailedInformation "Besucherzentrum mit Sihlwald-Ausstellung"@de,
        "Naturerlebnispark "@de,
        "Spielplatz und Souvenirshop"@de,
