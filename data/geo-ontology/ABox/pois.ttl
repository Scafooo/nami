    namiont:specialOpeningHoursNote "Saisonbedingt geschlossen von Mittwoch, 24. Dezember 2025 bis Donnerstag, 19. November 2026."@de,
        "Seasonally closed from Wednesday, 24 December 2025 until Thursday, 19 November 2026."@en,
        "Fermeture saisonnière du Mercredi 24 décembre 2025 au Jeudi 19 novembre 2026."@fr,
        "Chiuso stagionalmente da Mercoledì 24 Dicembre 2025 a Giovedì 19 Novembre 2026."@it ;
    namiont:textTeaser "Seit 2026 als «Bellevue Noël» bekannt: Der Weihnachtsmarkt vor dem Opernhaus mit einem 50m breiten und begehbaren Adventskranz, lokalen Marktständen und einem gemütlichen Fonduechalet."@de,
        "Known as “Bellevue Noël” since 2026, this Christmas market in front of the Opera House offers a walkable wreath, market stalls, and a fondue chalet."@en,
        "Connu depuis 2026 sous le nom de « Bellevue Noël » : le marché de Noël devant l’opéra, avec une couronne de l’Avent à parcourir, divers stands et un chalet à fondue."@fr,
        "Dal 2026, si chiama “Bellevue Noël”: il mercatino di Natale con corona dell’Avvento accessibile, bancarelle e chalet della fonduta."@it ;
    namiont:titleTeaser "Zürich Sechseläutenplatz"@de,
        "Sechseläutenplatz, Zurich"@en,
        "Zurich Sechseläutenplatz"@fr,
        "Sechseläutenplatz di Zurigo"@it ;
    namiont:zurichCard false ;
    schema:address [ a schema:PostalAddress ;
            schema:addressCountry "CH" ;
            schema:addressLocality "Zürich" ;
            schema:postalCode "8001" ;
            schema:streetAddress "Sechseläutenplatz" ] ;
    schema:copyrightHolder "Zürich Tourismus www.zuerich.com"@de,
