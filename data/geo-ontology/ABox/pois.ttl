    geo:hasGeometry _:N85a5c9175bdc41b38db8c45672332857 ;
    namiont:osmId "1356639645" ;
    namiont:specialOpeningHoursNote "<p>Montag bis Freitag bis 20.00 Uhr<br> Samstag und Sonntag bis 18.00 Uhr<br> (Bitte individuelle &Ouml;ffnungszeiten beachten)</p>"@de,
        "<p>Monday to Friday until 8.00pm<br> Saturday and Sunday until 6.00pm<br> (Please note individual opening hours)</p>"@en,
        "<p>Du lundi au vendredi jusqu&rsquo;&agrave;&nbsp;20h<br> Samedi et dimanche jusqu&rsquo;&agrave; 18h<br> (Tenez compte des horaires d&rsquo;ouverture particuliers)</p>"@fr,
        "<p>Da luned&igrave; a venerd&igrave; fino alle 20.00<br> Sabato e domenica fino alle 18.00<br> (Si prega di notare gli orari di apertura dei singoli negozi)</p>"@it ;
    namiont:textTeaser "Rapperswil ist das kleine aber feine Einkaufsparadies für alle, die es etwas gemütlicher mögen"@de,
        "Rapperswil is a small but attractive shopping paradise for all those who like to browse in leisure"@en,
        "Découvrez Rapperswil : paradis commercial petit, mais raffiné"@fr,
        "Rapperswil è un piccolo, meraviglioso paradiso per lo shopping, ideale per chi ama le cose intime."@it ;
    namiont:titleTeaser "Shopping in Rapperswil"@de,
        "Shopping in Rapperswil"@en,
        "Shopping à Rapperswil"@fr,
        "Shopping a Rapperswil"@it ;
    namiont:zurichCard false ;
    schema:address [ a schema:PostalAddress ;
            schema:addressCountry "CH" ;
            schema:addressLocality "Rapperswil SG" ;
            schema:postalCode "8640" ;
            schema:streetAddress "Postfach 1507" ] ;
    schema:copyrightHolder "Zürich Tourismus www.zuerich.com"@de,
        "Zurich Tourism www.zuerich.com"@en,
        "Zürich Tourisme www.zuerich.com"@fr,
        "Zürich Tourismo www.zuerich.com"@it ;
    schema:dateModified "2026-08-14T13:48:00"^^xsd:dateTime ;
    schema:dayOfWeek schema:Friday,
        schema:Monday,
        schema:Saturday,
        schema:Sunday,
        schema:Thursday,
        schema:Tuesday,
        schema:Wednesday ;
    schema:description "<p>Bummeln und Einkaufen machen in den zahlreichen Gesch&auml;ften in Rapperswil-Jona Spass. In den kleinen Shops in der Altstadt, in Design- und traditionsreichen Fachgesch&auml;ften oder in den diversen Einkaufszentren wie Sonnenhof, AlbuVille oder Manor werden Spezialit&auml;ten, Kunsthandwerk und Dinge des t&auml;glichen Gebrauchs angeboten. Verschiedene Spezialgesch&auml;fte in der Altstadt sind auch am Sonntag ge&ouml;ffnet.</p>"@de,
        "<p>The numerous stores in Rapperswil-Jona make shopping and browsing pure pleasure. On sale in the tiny shops in the Old Town, in the designer and tradition-steeped specialist stores and in the shopping malls, such as the Sonnenhof, AlbuVille or Manor, are specialties, handicrafts and everyday utensils. Various specialist shops in the Old Town are also open on Sundays.</p>"@en,
        "<p>A Rapperswil-Jona, le shopping est un vrai plaisir&nbsp;! Les petites boutiques de la vieille ville, les magasins sp&eacute;cialis&eacute;s qui fusionnent tradition et design ou encore les nombreux centres commerciaux comme le Sonnenhof, l&rsquo;AlbuVille ou la Manor offrent des sp&eacute;cialit&eacute;s, de l&rsquo;artisanat d&rsquo;art et des objets d&rsquo;usage quotidien. De nombreux commerces sp&eacute;cialis&eacute;s ouvrent leurs portes m&ecirc;me le dimanche.&nbsp;</p>"@fr,
        "<p>Passeggiare e fare acquisti nei numerosi negozi di Rapperswil-Jona &egrave; divertente. Nei negozietti del centro storico, nei negozi di design e in quelli pregni di tradizione, cos&igrave; come nei diversi centri commerciali quali Sonnenhof, AlbuVille o Manor, trovi specialit&agrave;, artigianato artistico e oggetti di uso quotidiano. Diversi negozi del centro storico sono aperti anche domenica.</p>"@it ;
    schema:disambiguatingDescription "Rapperswil ist das kleine aber feine Einkaufsparadies für alle, die es etwas gemütlicher mögen."@de,
        "Rapperswil is a small but attractive shopping paradise for all those who like to browse in leisure."@en,
        "Rapperswil est un paradis commercial petit, mais raffiné, pour tous ceux qui aiment flâner en toute tranquillité."@fr,
        "Rapperswil è un piccolo, meraviglioso paradiso per lo shopping, ideale per chi ama le cose intime."@it ;
    schema:email "info@einkaufsziel.ch" ;
