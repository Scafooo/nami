    namiont:textTeaser "Auf dem Flumserberg finden aktive Wintersportler eine 3 km lange Rodelpiste."@de,
        "Active winter sports lovers can find a 3km (1.9 mile) long toboggan run on Flumserberg."@en,
        "Les sportifs découvriront en hiver une piste de luge de 3 km au Flumserberg."@fr,
        "Sul Flumserberg si trova una pista per slittini lunga 3 km."@it ;
    namiont:titleTeaser "Rodeln am Flumserberg"@de,
        "Tobogganing on the Flumserberg"@en,
        "Luge au Flumserberg"@fr,
        "Avventure in slittino sul Flumserberg"@it ;
    namiont:zurichCard false ;
    schema:address [ a schema:PostalAddress ;
            schema:addressCountry "CH" ;
