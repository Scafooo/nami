    namiont:osmId "30963285" ;
    namiont:placeType namiont:Indoors ;
    namiont:specialOpeningHoursNote "<p>&Ouml;ffnungszeiten gem&auml;ss <a href=\"https://www.musical.ch/de/theater11zuerich\">Programm</a></p>"@de,
        "<p>Opening times according to <a href=\"https://www.musical.ch/en/theater11zuerich\">program</a></p>"@en,
        "<p>Horaire d'ouverture selon <a href=\"https://www.musical.ch/en/theater11zuerich\">le programme</a></p>"@fr,
        "<p>Orari di apertura come da <a href=\"https://www.musical.ch/en/theater11zuerich\">programma</a></p>"@it ;
    namiont:textTeaser "Direkt neben der Messe Zürich befindet sich das Theater 11. Hier sieht man spektakuläre Shows."@de,
        "Theater 11 is located right alongside the Messe Zurich (exhibition center). You can see some spectacular shows here."@en,
        "Voisin du palais des expositions de Zurich, le Theater 11 propose des spectacles exceptionnels."@fr,
        "Il Theater 11 si trova accanto alla fiera di Zurigo. Qui si vedono show spettacolari."@it ;
    namiont:titleTeaser "Theater 11"@de,
