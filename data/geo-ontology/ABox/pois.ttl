    schema:priceRange "<table><tbody><tr><td>&nbsp;</td><td><strong>4 Stunden</strong></td><td><strong>Tageskarten</strong></td></tr><tr><td><strong>Erwachsene (ab 16 Jahren)</strong></td><td>CHF 46.00</td><td>CHF 49.00</td></tr><tr><td><strong>Kinder (6-15)</strong></td><td>CHF 37.00</td><td>CHF 40.00</td></tr><tr><td><strong>Kinder (3-5)</strong></td><td>CHF 16.00</td><td>CHF 16.00</td></tr><tr><td><strong>Kleinkinder (0-2)</strong></td><td>gratis</td><td>gratis</td></tr><tr><td><strong>Zürich Card-Besitzer:innen</strong></td><td>20% Ermässigung</td><td>20% Ermässigung</td></tr></tbody></table><p>Details unter <a href=\"https://www.alpamare.ch/\">www.alpamare.ch</a></p><p>&nbsp;</p>"@de,
        "<table><tbody><tr><td>&nbsp;</td><td><strong>4-hour-stay</strong></td><td><strong>Day ticket</strong></td></tr><tr><td><strong>Adults (from 16 years old)</strong></td><td>CHF 46.00</td><td>CHF 49.00</td></tr><tr><td><strong>Children (6-15)</strong></td><td>CHF 37.00</td><td>CHF 40.00</td></tr><tr><td><strong>Children (3-5)</strong></td><td>CHF 16.00</td><td>CHF 16.00</td></tr><tr><td><strong>Infants (0-2)</strong></td><td>free</td><td>free</td></tr><tr><td><strong>Zürich Card holders</strong></td><td>20% discount</td><td>20% discount</td></tr></tbody></table><p>For details, refer to <a href=\"https://www.alpamare.ch/\">www.alpamare.ch</a></p>"@en,
        "<table><tbody><tr><td>&nbsp;</td><td><strong>Billet pour&nbsp;4 heures</strong></td><td><strong>Billet pour toute la journée</strong></td></tr><tr><td><strong>Adulte (à partir de&nbsp;16 ans)</strong></td><td>CHF 46.00</td><td>CHF 49.00</td></tr><tr><td><strong>Enfant (6-15)</strong></td><td>CHF 37.00</td><td>CHF 40.00</td></tr><tr><td><strong>Enfant (3-5)</strong></td><td>CHF 16.00</td><td>CHF 16.00</td></tr><tr><td><strong>​Petit Enfant (0-2)</strong></td><td>gratuit</td><td>gratuit</td></tr><tr><td><strong>Visiteurs en possession d’une Zürich Card</strong></td><td>20% de réduction</td><td>20% de réduction</td></tr></tbody></table><p>Voir les détails sur <a href=\"http://www.alpamare.ch\">www.alpamare.ch</a></p>"@fr,
        "<table><tbody><tr><td>&nbsp;</td><td><strong>4 ore</strong></td><td><strong>Ingresso giornaliero</strong></td></tr><tr><td><strong>Adulti (a partire dai 16 anni)</strong></td><td>CHF 46.00</td><td>CHF 49.00</td></tr><tr><td><strong>Bambini (6-15)</strong></td><td>CHF 37.00</td><td>CHF 40.00</td></tr><tr><td><strong>Bambini (3-5)</strong></td><td>CHF 16.00</td><td>CHF 16.00</td></tr><tr><td><strong>Infanti (0-2)</strong></td><td>gratuito</td><td>gratuito</td></tr><tr><td><strong>Visitatori in possesso di una Zürich Card</strong></td><td>20% di sconto</td><td>20% di sconto</td></tr></tbody></table><p>Dettagli disponibili su <a href=\"http://www.alpamare.ch\">www.alpamare.ch</a></p>"@it ;
    schema:telephone "+41 55 415 15 15" ;
