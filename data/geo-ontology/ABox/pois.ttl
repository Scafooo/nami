    namiont:specialOpeningHoursNote "<p><strong>&Ouml;ffnungszeiten Feiertage:</strong>&nbsp;<br>08.00 &ndash; 17.30 Uhr</p>"@de,
        "<p><strong>Opening times public holidays:&nbsp;</strong><p>8.00am &ndash; 5.30pm</p></p>"@en,
