    namiont:specialOpeningHoursNote "<p>Lido Unter&auml;geri<p><strong>Mitte Mai bis Mitte September</strong><br> 09.00 Uhr - 18.00 Uhr (Vorsaison)<br> 09.00 Uhr - 20.00 Uhr (Hauptsaison)</p></p>"@de,
        "<p>Lido Unter&auml;geri<p>Mid-May to mid-September<br>9am &ndash; 6pm (low season)<br>9am &ndash; 8pm (high season)</p></p>"@en,
        "<p>Lido Unter&auml;geri<p>De mi-mai &agrave; mi-septembre<br>9h &ndash; 18h (basse saison)<br>9h &ndash; 20h (haute saison)</p></p>"@fr,
        "<p>Lido Unter&auml;geri<p>Da met&agrave; maggio a met&agrave; settembre<br>09.00 - 18.00 (bassa stagione)<br>09.00 - 20.00 (alta stagione)</p></p>"@it ;
    namiont:textTeaser "Freuen Sie sich auf abwechslungsreiche Erlebnisse mit einem Hauch Schweizer Geschichte."@de,
