    dct:subject <https://example.org/nami/data/category/76> ;
    geo:hasGeometry _:Na97d0d0f79d044b6bf7ec81c2e0d7d8d ;
    namiont:textTeaser "Designhotel im ruhigeren Teil des lebendigen Kreis 4 mit stylischer Bar und gemütlichen Zimmern."@de,
        "A designer hotel in the quieter part of the vibrant Kreis 4, with a stylish bar and cozy rooms."@en,
        "Hôtel design dans la zone calme de l’arrondissement 4 animé, avec chambres confortables et bar branché."@fr,
        "Hotel di design nella parte più tranquilla del vivace Kreis 4, con bar alla moda e camere accoglienti."@it ;
    namiont:titleTeaser "Greulich Design & Boutique Hotel"@de,
