    namiont:textTeaser "Traditionsreiches Lokal mit exzellenter, saisonaler Frischeküche mitten in der Rapperswiler Altstadt."@de,
        "Tradition-steeped restaurant with excellent, seasonal, and fresh cuisine in Rapperswil’s Old Town."@en,
        "Restaurant traditionnel avec cuisine de marché de saison au centre de la vieille ville de Rapperswil."@fr,
        "Storico locale con eccellenti piatti freschi e stagionali nel centro storico di Rapperswil."@it ;
    namiont:titleTeaser "Restaurant Falkenburg"@de,
        "Restaurant Falkenburg"@en,
        "Restaurant Falkenburg"@fr,
        "Ristorante Falkenburg"@it ;
    namiont:zurichCard false ;
    schema:address [ a schema:PostalAddress ;
            schema:addressCountry "CH" ;
