    dct:subject <https://example.org/nami/data/category/153>,
        <https://example.org/nami/data/category/158>,
        <https://example.org/nami/data/category/97>,
        <https://example.org/nami/data/category/99> ;
    geo:hasGeometry _:N73c7b31fea514390b58ed405ceffb597 ;
    namiont:detailedInformation "3.8 km Länge"@de,
        "400 Höhenmeter"@de,
        "Einfach"@de,
        "Rodelmiete möglich"@de,
        "Startort nur zu Fuss erreichbar"@de,
        "Verpflegung in der Nähe"@de,
        "3.8km (2.4 miles) long"@en,
        "400 vertical meters (1,300ft)"@en,
        "Easy"@en,
        "Food & refreshments nearby"@en,
        "Start is only reachable on foot"@en,
        "Toboggan hire available "@en,
        "Dénivelé 400 m"@fr,
        "Facile"@fr,
        "Lieu de départ uniquement accessible à pied"@fr,
        "Longueur 3,8 km "@fr,
        "Possibilité de location de luge"@fr,
        "Restauration à proximité"@fr,
        "3,8 km di lunghezza"@it,
        "400 di dislivello"@it,
        "Facile"@it,
        "Possibilità di noleggiare gli slittini"@it,
        "Punto di partenza raggiungibile so-lo a piedi"@it,
        "Ristorazione nelle vicinanze"@it ;
    namiont:placeType namiont:Outdoors ;
    namiont:textTeaser "Nach einem einstündigen Aufstieg durch bezaubernde Winterlandschaften folgt eine lange Rodelpiste."@de,
        "A one-hour ascent through a magical winter wonderland is rewarded with a long toboggan ride."@en,
        "Après une montée d’1 h traversant de magnifiques paysages d’hiver apparaît une longue piste de luge."@fr,
        "Dopo una salita di un’ora, il divertimento continua su una lunga pista per slittini."@it ;
    namiont:titleTeaser "Rodeln bei Ricken"@de,
        "Tobogganing near Ricken"@en,
        "Alp Egg tobogganing"@fr,
        "Slittino presso Ricken"@it ;
    namiont:zurichCard false ;
    schema:address [ a schema:PostalAddress ;
            schema:addressCountry "CH" ;
            schema:addressLocality "Uetliburg SG" ;
            schema:postalCode "8738" ;
            schema:streetAddress "Alp Egg 5" ] ;
    schema:copyrightHolder "Zürich Tourismus www.zuerich.com"@de,
        "Zurich Tourism www.zuerich.com"@en,
        "Zürich Tourisme www.zuerich.com"@fr,
        "Zürich Tourismo www.zuerich.com"@it ;
    schema:dateModified "2026-02-11T11:40:00"^^xsd:dateTime ;
    schema:description "<h3>Strecke<p>Ein 3.8 Kilometer langer Schlittelweg f&uuml;hrt von der Alp Egg hinunter nach Ricken. Der Aufstieg auf dem oft etwas eisigen Alpenstr&auml;sschen beginnt bei der Haltestelle Rittmarren und dauert eine gute Stunde. Oben angekommen kann man sich im Bergrestaurant Alp Egg mit einer herzhaften &Auml;lpler-Brotzeit st&auml;rken, bevor es mit dem Schlitten rasant wieder abw&auml;rtsgeht.</p><h3><strong>Schlittenmiete</strong></h3><p>Beim Bergrestaurant Alp Egg k&ouml;nnen Schlitten f&uuml;r CHF 5 gemietet werden (solange Vorrat).</p><h3>Verpflegung in der N&auml;he</h3><p>Im Bergrestaurant Alp Egg gibt es leckere Snacks oder warme Speisen .</p><h3>Besonderes</h3><p>Der Startort ist nur zu Fuss zu erreichen. Besonders die n&auml;chtliche Tour auf die Alp Egg kombiniert mit einem gem&uuml;tlichen Fondueplausch ist ein Klassiker.</p></h3>"@de,
        "<h3>Route<p>A toboggan run stretches 3.8 kilometers (2.4 miles) from Alp Egg all the way down to Ricken. The ascent on the narrow, often rather icy mountain road begins at the Rittmarren bus stop and takes a good hour. Once at the top, visitors can fortify themselves at the Bergrestaurant Alp Egg with some hearty Alpine snacks before racing back down the slope on a toboggan.</p><h3><strong>Toboggan Hire</strong></h3><p>Toboggans can be hired at the Bergrestaurant Alp Egg for CHF 5 (while stocks last).</p><h3>Catering Facilities Nearby</h3><p>The Bergrestaurant Alp Egg serves delicious snacks and light meals.</p><h3>Special Remarks</h3><p>The start can only be reached on foot. The night tour on Alp Egg and a leisurely fondue meal is a classic combination and a memorable highlight.</p></h3>"@en,
        "<h3>Route<p>Une piste de luge de 3,8 kilom&egrave;tres de long quitte Alp Egg pour rejoindre le col de Ricken. La mont&eacute;e par les petites routes de montagne parfois un peu verglac&eacute;es d&eacute;marre &agrave; l'arr&ecirc;t Rittmarren et dure une bonne heure. Arriv&eacute; en haut, vous pouvez prendre un casse-cro&ucirc;te traditionnel au restaurant de montagne Alp Egg et ensuite vous lancer dans une descente vertigineuse en luge.</p><h3><strong>Location de luges</strong></h3><p>Il est possible de louer des luges pour CHF 5,- &agrave; restaurant de montagne Alp Egg (dans la limite des stocks disponibles).</p><h3>Restauration &agrave; proximit&eacute;</h3><p>Le restaurant de montagne Alp Egg propose de d&eacute;licieux go&ucirc;ters.</p><h3>Remarques sp&eacute;ciales</h3><p>Le d&eacute;part ne peut &ecirc;tre atteint qu'&agrave; pied. Le tour de nuit sur l'Alp Egg et une fondue en toute d&eacute;contraction sont une combinaison classique et un moment fort m&eacute;morable.</p></h3>"@fr,
        "<h3>Tracciato<p>Una pista per slittini lunga 3,8 chilometri porta dalla Alp Egg a Ricken. La salita lungo strade alpine a volte ghiacciate ha inizio dalla fermata di Rittmarren e dura un&rsquo;ora abbondante. Una volta in cima, ci si pu&ograve; rifocillare al ristorante Alp Egg, prima di ridiscendere a tutta velocit&agrave; con lo slittino.</p><h3><strong>Noleggio slittini</strong></h3><p>Al ristorante Alp Egg &egrave; possibile noleggiare slittini per CHF 5 (fino a esaurimento scorte).</p><h3>Ristorazione nelle vicinanze</h3><p>Al ristorante Alp Egg si serve una deliziosa merenda.</p><h3>Particolarit&agrave;</h3><p>Il punto di partenza pu&ograve; essere raggiunto solo a piedi. Il tour notturno sull&rsquo;Alp Egg combinato con una deliziosa fonduta &egrave; particolarmente amato.</p></h3>"@it ;
    schema:disambiguatingDescription "Von der Alp Egg auf 1‘200 m Höhe kann man im Winter auf einer Schlittenbahn bis nach Ricken rodeln."@de,
        "From Alp Egg at an altitude of 1,200 meters (3,937ft), wintertime visitors can toboggan all the way down to Ricken."@en,
        "Alp Egg, situé à 1 200 m d'altitude, constitue le départ d'une la piste de luge qui rejoint le Ricken."@fr,
        "Dalla Alp Egg, a 1.200 m di altitudine, in inverno è possibile raggiungere Ricken su una pista per slittini."@it ;
    schema:email "info@alp-egg.ch" ;
    schema:geo _:N73c7b31fea514390b58ed405ceffb597 ;
    schema:identifier "4542" ;
    schema:image [ a schema:ImageObject ;
            schema:caption "Alp Egg"@de ;
            schema:contentUrl <https://www.zuerich.com/sites/default/files/image/2022/web_rzst_Alp%20Egg_Schlitten.jpg> ] ;
    schema:license "CC BY-SA" ;
    schema:photo [ a schema:ImageObject ;
            schema:caption "Alp Egg"@de ;
            schema:contentUrl <https://www.zuerich.com/sites/default/files/image/2022/web_rzst_Alp%20Egg_Winter.jpg> ] ;
    schema:telephone "+41 55 280 22 09" ;
    schema:url <https://alp-egg.ch/aktivitaeten/> .

