    namiont:placeType namiont:Outdoors ;
    namiont:specialOpeningHoursNote "<p>Die saisonalen &Ouml;ffnungszeiten der Bahnen und Freizeiteinrichtungen k&ouml;nnen der <a href=\"https://www.sattel-hochstuckli.ch/de/live/\">Website</a> entnommen werden.<br>&nbsp;</p>"@de,
        "<p>The seasonal opening hours of the railways and leisure facilities can be found on the <a href=\"https://www.sattel-hochstuckli.ch/en/live/live.html\">website</a>.<br>&nbsp;</p>"@en,
        "<p>Les horaires d'ouverture saisonniers des remont&eacute;es m&eacute;caniques et des installations de loisirs sont disponibles sur le <a href=\"https://www.sattel-hochstuckli.ch/en/live/live.html\">site web</a>.<br>&nbsp;</p>"@fr,
        "<p>Gli orari stagionali di apertura delle funivie e delle strutture ricreative sono disponibili sul <a href=\"https://www.sattel-hochstuckli.ch/en/live/live.html\">sito web</a>.<br>&nbsp;</p>"@it ;
    namiont:textTeaser "Im Sommer begeistert das Gebiet mit Aussichten, Wanderungen und einer spektakulären Hängebrücke."@de,
        "In summer, the region treats visitors to views, hikes and a spectacular suspension bridge."@en,
        "En été, le domaine enchante les randonneurs par ses vues et son impressionnante passerelle suspendue."@fr,
        "In estate, questa regione entusiasma con panorami, escursioni e uno spettacolare ponte sospeso."@it ;
    namiont:titleTeaser "Sattel-Hochstuckli im Sommer"@de,
        "Sattel-Hochstuckli in Summer"@en,
        "Sattel-Hochstuckli en été"@fr,
        "Sattel-Hochstuckli in estate"@it ;
    namiont:zurichCard false ;
    schema:address [ a schema:PostalAddress ;
            schema:addressCountry "CH" ;
            schema:addressLocality "Sattel" ;
            schema:postalCode "6417" ;
            schema:streetAddress "Kreisel 2" ] ;
    schema:copyrightHolder "Zürich Tourismus www.zuerich.com"@de,
        "Zurich Tourism www.zuerich.com"@en,
