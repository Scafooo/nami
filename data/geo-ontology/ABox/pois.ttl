    geo:hasGeometry _:Nd36190e1af1b41b29a5d4ee0be96f859 ;
    namiont:detailedInformation "Bushaltestelle Ricken Post"@de,
        "Flachstrecke"@de,
        "Insgesamt 23 km"@de,
