    namiont:textTeaser "Im idyllischen Bubikon im Zürcher Oberland befindet sich der Gasthof Löwen."@de,
        "The ideal place for a gourmet excursion into the Zurich Oberland."@en,
        "L’endroit idéal pour une excursion culinaire dans l’Oberland zurichois."@fr,
        "Il luogo ideale per una gita gourmet nell’Oberland Zurighese."@it ;
    namiont:titleTeaser "Gasthof Löwen"@de,
        "Gasthof Löwen"@en,
        "Hôtel Gasthof Löwen"@fr,
        "Gasthof Löwen"@it ;
    schema:address [ a schema:PostalAddress ;
            schema:addressCountry "CH" ;
            schema:addressLocality "Bubikon" ;
