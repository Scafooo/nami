            schema:contentUrl <https://www.zuerich.com/sites/default/files/web_zurich_restaurants_01.jpg> ] ;
    schema:license "CC BY-SA" ;
    schema:telephone "+41 44 451 14 14" ;
    schema:url <https://www.santozurigo.ch/> .

