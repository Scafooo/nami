    namiont:placeType namiont:Outdoors ;
    namiont:specialOpeningHoursNote "<p>Die saisonalen &Ouml;ffnungszeiten der Bahnen und Freizeiteinrichtungen k&ouml;nnen der <a href=\"https://www.amden-weesen.ch/winterbericht-amden#/article\">Website</a> entnommen werden.</p>"@de,
        "<p>The seasonal opening hours of the railways and leisure facilities can be found on the <a href=\"https://www.amden-weesen.ch/en/snow-report#/article\">website</a>.</p>"@en,
        "<p>Les horaires d'ouverture saisonniers des remont&eacute;es m&eacute;caniques et des installations de loisirs sont disponibles sur le <a href=\"https://www.amden-weesen.ch/en/snow-report#/article\">site web</a>.<br>&nbsp;</p>"@fr,
        "<p>Gli orari stagionali di apertura delle funivie e delle strutture ricreative sono disponibili sul <a href=\"https://www.amden-weesen.ch/en/snow-report#/article\">sito web</a>.</p>"@it ;
    namiont:textTeaser "Nur etwa 70 km von Zürich entfernt liegen die Skigebiete Mattstock und Arvenbüel in der Region Amden."@de,
        "The resorts Mattstock and Arvenbuel in the region Amden are only around 70 km (43.5 miles) from Zurich."@en,
        "Découvrir les domaines skiables de Mattstock et Arvenbüel dans la région d'Amden, à 70 km de Zurich."@fr,
        "A soli 70 km da Zurigo, nella regione di Amden, si trovano i comprensori sciistici di Mattstock e Arvenbüel."@it ;
    namiont:titleTeaser "Ski & Snowboard Amden"@de,
        "Ski & Snowboard Amden"@en,
        "Ski et snowboard à Amden"@fr,
        "Sci e snowboard ad Amden"@it ;
    namiont:zurichCard false ;
    schema:address [ a schema:PostalAddress ;
            schema:addressCountry "CH" ;
            schema:addressLocality "Amden" ;
            schema:postalCode "8873" ;
            schema:streetAddress "Ruestelstrasse 20 " ] ;
    schema:copyrightHolder "Zürich Tourismus www.zuerich.com"@de,
        "Zurich Tourism www.zuerich.com"@en,
        "Zürich Tourisme www.zuerich.com"@fr,
        "Zürich Tourismo www.zuerich.com"@it ;
    schema:dateModified "2026-02-11T11:40:00"^^xsd:dateTime ;
    schema:dayOfWeek schema:Friday,
        schema:Monday,
        schema:Saturday,
        schema:Sunday,
        schema:Thursday,
        schema:Tuesday,
        schema:Wednesday ;
    schema:description "<p>Das attraktive Schneesportgebiet Amden mit insgesamt sechs Bahnen und 20 Kilometer Abfahrtspisten garantiert Abwechslung f&uuml;r Skifahrer:innen und Snowboarder:innen von Klein bis Gross. Das Ski-Karussell Arvenb&uuml;el ist ein ideales Gel&auml;nde f&uuml;r Anf&auml;nger:innen und Geniesser:innen, w&auml;hrend die Mattstockseite und der B&auml;renfall ge&uuml;bte Ski- und Snowboardfahrer:innen begeistert. Die Skigebiete Mattstock und Arvenb&uuml;el sind zwar nicht miteinander verbunden, aber st&uuml;ndlich mit dem Bus erschlossen. Wer eine Tages- oder Saisonkarte besitzt, f&auml;hrt gratis mit.<h3><strong>Skigebiet Mattstock</strong></h3><table><tbody><tr><td><strong>Anreisezeit vom Hauptbahnhof Z&uuml;rich</strong></td><td>69 Minuten mit dem Zug<br>50 Minuten mit dem Auto</td></tr><tr><td><strong>Gr&ouml;sse</strong></td><td>20 Pisten-Km<br>(inkl. Skigebiet Arvenb&uuml;el)</td></tr><tr><td><strong>Anlagen</strong></td><td>2 Lifte (+4 Lifte im Skigebiet Arvenb&uuml;el)<br>12 Pisten (inkl. Skigebiet Arvenb&uuml;el)</td></tr><tr><td><strong>Besonderheiten</strong></td><td>St&uuml;ndlich f&auml;hrt ein Bus zum Skigebiet Arvenb&uuml;el<br>Viele Restaurants und &laquo;Beizli&raquo; entlang der Pisten</td></tr></tbody></table><p>&nbsp;</p><h3><strong>Skigebiet Arvenb&uuml;el</strong></h3><table><tbody><tr><td><strong>Anreisezeit vom Hauptbahnhof Z&uuml;rich</strong></td><td>115&nbsp;Minuten mit dem Zug<br>54&nbsp;Minuten mit dem Auto</td></tr><tr><td><strong>Gr&ouml;sse</strong></td><td>20 Pisten-Km<br>(inkl. Skigebiet Mattstock)</td></tr><tr><td><strong>Anlagen</strong></td><td>4 Lifte (+2 Lifte im Skigebiet Mattstock)<br>12 Pisten (inkl. Skigebiet Mattstock)<br>1 Snow Park<br>1 Rodel-Piste<br>2 Langlauf-Pisten</td></tr><tr><td><strong>Besonderheiten</strong></td><td>St&uuml;ndlich f&auml;hrt ein Bus zum Skigebiet Mattstock</td></tr></tbody></table></p>"@de,
        "<p>The attractive snow sports region of Amden, with its six ski lifts (drag &amp; chair lifts) and around 20 kilometers (13 miles) of downhill slopes, guarantees variety for skiers and snowboarders of all ages. The Arvenb&uuml;el ski area offers ideal terrain for beginners and those who prefer to go about things at a more leisurely pace, while the Mattstock side of the mountain and the B&auml;renfall provide plenty of thrills for more proficient snow sport enthusiasts. Although the two areas of Mattstock and Arvenb&uuml;el are not interconnected, they are linked by a bus service that runs every hour. Holders of a day or season pass travel for free.&nbsp;<h3><strong>Mattstock Ski Area</strong></h3><table><tbody><tr><td><strong>Travel time from Zurich Main Train Station</strong></td><td>69 minutes by public transport<br> 50 minutes by car</td></tr><tr><td><strong>Size</strong></td><td>20km (13 miles) of pistes (including the Arvenb&uuml;el ski area)</td></tr><tr><td><strong>Installations</strong></td><td>2 mountain transport facilities<br> 12 ski pistes (including the Arvenb&uuml;el ski area)</td></tr><tr><td><strong>Special features</strong></td><td>hourly bus service to the Arvenb&uuml;el ski area</td></tr></tbody></table><p>&nbsp;</p><h3><strong>Arvenb&uuml;el Ski Area</strong></h3><table><tbody><tr><td><strong>Travel time from Zurich Main Train Station</strong></td><td>115 minutes by public transport<br> 54&nbsp;minutes by car</td></tr><tr><td><strong>Size</strong></td><td>20km (13 miles) of pistes (including the Mattstock ski area)</td></tr><tr><td><strong>Installations</strong></td><td>4 mountain transport facilities<br> 12 ski pistes (including the Mattstock ski area)<br> 1 snow park<br> 1 toboggan run<br> 2 cross-country ski trails</td></tr><tr><td><strong>Special features</strong></td><td>hourly bus service to the Mattstock ski area</td></tr></tbody></table><p>&nbsp;</p></p>"@en,
        "<p>La station de sports d'hiver d'Amden attire skieurs et snowboardeurs avec ses six remont&eacute;es m&eacute;caniques et ses 20 kilom&egrave;tres de pistes, offrant une exp&eacute;rience d'hiver vari&eacute;e &agrave; petits et grands. Le domaine d'Arvenb&uuml;el est id&eacute;al pour les d&eacute;butants, alors que le Mattstockseite et le B&auml;renfall sont plut&ocirc;t fr&eacute;quent&eacute;s par les skieurs et les snowboardeurs confirm&eacute;s. Les domaines skiables de Mattstock et d'Arvenb&uuml;el ne sont pas interconnect&eacute;s, mais sont reli&eacute;s par un bus qui circule toutes les heures. Le trajet est gratuit pour les d&eacute;tenteurs d&rsquo;un forfait journalier ou saisonnier.<h3><strong>Domaine skiable Mattstock</strong></h3><table><tbody><tr><td><p><strong>Temps de voyage depuis la gare centrale de Zurich</strong></p></td><td><p>1h09 en transports en commun<br> 50 minutes en voiture</p></td></tr><tr><td><strong>Dimension</strong></td><td>20 km de pistes<br> (domaine skiable Arvenb&uuml;el inclus)</td></tr><tr><td><strong>Installations</strong></td><td>2 remont&eacute;es m&eacute;caniques (+ 4 &agrave; la domaine skiable Arvenb&uuml;el)<br> 12 pistes de ski (domaine skiable Arvenb&uuml;el inclus)</td></tr><tr><td><strong>Particularit&eacute;</strong></td><td>Toutes les heures, un bus part pour le domaine skiable Arvenb&uuml;el<br> Beaucoup de restaurants et de bistrots longent des pistes</td></tr></tbody></table><h3><strong>Domaine skiable Arvenb&uuml;el</strong></h3><table><tbody><tr><td><p><strong>Temps de voyage depuis la gare centrale de Zurich</strong></p></td><td>1h55&nbsp;en transports en commun<br> 54&nbsp;minutes en voiture</td></tr><tr><td><strong>Dimension</strong></td><td>20 km de pistes<br> (domaine skiable Mattstock inclus)</td></tr><tr><td><strong>Installations</strong></td><td>4 remont&eacute;es m&eacute;caniques (+ 2 &agrave; la domaine skiable Mattstock)<br> 12 pistes de ski (domaine skiable Mattstock inclus)<br> 1 snowpark<br> 1 piste de luge<br> 2 pistes de ski de fond</td></tr><tr><td><strong>Particularit&eacute;</strong></td><td>Toutes les heures, un bus part pour le domaine skiable Mattstock</td></tr></tbody></table><p>&nbsp;</p></p>"@fr,
        "<p>Con un totale di 6 impianti di risalita e 20 chilometri di discese, l'affascinante comprensorio di Amden garantisce la giusta variet&agrave; a sciatori e snowboarder grandi e piccoli. Il carosello di Arvenb&uuml;el &egrave; ideale per chi &egrave; alle prime armi, mentre le piste del Mattstock e del B&auml;renfall entusiasmano i pi&ugrave; esperti. I comprensori di Mattstock e Arvenb&uuml;el non sono collegati tra di loro, ma possono essere raggiunti ogni ora con il bus. Chi ha uno skipass giornaliero o stagionale viaggia gratis.<h3><strong>Comprensorio sciistico di Mattstock</strong></h3><table><tbody><tr><td><strong>Tempo di tragitto dalla Stazione Centrale di Zurigo</strong></td><td>69 minuti con i trasporti pubblici<br> 50 minuti di macchina</td></tr><tr><td><strong>Dimensione</strong></td><td>20 km di piste<br> (compreso il carosello di Arvenb&uuml;el)</td></tr><tr><td><strong>Impianti</strong></td><td>2 skilift (+ 4 skilift al comprensorio di Arvenb&uuml;el)<br> 12 piste da sci (compreso il carosello di Arvenb&uuml;el)</td></tr><tr><td><strong>Particolarit&agrave;</strong></td><td>Bus con cadenza oraria per il comprensorio di Arvenb&uuml;el<br> Tanti ristoranti lungo le piste</td></tr></tbody></table><p>&nbsp;</p><h3><strong>Comprensorio sciistico Arvenb&uuml;el</strong></h3><table><tbody><tr><td><strong>Tempo di tragitto dalla Stazione Centrale di Zurigo</strong></td><td>115 minuti con i trasporti pubblici<br> 54&nbsp;minuti di macchina</td></tr><tr><td><strong>Dimensione</strong></td><td>20 km di piste<br> (compreso il carosello di Mattstock)</td></tr><tr><td><strong>Impianti</strong></td><td><p>4 skilift (+ 2 skilift al comprensorio di Mattstock)<br> 12 piste da sci (compreso il carosello di Mattstock)<br> 1 snow park<br> 1 pista per slittini<br> 2 piste per lo sci di fondo</p></td></tr><tr><td><strong>Particolarit&agrave;</strong></td><td>Bus con cadenza oraria per il comprensorio di Mattstock</td></tr></tbody></table><p>&nbsp;</p></p>"@it ;
    schema:disambiguatingDescription "Nur etwa 70 km von Zürich entfernt liegen die Skigebiete Mattstock und Arvenbüel in der Region Amden über dem Walensee."@de,
        "The resorts Mattstock and Arvenbuel in the region Amden, overlooking the Walensee lake, are only around 70 km (43.5 miles) from Zurich."@en,
        "Découvrir les domaines skiables de Mattstock et Arvenbüel dans la région d'Amden au-dessus du lac de Walenstadt, à 70 km de Zurich."@fr,
        "A soli 70 km da Zurigo, nella regione di Amden, sopra il Lago di Walen, si trovano i comprensori sciistici di Mattstock e Arvenbüel."@it ;
    schema:email "sportbahnen@amden.swiss" ;
