        <https://example.org/nami/data/category/179>,
        <https://example.org/nami/data/category/96> ;
    geo:hasGeometry _:N5567048cca454da8a548c89e733fc105 ;
    namiont:detailedInformation "Geschichte der Schweizer Fotografie"@de,
