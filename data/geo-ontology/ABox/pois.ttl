        namiont:Outdoors ;
    namiont:textTeaser "Das Kloster Einsiedeln ist eine bedeutende Station auf dem Jakobsweg und Ziel zahlreicher Pilger."@de,
        "Einsiedeln Abbey is an important station on the Way of St. James and the destination for many pilgrims."@en,
        "L’abbaye d’Einsiedeln est un lieu de pèlerinage et une étape importante du chemin de Saint-Jacques."@fr,
        "L'Abbazia di Einsiedeln è una tappa importante del Cammino di Santiago e meta di tanti pellegrini."@it ;
    namiont:titleTeaser "Kloster Einsiedeln"@de,
        "Einsiedeln Abbey"@en,
        "Kloster Einsiedeln (abbaye d’Einsiedeln)"@fr,
        "Abbazia di Einsiedeln"@it ;
    namiont:zurichCard false ;
    schema:address [ a schema:PostalAddress ;
