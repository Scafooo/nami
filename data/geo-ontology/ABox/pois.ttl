    namiont:specialOpeningHoursNote "<p><strong>Ge&ouml;ffnet vom April bis Oktober</strong><p>Jeweils am ersten Sonntag jeden Monats (11.00 Uhr) findet eine F&uuml;hrung statt</p><p>&nbsp;</p></p>"@de,
        "<p><strong>Open from April to October</strong><p>A tour takes place on the first Sunday of each month (11.00am)</p><p>&nbsp;</p></p>"@en,
        "<p><strong>Ouvert d'avril &agrave; octobre </strong><p>Une randonn&eacute;e guid&eacute;e est propos&eacute;e chaque premier dimanche du mois (11h)</p><p>&nbsp;</p></p>"@fr,
        "<p><strong>Aperto da aprile a ottobre</strong><p>La prima domenica del mese (alle 11.00) ha luogo una visita guidata</p><p>&nbsp;</p></p>"@it ;
    namiont:textTeaser "Ob Rosen, Rhododendren, Bäume, Sträucher oder ein Steingarten: Diese Oase lädt zum Entdecken ein."@de,
        "Roses, rhododendrons, trees, shrubs, or a rock garden: this oasis invites visitors to explore."@en,
        "Roses, rhododendrons, arbres, arbustes ou jardin de rocaille : cette oasis invite à la découverte."@fr,
        "Che si tratti di rose, rododendri, alberi, arbusti o giardini rocciosi, quest’oasi invita a esplorare."@it ;
    namiont:titleTeaser "Botanischer Garten Grüningen"@de,
        "Botanical Garden Grüningen"@en,
        "Botanical Garden Grüningen"@fr,
        "Botanical Garden Grüningen"@it ;
