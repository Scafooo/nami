    namiont:osmId "715436712" ;
    namiont:textTeaser "Die Erlebniswelt für alle Schokoladenfans mit dem weltweit grösstem Lindt-Shop und mehr."@de,
        "The experience world for all chocolate fans, featuring the world’s largest Lindt shop and more."@en,
        "Espace découverte pour amateurs de chocolat avec la plus grande boutique Lindt du monde."@fr,
        "L’universo esperienziale per gli amanti del cioccolato, con il Lindt Shop più grande del mondo e molto altro."@it ;
    namiont:titleTeaser "Lindt Home of Chocolate"@de,
        "Lindt Home of Chocolate"@en,
        "Lindt Home of Chocolate"@fr,
        "Lindt Home of Chocolate"@it ;
