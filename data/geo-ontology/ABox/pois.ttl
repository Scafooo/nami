            schema:contentUrl <https://www.zuerich.com/sites/default/files/keyvisual/web_zurich_shopping_einkaufszentrum-glatt_03.jpg> ] ;
    schema:license "CC BY-SA" ;
    schema:openingHours "Mo,Tu,We,Th,Fr,Sa 09:00:00-20:00:00" ;
    schema:telephone "+41 44 839 42 42" ;
    schema:url <https://www.glatt.ch> .

