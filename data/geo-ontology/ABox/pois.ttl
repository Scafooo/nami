    schema:priceRange "<div class=\"table-container\"><table class=\"is-fullwidth table\"><tbody><tr><td>&nbsp;</td></tr></tbody></table></div><div class=\"table-container\"><table class=\"is-fullwidth table\"><thead><tr><th>Eintritt</th><th>&nbsp;</th></tr></thead><tbody><tr><th>Ausstellungen Fotomuseum</th><td>CHF 12 (reduziert CHF 10)</td></tr><tr><th>Ausstellungspass (alle Ausstellungen)</th><td>CHF 19 (reduziert CHF 15)</td></tr><tr><th>Kinder und Jugendliche bis 16 Jahre</th><td>gratis</td></tr><tr><th>Mittwochs 17.00 – 20.00 Uhr</th><td>gratis</td></tr></tbody></table></div>"@de,
        "<div class=\"table-container\"><table class=\"is-fullwidth table\"><thead><tr><th>Entrance</th><th>&nbsp;</th></tr></thead><tbody><tr><th>According to the exhibition</th><td>CHF 12 (reduced price CHF 10)</td></tr><tr><th>Admission to all exhibitions</th><td>CHF 19 (reduced price CHF 15)</td></tr><tr><th>Children 0 – 16 years old</th><td>free entrance</td></tr><tr><th>On Wednesday, 5pm – 8pm</th><td>free entrance</td></tr></tbody></table></div>"@en,
        "<div class=\"table-container\"><table class=\"is-fullwidth table\"><tbody><tr><td>&nbsp;</td></tr></tbody></table></div><div class=\"table-container\"><table class=\"is-fullwidth table\"><thead><tr><th>Entrée</th><th>&nbsp;</th></tr></thead><tbody><tr><th>Selon l'exposition</th><td>CHF 12 (prix réduit CHF 10)</td></tr><tr><th>Toutes les expositions</th><td>CHF 19 (prix réduit CHF 15)</td></tr><tr><th>Enfants 0 – 16 ans</th><td>gratuit</td></tr><tr><th>Le mercredi, 17h – 20h</th><td>gratuit</td></tr></tbody></table></div>"@fr,
