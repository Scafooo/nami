    namiont:placeType namiont:Outdoors ;
    namiont:textTeaser "Unweit von Rapperswil-Jona erhebt sich der Berg Bachtel, der im Winter zum Rodelparadies wird."@de,
        "Near to Rapperswil-Jona, the Bachtel mountain is transformed in winter into a tobogganing paradise."@en,
        "Près de Rapperswil-Jona s’élève le Bachtel qui se transforme l’hiver en vrai paradis pour lugeurs."@fr,
        "Poco lontano da Rapperwswil-Jona si erge il monte Bachtel, un paradiso per slittini in inverno."@it ;
    namiont:titleTeaser "Rodeln am Bachtel"@de,
        "Tobogganing on the Bachtel"@en,
        "Luge au Bachtel"@fr,
        "Slittino sul Bachtel"@it ;
    namiont:zurichCard false ;
    schema:address [ a schema:PostalAddress ;
            schema:addressCountry "CH" ;
            schema:addressLocality "Wernetshausen" ;
            schema:postalCode "8342" ;
            schema:streetAddress "Bachtelstrasse 1115" ] ;
    schema:copyrightHolder "Zürich Tourismus www.zuerich.com"@de,
