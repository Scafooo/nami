    namiont:textTeaser "In Zürich spielt die Musik: Das Kammerorchester mischt gekonnt moderne mit klassischen Elementen."@de,
        "The Zurich Chamber Orchestra successfully mixes elements of both contemporary and classical music."@en,
        "A Zurich, la musique est reine : l’orchestre de chambre sait marier moderne et classique."@fr,
        "Zurigo è pervasa dalla musica: l’orchestra da camera mescola abilmente elementi moderni e classici."@it ;
    namiont:titleTeaser "Zürcher Kammerorchester"@de,
        "Zurich Chamber Orchestra"@en,
        "Orchestre de chambre"@fr,
        "Zürcher Kammerorchester"@it ;
    namiont:zurichCard false ;
    schema:address [ a schema:PostalAddress ;
            schema:addressCountry "CH" ;
            schema:addressLocality "Zürich" ;
            schema:postalCode "8008" ;
