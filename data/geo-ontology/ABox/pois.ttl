    geo:hasGeometry _:N9b12d1e4fb1f4142819aa9dd9a209547 ;
    namiont:detailedInformation "12 Biere ab Zapfhahn"@de,
        "40 Sorten Flaschenbier"@de,
        "Eine Gehminute vom Hauptbahnhof entfernt"@de,
        "Ganzjährig geöffnete Dachterrasse"@de,
        "12 kinds of draught beer"@en,
        "40 types of bottled beer "@en,
        "One-minute walk from the Main Station"@en,
        "Roof terrace open all year round"@en,
        "12 sortes de bières à la pression"@fr,
        "40 sortes de bières en bouteille"@fr,
        "Terrasse de toit ouverte toute l’année"@fr,
        "À une minute à pied de la gare centrale "@fr,
        "12 birre alla spina"@it,
