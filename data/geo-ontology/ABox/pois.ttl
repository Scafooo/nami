    namiont:customType "Market" ;
    namiont:osmId "3387701318" ;
    namiont:placeType namiont:Outdoors ;
    namiont:specialOpeningHoursNote "<p>Der Wochenmarkt Uster findet das ganze Jahr &uuml;ber jeden Freitagmorgen von 07.30 bis 11.00 Uhr&nbsp;statt (ausser&nbsp;w&auml;hrend den Weihnachtsfeiertagen.)</p>"@de ;
    namiont:textTeaser "Am Freitagmorgen trifft sich die Bevölkerung von Uster am Wochenmarkt."@de,
        "Every Friday morning, Uster residents come together at the weekly market."@en,
        "Le vendredi matin, les habitants d'Uster se rencontrent sur leur marché hebdomadaire."@fr,
        "Di venerdì mattina, gli abitanti di Uster si trovano al mercato settimanale."@it ;
    namiont:titleTeaser "Wochenmarkt Uster"@de,
        "Uster Weekly Market"@en,
        "Marché d'Uster"@fr,
        "Mercato di Uster"@it ;
    namiont:zurichCard false ;
    schema:address [ a schema:PostalAddress ;
            schema:addressCountry "CH" ;
            schema:addressLocality "Uster" ;
            schema:postalCode "8610" ;
            schema:streetAddress "Post- und der Gerichtsstrasse" ] ;
    schema:copyrightHolder "Zürich Tourismus www.zuerich.com"@de,
        "Zurich Tourism www.zuerich.com"@en,
        "Zürich Tourisme www.zuerich.com"@fr,
        "Zürich Tourismo www.zuerich.com"@it ;
    schema:dateModified "2026-04-28T11:05:00"^^xsd:dateTime ;
    schema:dayOfWeek schema:Friday ;
    schema:description "<p>Jeden Freitagmorgen str&ouml;mt die &laquo;Ustemer&raquo; Bev&ouml;lkerung auf den Platz vor dem Stadthaus, um die K&ouml;stlichkeiten und Produkte ihrer Region zu entdecken. Von Freilandeiern des Biobauers &uuml;ber selbstgemachte Teigwaren bis hin zu frischem Brot findet man am Wochenmarkt in Uster &ndash; der bis auf eine kurze Pause &uuml;ber die Weihnachtsfeiertage jede Woche stattfindet &ndash; alles, was das Herz begehrt.&nbsp;</p>"@de,
        "<p>Every Friday morning,&nbsp; Uster residents flock to the square in front of the village hall to purchase culinary delicacies and products from the region. At the Uster weekly market, you can find everything your heart desires, from free range eggs to home made pasta, right through to freshly baked bread. The market takes place every week, with the exception of a short break over Christmas.&nbsp;</p>"@en,
        "<p>Chaque vendredi, les habitants d'Uster se rendent sur la place devant l'h&ocirc;tel de ville pour d&eacute;couvrir&nbsp; les d&eacute;lices et produits de leur r&eacute;gion. Des &oelig;ufs de poules &eacute;lev&eacute;es en libert&eacute; chez des paysans bio en passant par des p&acirc;tes maison jusqu'au pain frais, vous trouverez sur le &laquo; Ustemer M&auml;rt &raquo;&nbsp; qui a lieu chaque semaine sauf une br&egrave;ve interruption pendant les f&ecirc;tes de No&euml;l &ndash; tout ce que votre c&oelig;ur d&eacute;sire.</p>"@fr,
        "<p>Ogni venerd&igrave; mattina, gli abitanti di Uster si riversano nella piazza davanti al municipio per scoprire delizie e prodotti della loro regione. Uova da allevamenti a terra dei contadini biologici, pasta fatta in casa, pane fresco: allo \"Ustemer M&auml;rt\", che si svolge ogni settimana, ad eccezione di una piccola pausa natalizia, si trova tutto ci&ograve; che si desidera.&nbsp;</p>"@it ;
    schema:disambiguatingDescription "Am Freitagmorgen trifft sich die Bevölkerung von Uster am Wochenmarkt, um frische Produkte aus der Region zu erstehen."@de,
        "Every Friday morning, Uster residents come to the weekly market to purchase fresh products from the region."@en,
        "Le vendredi matin, les habitants d'Uster se rencontrent sur leur marché hebdomadaire pour acheter les produits frais de la région."@fr,
        "Di venerdì mattina, gli abitanti di Uster si trovano al mercato settimanale per comprare prodotti regionali freschi."@it ;
    schema:geo _:N9a875b5b46cb4a2c8519003dea4055d1 ;
    schema:identifier "6221" ;
