    dct:subject <https://example.org/nami/data/category/72>,
        <https://example.org/nami/data/category/73> ;
    geo:hasGeometry _:N1126e196c37f4fe0bc427bfc9e690bc7 ;
    namiont:detailedInformation "Ungewöhnliche Sicht über Zürich"@de,
        "Zentral gelegen"@de,
        "Öffentliche sternkundliche Führungen"@de,
        "Central location "@en,
        "Out-of-the-ordinary views of Zurich"@en,
        "Public astronomy tours "@en,
        "Situation centrale"@fr,
        "Visites astronomiques publiques et guidées "@fr,
        "Vue particulière sur Zurich"@fr,
        "Posizione centrale"@it,
        "Straordinaria vista su Zurigo"@it,
        "Visite guidate astronomiche"@it ;
    namiont:osmId "494525722" ;
    namiont:specialOpeningHoursNote "<ul><li>&Ouml;ffentliche F&uuml;hrungen (bei jedem Wetter): Donnerstag, Freitag und Samstag&nbsp;<br> Winterzeit 20.00 Uhr / Sommerzeit 21.00 Uhr</li><li>Der Eingang an der Uraniastrasse 9 &ouml;ffnet 30 Minuten vor Beginn der F&uuml;hrung</li><li>Abendf&uuml;hrungen ab ca. 9 Jahren empfohlen</li><li>Jeden 1. Samstag im Monat um 14.00, 15.30 und 17.00 Uhr Kinderf&uuml;hrungen</li><li>F&uuml;hrungen f&uuml;r Schulklassen und private F&uuml;hrungen auf Anfrage</li></ul>"@de,
        "<ul><li>Guided tours for the public: Thursday, Friday and Saturday in all weathers<br> Start: 8.00pm&nbsp;during winter, 9.00pm during summer</li><li>The entrance at Uraniastrasse 9 opens 30 minutes before the start of the visit</li><li>Evening tours recommended for children of 9 years and above</li><li>Every first Saturday of the month tours for children at 2pm, 3.30pm&nbsp;and 5pm&nbsp;</li><li>Guided tours for schools and private tours on request</li></ul>"@en,
        "<ul><li>Visite guid&eacute;e publique&nbsp;(par tous les temps): jeudi, vendredi et samedi<br> Heure d'hiver 20h00 / Heure d'&eacute;t&eacute; 21h00</li><li>Il est possible d'acheter le ticket 30 minutes avant le d&eacute;but du tour</li><li>Visites en soir&eacute;e d'environ 9 ans recommand&eacute;es</li><li>Tous les 1er samedi du mois &agrave; 14h, 15h30 et 17h visites pour les enfants</li><li>Visites guid&eacute;es pour les classes d'&eacute;cole et les visites priv&eacute;es sur demande</li></ul>"@fr,
        "<ul><li>Visite guidate pubbliche (con bel/brutto tempo): gioved&igrave;, venerd&igrave; e sabato<br> Periodo invernale 20.00 / Periodo estivo 21.00</li><li>Entrata possibile 30 minuti prima della visita.</li><li>Visite guidate pubbliche consigliate a partire dai 9 anni</li><li>Ogni primo sabato del mese visite per bambini alle 14.00, 15.30&nbsp;e 17.00</li><li>Visite guidate per classi scolastiche e private su richiesta</li></ul>"@it ;
    namiont:textTeaser "Hier liegt einem Zürich zu Füssen – die Urania-Sternwarte bietet spannende Einblicke in den Kosmos."@de,
        "Here Zurich lies at your feet – as the Urania-Sternwarte (observatory) bids exciting views."@en,
        "Dominant Zurich, l'Observatoire Urania propose de jeter un coup d'œil passionnant vers le cosmos."@fr,
        "Qui Zurigo sembra essere ai tuoi piedi: l'osservatorio Urania regala scorci avvincenti nel cosmo."@it ;
    namiont:titleTeaser "Urania-Sternwarte"@de,
        "Urania-Sternwarte (Observatory)"@en,
        "Observatoire Urania"@fr,
        "Osservatorio Urania"@it ;
    namiont:zurichCard true ;
    namiont:zurichCardDescription "25% Ermässigung"@de,
        "25% discount"@en,
        "25% de réduction"@fr,
        "25% di sconto"@it ;
    schema:address [ a schema:PostalAddress ;
            schema:addressCountry "CH" ;
            schema:addressLocality "Zürich" ;
            schema:postalCode "8001" ;
            schema:streetAddress "Uraniastrasse 9" ] ;
    schema:copyrightHolder "Zürich Tourismus www.zuerich.com"@de,
        "Zurich Tourism www.zuerich.com"@en,
        "Zürich Tourisme www.zuerich.com"@fr,
        "Zürich Tourismo www.zuerich.com"@it ;
    schema:dateModified "2025-11-21T12:16:00"^^xsd:dateTime ;
    schema:dayOfWeek schema:Friday,
        schema:Saturday,
        schema:Thursday ;
    schema:description "<p>Im Herzen der Innenstadt greifen Entdecker nach den Sternen. Im 50 Meter hohen Rundturm der Urania-Sternwarte beobachten Besucher die Himmelsk&ouml;rper durch ein Teleskop bis zu 600-facher Vergr&ouml;sserung. Ob Mondkrater, die Wolkenb&auml;nder des Jupiters oder den Kirchturm des Fraum&uuml;nsters: Eine F&uuml;hrung&nbsp; in der gemeinn&uuml;tzigen Volkssternwarte ist immer eine besondere Erfahrung.&nbsp;Die F&uuml;hrungen werden auf Deutsch angeboten.<p>Die 1907 er&ouml;ffnete Volkssternwarte war der erste Betonbau, der in Z&uuml;rich errichtet wurde. Bis heute ist es eins der markantesten Geb&auml;ude der historischen Altstadt und steht seit 1989 unter Denkmalschutz. Das 12 Tonnen schwere Zeiss-Teleskop wurde zum 100-Jahr-Jubil&auml;um 2007 umfassend erneuert.</p></p>"@de,
        "<p>In the heart of central Zurich, astronomy fans can reach for the stars. In the 50m (164ft) high round tower of the Urania observatory, visitors can observe the heavenly bodies through a telescope that allows magnifications of up to 600 times. Whether you want to take a closer look at the craters on the moon, the bands of clouds surrounding Jupiter, or the church tower of the Fraum&uuml;nster: a guided tour to the non-profit public observatory is always a memorable experience.&nbsp;The tours are offered in German.<p>The Urania observatory, which opened in 1907, was the first building in Zurich to be made from concrete. It is still one of the most distinctive buildings in the historical Old Town, and has been listed as a protected monument since 1989. The 12-ton Zeiss telescope underwent extensive renovation on the occasion of the observatory&rsquo;s centenary in 2007.</p></p>"@en,
        "<p>Au c&oelig;ur du centre-ville zurichois, les explorateurs cherchent les &eacute;toiles. Dans la tour ronde de l&rsquo;observatoire, haute de 50 m&egrave;tres, un t&eacute;lescope permet aux visiteurs d&rsquo;observer les corps c&eacute;lestes avec un grossissement jusqu'&agrave; 600. Que l&rsquo;on observe les crat&egrave;res lunaires, les bancs de nuages entourant Jupiter ou alors la tour de l&rsquo;&eacute;glise&nbsp; Fraum&uuml;nster, la visite de l&rsquo;observatoire public est toujours une exp&eacute;rience extraordinaire.&nbsp;Les tours guid&eacute;s sont propos&eacute;s en allemand.<p>Ouvert en 1907, l&rsquo;observatoire fut la premi&egrave;re construction en b&eacute;ton de la ville de Zurich. Class&eacute; monument historique en 1989, l&rsquo;immeuble est toujours l&rsquo;un des plus imposants de la vieille ville historique. A l&rsquo;occasion du centenaire de l&rsquo;observatoire en 2007, son t&eacute;lescope Zeiss, qui p&egrave;se 12 tonnes, a &eacute;t&eacute; r&eacute;nov&eacute; enti&egrave;rement.</p></p>"@fr,
        "<p>Nel cuore del centro cittadino, le stelle sembrano vicinissime. Sulla torre rotonda dell&rsquo;osservatorio Urania, alta 50 metri, i visitatori ammirano i corpi celesti con un telescopio che ingrandisce fino a 600 volte gli oggetti osservati. Che si tratti di crateri lunari, nubi di Giove o campanile della Chiesa di Fraum&uuml;nster, una visita all&rsquo;osservatorio astronomico &egrave; sempre un&rsquo;esperienza stellare.&nbsp;Le visite sono offerte in tedesco.<p>Aperto nel 1907, l&rsquo;osservatorio fu il primo edificio in cemento costruito a Zurigo. Ancora oggi, &egrave; una delle costruzioni pi&ugrave; caratteristiche del centro storico. Dal 1989 &egrave; sottoposto a tutela. Il telescopio Zeiss da 12 tonnellate &egrave; stato rinnovato nel 2007, in occasione del centenario.</p><p>Venerd&igrave; e sabato, qui si svolgono visite guidate pubbliche di sera con qualsiasi condizione atmosferica; ogni primo sabato del mese, invece, si tengono apposite visite per bambini.</p></p>"@it ;
    schema:disambiguatingDescription "Hier liegt einem Zürich zu Füssen – die Urania-Sternwarte bietet spannende Einblicke in den Kosmos."@de,
        "Here Zurich lies at your feet – as the Urania-Sternwarte (observatory) bids exciting views of the cosmos."@en,
        "Dominant Zurich, l'Observatoire Urania propose de jeter un coup d'œil passionnant vers le cosmos."@fr,
        "Qui Zurigo sembra essere ai tuoi piedi: l'osservatorio Urania regala scorci avvincenti nel cosmo."@it ;
