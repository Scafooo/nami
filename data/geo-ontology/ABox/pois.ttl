    geo:hasGeometry _:Nd8c600fea5e947b2ba3473a4d945c844 ;
    namiont:textTeaser "Modernes Hotel an der Riviera am oberen Zürichsee: ideal für Geschäftsreisen oder einen Kurzurlaub."@de,
        "Modern hotel on the Riviera at the upper end of Lake Zurich for business trips or a short vacation."@en,
        "Hôtel moderne sur les rives du lac de Zurich : idéal pour les voyages d’affaires et les courts séjours."@fr,
        "Moderno hotel sulle rive del Lago di Zurigo superiore: ideale per viaggi d’affari o brevi vacanze."@it ;
    namiont:titleTeaser "Moxy Rapperswil"@de,
        "Moxy Rapperswil"@en,
        "Moxy Rapperswil"@fr,
        "Moxy Rapperswil"@it ;
