    schema:telephone "+41 44 800 42 21" ;
    schema:url <https://www.radissonhotels.com/en-us/hotels/radisson-blu-zurich-airport/restaurant-bar/filini> .

<https://example.org/nami/data/poi/196594> a schema:FoodEstablishment,
