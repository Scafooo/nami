    schema:priceRange "<div class=\"table-container\"><table><tbody><tr><th>Regulär</th><td>CHF 15</td></tr><tr><th>Ermässigt</th><td>CHF 10</td></tr><tr><th>Kombiticket (regulär)</th><td>CHF 20 (alle Standorte)</td></tr><tr><th>Kombiticket (ermässigt)</th><td>CHF 15 (alle Standorte)</td></tr><tr><th>Zürich Card-Besitzer:innen</th><td>gratis</td></tr><tr><th>Unter 20 Jahren</th><td>gratis</td></tr></tbody></table><p>Info: Freier Eintritt jeden Donnerstag ab 17 Uhr</p></div>"@de,
        "<div class=\"table-container\"><table><tbody><tr><th>Regular</th><td>CHF 15</td></tr><tr><th>Reduced</th><td>CHF 10</td></tr><tr><th>Combined ticket (regular)</th><td>CHF 20 (all locations)</td></tr><tr><th>Combined ticket&nbsp;(reduced)</th><td>CHF 15 (all locations)</td></tr><tr><th>Zürich Card holders</th><td>free</td></tr><tr><th>Under 20 years</th><td>free</td></tr></tbody></table><p>Info: Free admission every Thursday from 5 pm</p></div>"@en,
