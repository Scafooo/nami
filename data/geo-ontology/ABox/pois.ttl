        <https://example.org/nami/data/category/96> ;
    geo:hasGeometry _:N092db18027b34c0cbbadbf1d7735683b ;
    namiont:detailedInformation "Direkt am Fluss Limmat gelegen"@de,
        "Lesesaal mit Zeitungen und Belletristik in diversen Sprachen"@de,
