        <https://example.org/nami/data/category/96> ;
    geo:hasGeometry _:Ne62739e79d654b3795ed1381985e3d10 ;
    namiont:detailedInformation "Aktuelle und Klassische Literatur im Fokus"@de,
        "Inszenierungen, Ausstellungen, Veranstaltungen"@de,
        "Zentral in der Altstadt gelegen"@de,
