    schema:license "CC BY-SA" ;
    schema:openingHours "Mo,Tu,We,Th,Fr,Sa,Su 12:00:00-22:00:00" ;
    schema:telephone "+41 44 291 01 28" ;
    schema:url <https://www.rosso-arancio.ch> .

<https://example.org/nami/data/poi/516623> a schema:CivicStructure,
