                "Augustinergasse, Zurigo"@it ;
            schema:contentUrl <https://www.zuerich.com/sites/default/files/web_zuerich_atstadt_augustinergasse_1280x960_12232.jpg> ] ;
    schema:license "CC BY-SA" .

