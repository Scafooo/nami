    namiont:detailedInformation "36° warmes Sole Bad"@de,
        "Aussenbäder"@de,
        "Dampfbad"@de,
        "Massagen und andere Behandlungen"@de,
        "Saunabereich"@de,
        "36°C brine thermal bath"@en,
        "Massage and other treatments"@en,
        "Outdoor pools"@en,
        "Sauna area"@en,
        "Steam bath"@en,
        "Bain de vapeur"@fr,
        "Bain d’eau saline à 36°"@fr,
