    geo:hasGeometry _:N082a8c7ac28241d1ad1193617f2ae3a7 ;
    namiont:textTeaser "Das perfekte Hotel für alle, die Exklusivität mit Schweizer luxuriösen Komfort schätzen."@de,
        "The perfect hotel for all those who appreciate exclusivity, comfort, and Swiss luxury."@en,
