    schema:priceRange "<div class=\"table-container\"><table class=\"table\"><thead><tr><th>Eintritt</th><th>Kunsthalle</th></tr><tr><th>Donnerstags ab 17.00 Uhr freier Eintritt</th><th>&nbsp;</th></tr></thead><tbody><tr><th>Regulär</th><td>CHF 12</td></tr><tr><th>Ermässigt</th><td>CHF 8</td></tr><tr><th>Kinder (bis 16 Jahre)</th><td>gratis</td></tr><tr><th>Zürich Card-Besitzer:innen</th><td>gratis</td></tr></tbody></table></div>"@de,
        "<div class=\"table-container\"><table class=\"table\"><thead><tr><th>Entrance</th><th>Kunsthalle</th></tr><tr><th>Free entry on Thursdays from 5.00pm</th><th>&nbsp;</th></tr></thead><tbody><tr><th>Regular</th><td>CHF 12</td></tr><tr><th>Concessions</th><td>CHF 8</td></tr><tr><th>Children (up to 16 years)</th><td>free</td></tr><tr><th>Zürich Card holders</th><td>free</td></tr></tbody></table></div>"@en,
        "<div class=\"table-container\"><table class=\"table\"><thead><tr><th>Entrée</th><th>Kunsthalle</th></tr><tr><th>Entrée libre le jeudi à.p.d. 17h</th><th>&nbsp;</th></tr></thead><tbody><tr><th>Normal</th><td>CHF 12</td></tr><tr><th>Réduit</th><td>CHF 8</td></tr><tr><th>Enfants (jusqu'à 16 ans)</th><td>gratuit</td></tr><tr><th>Visiteurs en possession d’une Zürich Card</th><td>gratuit</td></tr></tbody></table></div>"@fr,
        "<div class=\"table-container\"><table class=\"table\"><thead><tr><th>Ingresso</th><th>Kunsthalle</th></tr><tr><th>Giovedì dalle 17.00 ingresso libero</th><th>&nbsp;</th></tr></thead><tbody><tr><th>Regolare</th><td>CHF 12</td></tr><tr><th>Ridotto</th><td>CHF 8</td></tr><tr><th>Bambini (fino a 16 anni)</th><td>gratuito</td></tr><tr><th>Visitatori in possesso di una Zürich Card</th><td>gratuito</td></tr></tbody></table></div>"@it ;
    schema:telephone "+41 44 272 15 15" ;
    schema:url <http://www.kunsthallezurich.ch> .

