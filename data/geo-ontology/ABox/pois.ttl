    namiont:detailedInformation "Freiluft-Location"@de,
        "Hängende Gärten in Altstetten"@de,
        "Internationales Street Food"@de,
        "Hanging gardens in Altstetten"@en,
        "International street food"@en,
        "Open-air venue"@en,
        "Jardins suspendus à Altstetten"@fr,
        "Lieu en plein air"@fr,
        "Street food international"@fr,
