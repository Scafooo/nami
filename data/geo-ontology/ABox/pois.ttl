    namiont:specialOpeningHoursNote "<p><a href=\"https://www.landesmuseum.ch/de/ihr-besuch/oeffnungszeiten\">Spezielle &Ouml;ffnungszeiten Landesmuseum</a> w&auml;hrend den Feiertagen</p>"@de,
        "<p><a href=\"https://www.landesmuseum.ch/en/your-visit/opening-times\">Special opening hours Swiss National Museum</a> during the holidays</p>"@en,
        "<p><a href=\"https://www.landesmuseum.ch/fr/visite/horaires\">Heures d'ouverture sp&eacute;ciales Mus&eacute;e national suisse</a> pendant les jours f&eacute;ri&eacute;s</p>"@fr,
        "<p><a href=\"https://www.landesmuseum.ch/it/visita/orari-dapertura\">Orari d'apertura speciali Museo Nationale Svizzero</a> durante i giorni festivi</p>"@it ;
    namiont:textTeaser "Innen wie Aussen ist das Landesmuseum beim Hauptbahnhof ein eindrückliches Schmuckstück."@de,
        "Both inside and out, the National Museum behind the Main Station is an impressive architectural gem."@en,
        "Le Musée national près de la gare centrale est un vrai bijou, à l’intérieur comme à l’extérieur."@fr,
        "Il Museo Nazionale Zurigo, accanto alla Stazione Centrale, è un gioiellino dentro e fuori."@it ;
    namiont:titleTeaser "Landesmuseum Zürich"@de,
        "National Museum Zurich"@en,
        "Musée national suisse"@fr,
        "Museo Nazionale Zurigo"@it ;
    namiont:zurichCard true ;
    namiont:zurichCardDescription "Freier Eintritt"@de,
        "Free admission with the Zürich Card"@en,
        "Entrée libre avec la Zürich Card"@fr,
        "Ingresso gratuito con la Zürich Card"@it ;
    schema:address [ a schema:PostalAddress ;
            schema:addressCountry "CH" ;
