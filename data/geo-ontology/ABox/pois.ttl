            schema:contentUrl <https://www.zuerich.com/sites/default/files/image/2022/web_zuerich_wanderung_industrielehrpfad_1280x060_no_MAM.jpg> ] ;
    schema:license "CC BY-SA" ;
    schema:telephone "+41 52 396 50 90" ;
    schema:url <https://www.zuerioberland-tourismus.ch/> .

