    dct:subject <https://example.org/nami/data/category/136>,
        <https://example.org/nami/data/category/96> ;
    geo:hasGeometry _:N3d22ad35697c440d9b4a744dbeff07ba ;
    namiont:detailedInformation "Aktien und Anleihen aus aller Welt"@de,
        "Geschichte des Finanzmarkts"@de,
        "Multimediale Ausstellung"@de,
        "History of the financial market"@en,
        "Multimedia exhibition"@en,
        "Shares and bonds from all over the world"@en,
        "Actions et obligations du monde entier"@fr,
        "Exposition multimédia"@fr,
        "Histoire du marché financier"@fr,
        "Azioni e obbligazioni di tutto il mondo"@it,
        "Mostra multimediale"@it,
        "Storia del mercato finanziario"@it ;
    namiont:osmId "4938375428" ;
    namiont:placeType namiont:Indoors ;
    namiont:specialOpeningHoursNote "<p><strong>An folgenden Tagen geschlossen:&nbsp;</strong><p>Zukunftstag: 12. November 2026.</p><p>Komplettsanierung: 14. Dezember 2026 bis 5. M&auml;rz 2027.</p></p>"@de,
        "<p><strong>Closed on the following days:</strong><p>Future Day: November 12, 2026.</p><p>Complete renovation: December 14, 2026, through March 5, 2027.</p></p>"@en,
        "<p><strong>Ferm&eacute; les jours suivants :</strong><p>Journ&eacute;e de l'avenir : 12 novembre 2026.</p><p>R&eacute;novation compl&egrave;te : du 14 d&eacute;cembre 2026 au 5 mars 2027.</p></p>"@fr,
        "<p><strong>Chiuso nei seguenti giorni:</strong><p>Giornata del Futuro: 12 novembre 2026.</p><p>Ristrutturazione completa: dal 14 dicembre 2026 al 5 marzo 2027.</p></p>"@it ;
    namiont:textTeaser "Alles über die Geschichte und die Funktionsweise des Finanzplatz Schweiz in einem Museum."@de,
        "All you need to know about the history and workings of the Swiss financial center in one museum."@en,
        "Tout sur l’histoire et le fonctionnement de la place financière suisse dans un musée."@fr,
        "La storia e il funzionamento della piazza finanziaria svizzera in un unico museo."@it ;
    namiont:titleTeaser "Schweizer Finanzmuseum"@de,
        "Swiss Finance Museum"@en,
        "Musée suisse des finances"@fr,
        "Museo Svizzero delle Finanze"@it ;
    namiont:zurichCard true ;
    namiont:zurichCardDescription "Freier Eintritt"@de,
        "Free admission with the Zürich Card"@en,
        "Entrée libre avec la Zürich Card"@fr,
        "Ingresso gratuito con la Zürich Card"@it ;
    schema:address [ a schema:PostalAddress ;
            schema:addressCountry "CH" ;
            schema:addressLocality "Zürich" ;
            schema:postalCode "8005" ;
            schema:streetAddress "Pfingstweidstrasse 110" ] ;
    schema:copyrightHolder "Zürich Tourismus www.zuerich.com"@de,
        "Zurich Tourism www.zuerich.com"@en,
        "Zürich Tourisme www.zuerich.com"@fr,
        "Zürich Tourismo www.zuerich.com"@it ;
    schema:dateModified "2026-08-20T08:16:00"^^xsd:dateTime ;
    schema:dayOfWeek schema:Friday,
        schema:Monday,
        schema:Thursday,
        schema:Tuesday,
        schema:Wednesday ;
    schema:description "<p>Wie funktioniert der Finanzmarkt? Und wie beeinflusst dieser unser t&auml;gliches Leben? Wo liegen die Urspr&uuml;nge unseres Wirtschaftssystems und wie funktioniert eigentlich der B&ouml;rsenhandel? Solche und viele weitere Fragen werden im Schweizer Finanzmuseum in Z&uuml;rich-West beantwortet. Multimedial und spannend gestaltet erz&auml;hlt die Ausstellung viel Wissenswertes &uuml;ber den Finanzmarkt.<p>Ein weiteres Highlight, das im Museum zu bestaunen ist, ist die weltweit bedeutendste Sammlung historischer Wertpapiere. Diese umfasst k&uuml;nstlerische gestaltete und eindr&uuml;ckliche Aktien sowie Anleihen aus der ganzen Welt.</p><table><tbody><tr><td><strong>Komplettsanierung: </strong>Das Museum bleibt vom 14. Dezember 2026 bis 5. M&auml;rz 2027 aufgrund einer Komplettsanierung geschlossen und wird anschliessend mit einer neuen Dauer- und Sonderausstellung er&ouml;ffnet.</td></tr></tbody></table></p>"@de,
        "<p>How does the financial market work, and what impact does it have on day-to-day life? What are the origins of our economic system? How does stock exchange trading actually function? These are just some of the many questions that are answered at the Swiss Finance Museum in Z&uuml;rich-West. The fascinating multimedia exhibition provides a host of interesting facts and figures about the financial market.<p>A further highlight that can be admired at the museum is the world&lsquo;s most significant collection of historical securities. These comprise artistically designed and impressive shares and bonds from all over the world.</p><table><tbody><tr><td><strong>Complete Renovation: </strong>The museum will be closed from December 14, 2026, through March 5, 2027, for a complete renovation and will reopen with a new permanent and special exhibition.</td></tr></tbody></table></p>"@en,
        "<p>Comment fonctionne le march&eacute; financier&nbsp;et quelle influence a-t-il sur notre vie quotidienne&nbsp;? Quelles sont les origines de notre syst&egrave;me &eacute;conomique et comment fonctionnent les march&eacute;s boursiers&nbsp;? Le mus&eacute;e suisse des finances &agrave; Zurich-Ouest r&eacute;pond &agrave; ces questions et &agrave; bien d&rsquo;autres. De fa&ccedil;on captivante, l&rsquo;exposition multim&eacute;dia permanente fournit des informations int&eacute;ressantes sur le march&eacute; financier.<p>Le mus&eacute;e expose d&rsquo;ailleurs la plus importante collection de titres historiques au monde. Elle englobe des actions artistiques impressionnantes ainsi que des emprunts du monde entier.</p><table><tbody><tr><td><strong>R&eacute;novation compl&egrave;te : </strong>Le mus&eacute;e sera ferm&eacute; du 14 d&eacute;cembre 2026 au 5 mars 2027 en raison d'une r&eacute;novation compl&egrave;te et rouvrira ensuite ses portes avec une nouvelle exposition permanente et une exposition temporaire.</td></tr></tbody></table></p>"@fr,
        "<p>Come funziona il mercato finanziario? E come influenza la nostra vita quotidiana? Dove affondano le radici del sistema economico elvetico e come funzionano le contrattazioni in borsa? Queste e tante altre domande trovano risposta al Museo Svizzero delle Finanze di Z&uuml;rich-West. Allestita in modo multimediale e avvincente, la mostra racconta tante cose interessanti sul mercato finanziario.<p>Un&rsquo;altra chicca del museo &egrave; la collezione di titoli storici pi&ugrave; importante del mondo, che spazia da azioni artistiche a obbligazioni internazionali.</p><table><tbody><tr><td><strong>Ristrutturazione completa: </strong>Il museo rimarr&agrave; chiuso dal 14 dicembre 2026 al 5 marzo 2027 a causa di una ristrutturazione completa e riaprir&agrave; successivamente con una nuova mostra permanente e una mostra temporanea.</td></tr></tbody></table></p>"@it ;
    schema:disambiguatingDescription "Wer wissen möchte, wie unser Wirtschaftssystem funktioniert oder wie der Börsenhandel entstanden ist, besucht das Schweizer Finanzmuseum in Zürich-West."@de,
        "Anyone who would like to find out how our economic system works or how stock exchange trading originated should be sure to pay a visit to the Swiss Finance Museum in the Zürich-West quarter."@en,
        "Qui souhaite connaître le fonctionnement de notre système économique ou l’origine des marchés boursiers, visite le musée suisse des finances à Zurich-Ouest."@fr,
        "Se vuoi sapere come funziona il sistema economico elvetico o come sono nate le contrattazioni in borsa, non puoi perderti il Museo Svizzero delle Finanze a Zürich-West."@it ;
    schema:email "info@finanzmuseum.ch" ;
