    namiont:placeType namiont:Outdoors ;
    namiont:textTeaser "Direkt am Stadtrand Zürichs können sich passionierte Mountainbiker:innen auf den Trails vergnügen."@de,
        "Avid mountain bikers can enjoy two official bike trails directly on the outskirts of the city."@en,
        "A la sortie de Zurich, les  vététistes passionnés peuvent se dépenser sur des pistes verdoyantes."@fr,
        "Ai margini di Zurigo, gli appassionati di mountain bike possono divertirsi su vari tracciati."@it ;
    namiont:titleTeaser "Uetliberg Biketrails"@de,
        "Uetliberg Bike Trails"@en,
        "Pistes VTT à Uetliberg"@fr,
        "Mountain bike Uetliberg"@it ;
    namiont:zurichCard false ;
    schema:address [ a schema:PostalAddress ;
            schema:addressCountry "CH" ;
            schema:addressLocality "Zürich" ;
            schema:postalCode "8143" ;
            schema:streetAddress "Uetliberg" ] ;
    schema:copyrightHolder "Zürich Tourismus www.zuerich.com"@de,
        "Zurich Tourism www.zuerich.com"@en,
