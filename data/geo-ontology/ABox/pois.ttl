    namiont:osmId "1735267592" ;
    namiont:textTeaser "Das Bergrestaurant befindet sich im beliebten Skigebiet Atzmännig und ist gut zu Fuss erreichbar."@de,
        "The mountain restaurant lies in the popular Atzmännig ski area and can be easily reached on foot."@en,
        "Ce restaurant d’altitude accessible à pied se trouve dans le très prisé domaine de ski d’Atzmännig."@fr,
        "Il ristorante si trova nel popolare comprensorio sciistico di Atzmännig e si raggiunge a piedi."@it ;
    namiont:titleTeaser "Bergrestaurant Hüttenberg"@de,
        "Bergrestaurant Hüttenberg"@en,
        "Restaurant Hüttenberg"@fr,
        "Ristorante Hüttenberg"@it ;
    namiont:zurichCard false ;
    schema:address [ a schema:PostalAddress ;
            schema:addressCountry "CH" ;
            schema:addressLocality "Walde" ;
            schema:postalCode "8727" ;
            schema:streetAddress "Hüttenberg" ] ;
    schema:copyrightHolder "Zürich Tourismus www.zuerich.com"@de,
        "Zurich Tourism www.zuerich.com"@en,
        "Zürich Tourisme www.zuerich.com"@fr,
