    namiont:specialOpeningHoursNote "<p><strong>Montag bis Freitag</strong><br> Fr&uuml;hst&uuml;ck 06.30 &ndash; 10.30 Uhr<br> Mittagessen 12.00 &ndash; 14.30 Uhr<br> Abendessen 18.00 &ndash; 22.30 Uhr<p><strong>Samstag</strong><br> Fr&uuml;hst&uuml;ck 06.30 &ndash; 11.00 Uhr<br> Abendessen 18.00 &ndash; 22.30 Uhr</p><p><strong>Sonntag</strong><br> Fr&uuml;hst&uuml;ck 06.30 &ndash; 11.00 Uhr</p></p>"@de,
        "<p><strong>Monday to Friday</strong><br> Breakfast 06.30am &ndash; 10.30am<br> Lunch 12.00pm &ndash; 2.30pm<br> Dinner 6.00pm &ndash; 10.30pm<br><br><strong>Saturday</strong><br> Breakfast 06.30am &ndash; 11.00am<br> Dinner 6.00pm &ndash; 10.30pm<p><strong>Sunday</strong><br> Breakfast 06.30am &ndash; 11.00am</p></p>"@en,
        "<p><strong>Du lundi au vendredi</strong><br> Petit d&eacute;jeuner 6h30 &ndash; 10h30<br> D&eacute;jeuner 12h &ndash; 14h30&nbsp;<br> D&icirc;ner 18h &ndash; 22h30<p><strong>Samedi</strong><br> Petit d&eacute;jeuner 6h30 &ndash; 11h<br> D&icirc;ner 18h &ndash; 22h30</p><p><strong>Dimanche</strong><br> Petit d&eacute;jeuner 6h30 &ndash; 11h</p></p>"@fr,
        "<p><strong>Da luned&igrave; a venerd&igrave;</strong><br> Colazione 6.30 &ndash; 10.30<br> Pranzo 12.00 &ndash; 14.30<br> Cena 18.00 &ndash; 22.30<p><strong>Sabato</strong><br> Colazione 6.30 &ndash; 11.00<br> Cena 18.00 &ndash; 22.30</p><p><strong>Domenica</strong><br> Colazione 6.30 &ndash; 11.00</p></p>"@it ;
