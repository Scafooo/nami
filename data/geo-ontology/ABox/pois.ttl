        "<div class=\"table-container\"><table class=\"is-fullwidth table\"><thead><tr><th>&nbsp;</th><th>a persona</th></tr></thead><tbody><tr><th>Adulti</th><td>CHF 25</td></tr><tr><th>Bambini (4–15 anni)</th><td>CHF 12</td></tr></tbody></table></div>"@it ;
