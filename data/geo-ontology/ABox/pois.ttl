            schema:caption "Cassiopeiasteg"@de,
                "Cassiopeia Boardwalk"@en ;
            schema:contentUrl <https://www.zuerich.com/sites/default/files/keyvisual/web_cassiopeia_steg.jpg> ] ;
    schema:license "CC BY-SA" .

