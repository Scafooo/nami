    schema:priceRange "<table><tbody><tr><td>&nbsp;</td><td><strong>Erwachsene</strong></td></tr><tr><td><strong>Schlittel-Tageskarte</strong></td><td>ab CHF 35</td></tr><tr><td><strong>Schlittel-Tageskarte für die traditionelle Strecke</strong></td><td>ab CHF 28.50</td></tr></tbody></table>"@de,
        "<table><tbody><tr><td>&nbsp;</td><td><strong>Adults</strong></td></tr><tr><td><strong>Day pass</strong></td><td>from CHF 35</td></tr><tr><td><strong>Day pass for the traditional route</strong></td><td>from CHF 28.50</td></tr></tbody></table>"@en,
        "<table><tbody><tr><td>&nbsp;</td><td><strong>Adultes</strong></td></tr><tr><td><strong>Billet pour la journéé</strong></td><td>à partir de CHF 35</td></tr><tr><td><strong>Billet pour la journéé (trajet traditionnelle)</strong></td><td>à partir de CHF 28.50</td></tr></tbody></table>"@fr,
        "<table><tbody><tr><td>&nbsp;</td><td><strong>Adulti</strong></td></tr><tr><td><strong>Pass giornaliero</strong></td><td>a partire da CHF 48</td></tr><tr><td><strong>Pass giornaliero per il tracciato tradizionale</strong></td><td>a partire da CHF 36</td></tr></tbody></table>"@it ;
    schema:telephone "+41 71 998 68 10" ;
    schema:url <https://www.chaeserrugg.ch/de/startseite/winter.html> .

