    namiont:specialOpeningHoursNote "<p>Finden Sie hier alle&nbsp;<a href=\"https://www.juckerfarm.ch/hoferlebnis/baechlihof/\">&Ouml;ffnungszeiten</a>&nbsp;im Detail.</p>"@de,
        "<p>Find here more information about the&nbsp;<a href=\"https://www.juckerfarm.ch/hoferlebnis/baechlihof/\" target=\"_blank\">opening times</a></p>"@en,
        "<p>Vous trouverez ici&nbsp;<a href=\"https://www.juckerfarm.ch/hoferlebnis/baechlihof/\" target=\"_blank\">toutes les informations d&eacute;taill&eacute;es</a></p>"@fr,
        "<p>Trovate qui tutte le&nbsp;<a href=\"https://www.juckerfarm.ch/hoferlebnis/baechlihof/\">informazioni dettagliate</a>&nbsp;sugli orari.</p>"@it ;
    namiont:textTeaser "Erlebnisbauernhof mit Restaurant, Hofladen und vielen Überraschungen für die kleinen Besucher."@de,
