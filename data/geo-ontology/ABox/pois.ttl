    namiont:specialOpeningHoursNote "<p><strong>Bergbahn</strong><br>Erste Bergfahrt ab Engelberg bis Titlis: 8.30 Uhr<br>Letzte Bergfahrt vom Titlis nach Engelberg 17.00 Uhr</p>"@de,
        "<p><strong>Aerial cableway</strong><br>First ascent from Engelberg to Titlis: 8.30am<br>Last ascent from Titlis to Engelberg: 5.00pm</p>"@en,
        "<p><strong>Remont&eacute;e m&eacute;canique</strong><br>08h30&nbsp;: premi&egrave;re remont&eacute;e d&rsquo;Engelberg &agrave; Titlis<br>17h00&nbsp;: derni&egrave;re descente de Titlis &agrave; Engelberg</p>"@fr,
        "<p><strong>Ferrovia di montagna</strong><br>Prima corsa da Engelberg al Titlis: ore 08.30<br>Ultima corsa dal Titlis a Engelberg: ore 17.00</p>"@it ;
