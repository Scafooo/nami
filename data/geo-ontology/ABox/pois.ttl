        <https://example.org/nami/data/category/91> ;
    geo:hasGeometry _:N88bf6038da974638bcfc6385231850fe ;
    namiont:detailedInformation "Burg aus dem 12. Jahrhundert"@de,
        "Mittelalterliche Altstadt "@de,
        "Stadt am Zürichsee"@de,
        "Castle from the 12th century"@en,
