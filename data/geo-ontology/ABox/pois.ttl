    namiont:detailedInformation "8 Skipisten"@de,
        "Anfänger:innen-Pisten"@de,
        "Familienfreundliches Skigebiet nahe Zürich"@de,
        "8 ski pistes"@en,
        "Beginner’s slopes"@en,
        "Family-friendly ski area near Zurich"@en,
        "8 pistes de ski"@fr,
        "Domaine skiable idéal pour les familles près de Zurich"@fr,
        "Pistes pour débutant-e-s"@fr,
