            schema:caption "Rindermarkt Zürich"@en ;
            schema:contentUrl <https://www.zuerich.com/sites/default/files/keyvisual/web_zurich_sightseeing_rindermarkt.jpg> ] ;
    schema:license "CC BY-SA" .

