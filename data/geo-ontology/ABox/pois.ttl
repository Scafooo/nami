    namiont:textTeaser "Nur 30 Autominuten von Zürich entfernt finden Wintersportler:innen das herrliche Wintergebiet Einsiedeln."@de,
        "Winter sports fans can find the scenic winter region of Einsiedeln just 30 minutes away from Zurich."@en,
        "A une demi-heure de Zurich, les adeptes de sport d’hiver découvrent la splendide région d’Einsiedeln."@fr,
        "A soli 30 minuti di auto da Zurigo, si trova l’incantevole regione invernale di Einsiedeln."@it ;
    namiont:titleTeaser "Loipe Schwedentritt Einsiedeln"@de,
        "Cross-Country Skiing in Einsiedeln"@en,
        "Ski de fond à Einsiedeln"@fr,
        "Sci di fondo presso Einsiedeln"@it ;
    namiont:zurichCard false ;
    schema:address [ a schema:PostalAddress ;
            schema:addressCountry "CH" ;
            schema:addressLocality "Einsiedeln" ;
            schema:postalCode "8840" ;
            schema:streetAddress "Postfach" ] ;
