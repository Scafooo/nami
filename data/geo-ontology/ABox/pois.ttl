<https://example.org/nami/data/poi/102892> a schema:LocalBusiness,
        schema:Organization,
        schema:Place,
        schema:SportsActivityLocation ;
    rdfs:label "Farfar Ice Camp Wollerau"@de,
        "Farfar Ice Camp Wollerau"@en,
        "Farfar Ice Camp Wollerau"@fr,
        "Farfar Ice Camp Wollerau"@it ;
    dct:subject <https://example.org/nami/data/category/156>,
        <https://example.org/nami/data/category/97> ;
    geo:hasGeometry _:Nca6dbec9ca6b4beba68e559d8a65b14c ;
    namiont:detailedInformation "Eishalle und Aussenfeld"@de,
        "Eishockey, Eiskunstlauf, Eislaufen und Eisstockschiessen"@de,
        "NHL-grosses Spielfeld"@de,
        "Ice hockey, figure skating, ice skating, and Bavarian curling"@en,
        "Indoor and outdoor ice rinks"@en,
        "NHL-size ice rink"@en,
        "Hockey sur glace, patinage artistique, patinage et curling"@fr,
        "Patinoire couverte et extérieure"@fr,
        "Patinoire taille LNH"@fr,
        "Campo grande, da NHL"@it,
        "Hockey su ghiaccio, pattinaggio artistico, pattinaggio e curling"@it,
        "Palaghiaccio e campo esterno"@it ;
    namiont:osmId "163560587" ;
    namiont:placeType namiont:Indoors,
        namiont:Outdoors ;
    namiont:specialOpeningHoursNote "<p>Die oben aufgef&uuml;hrten &Ouml;ffnungszeiten beziehen sich auf das Ausseneisfeld. Die Halle steht &uuml;berwiegend der Juniorenf&ouml;rderung im Eishockey und Eiskunstlauf zur Verf&uuml;gung. Freie Stunden f&uuml;r alle werden direkt auf der <a href=\"https://icecamp.ch/\">Homepage</a> aufgeschaltet.&nbsp;</p>"@de,
        "<p>The opening hours listed above refer to the outdoor ice rink. The indoor rink is primarily reserved for junior development in ice hockey and figure skating. Public ice time slots are posted directly on <a href=\"https://icecamp.ch/en/\">the website</a>.</p>"@en,
        "<p>Les horaires d'ouverture indiqu&eacute;s ci-dessus se r&eacute;f&egrave;rent &agrave; la patinoire ext&eacute;rieure. La patinoire int&eacute;rieure est principalement r&eacute;serv&eacute;e &agrave; la promotion des jeunes dans le hockey sur glace et le patinage artistique. Les heures libres pour le public sont publi&eacute;es directement sur le<a href=\"https://icecamp.ch/en/\"> site web</a>.</p>"@fr,
        "<p>Gli orari di apertura sopra indicati si riferiscono alla pista di pattinaggio esterna. La pista coperta &egrave; principalmente riservata alla formazione dei giovani nell'hockey su ghiaccio e nel pattinaggio artistico. Gli orari liberi per tutti sono pubblicati direttamente sul <a href=\"https://icecamp.ch/en/\">sito web</a>.</p>"@it ;
    namiont:textTeaser "Der Eispark im Erlenmoos in Wollerau bietet grenzenlose Möglichkeiten für Wintersportaktivitäten."@de,
        "The Eispark Erlenmoos in Wollerau offers endless possibilities for winter sports activities."@en,
        "L’Eispark Erlenmoos à Wollerau offre des possibilités illimitées pour les activités de sports d'hiver."@fr,
        "L’Eispark Erlenmoos di Wollerau offre tantissime possibilità per praticare sport invernali."@it ;
    namiont:titleTeaser "Farfar Ice Camp in Wollerau"@de,
        "Farfar Ice Camp in Wollerau"@en,
        "Farfar Ice Camp à Wollerau"@fr,
        "Farfar Ice Camp s a Wollerau"@it ;
    namiont:zurichCard false ;
    schema:address [ a schema:PostalAddress ;
            schema:addressCountry "CH" ;
            schema:addressLocality "Wollerau" ;
            schema:postalCode "8832" ;
            schema:streetAddress "Erlenmoosweg 15" ] ;
    schema:copyrightHolder "Zürich Tourismus www.zuerich.com"@de,
        "Zurich Tourism www.zuerich.com"@en,
        "Zürich Tourisme www.zuerich.com"@fr,
        "Zürich Tourismo www.zuerich.com"@it ;
    schema:dateModified "2026-02-11T11:40:00"^^xsd:dateTime ;
    schema:dayOfWeek schema:Friday,
        schema:Monday,
        schema:Saturday,
        schema:Sunday,
        schema:Thursday,
        schema:Tuesday,
        schema:Wednesday ;
    schema:description "<p>Im Eispark Erlenmoos in Wollerau wartet ein Paradies f&uuml;r Eissportbegeisterte. Das&nbsp;&laquo;Farfar Ice Camp&raquo; bietet mit seiner Eishalle und dem Ausseneisfeld grenzenlosen Spass f&uuml;r Eishockey, Eiskunstlauf, Eislaufen und Eisstockschiessen.<p>Das Herzst&uuml;ck der Anlage ist das NHL-grosse Spielfeld, das sowohl f&uuml;r Trainings als auch f&uuml;r Spiele genutzt wird. Ein besonderes Erlebnis ist der Goalie-Trainingsraum, in dem Eishockey-Torh&uuml;ter:innen auf echtem Eis trainieren. Erg&auml;nzt wird das Angebot durch einen Kraft- und Gymnastikraum.</p><p>Ob Firmen, Vereine oder Gruppen &ndash; die Anlage kann am Abend oder tags&uuml;ber exklusiv gemietet werden. Neben dem Eis l&auml;dt das Restaurant &laquo;Timeout&raquo; zum Verweilen ein.</p></p>"@de,
        "<p>The Eispark Erlenmoos in Wollerau is a paradise for ice sports enthusiasts. With its indoor and outdoor ice rinks, the Farfar Ice Camp offers unlimited fun for ice hockey, figure skating, ice skating, and Bavarian curling.<br><br>The centerpiece of the facility is the NHL-size ice rink, which is used for both training sessions and matches. A special feature is the goalie training room, where ice hockey goalkeepers train on real ice. Rounding off the facilities is a weight and fitness room.<br><br>Whether for companies, clubs, or groups &ndash; the ice rinks can be hired exclusively in the evening or during the day. Off the ice, the Timeout restaurant invites visitors to stop and linger awhile.</p>"@en,
        "<p>Un paradis attend les passionn&eacute;s de sports de glace &agrave; l&rsquo;Eispark Erlenmoos &agrave; Wollerau. Avec sa patinoire couverte et sa patinoire ext&eacute;rieure, &laquo;&nbsp;Farfar Ice Camp&nbsp;&raquo; offre un plaisir sans limite pour le hockey sur glace, le patinage artistique, le patinage et le curling.<br><br>La pi&egrave;ce ma&icirc;tresse du site est la patinoire aussi grande que celle de la ligue nationale de hockey, qui est utilis&eacute;e aussi bien pour les entra&icirc;nements que pour les matchs. Dans leur salle d'entra&icirc;nement, les gardiens peuvent s'entra&icirc;ner sur de la vraie glace. L&rsquo;offre est compl&eacute;t&eacute;e par une salle de musculation et de gymnastique.<br><br>Que ce soit pour des entreprises, des associations ou des groupes, l&rsquo;installation peut &ecirc;tre lou&eacute;e en exclusivit&eacute; le soir ou pendant la journ&eacute;e. Le restaurant associ&eacute; Timeout invite &agrave; la d&eacute;tente.</p>"@fr,
        "<p>All&rsquo;Eispark Erlenmoos di Wollerau, gli appassionati degli sport su ghiaccio trovano un vero e proprio paradiso. Con il suo palaghiaccio e il campo esterno, il Farfar Ice Camp offre divertimento illimitato praticando hockey su ghiaccio, pattinaggio artistico, pattinaggio e curling.<p>Il cuore della struttura &egrave; il campo grande, da NHL, che pu&ograve; essere utilizzato sia per allenarsi sia per disputare partite. Particolare &egrave; la sala &ldquo;Goalie&rdquo;, nella quale i portieri che giocano a hockey possono allenarsi su ghiaccio vero. A queste proposte si aggiunge anche una sala pesi.</p><p>Aziende, associazioni, gruppi: l&rsquo;impianto pu&ograve; essere affittato in esclusiva di sera o di giorno. Il ristorante&nbsp;Timeout invita, invece, a rilassarsi e gustare qualcosa di buono.</p></p>"@it ;
    schema:disambiguatingDescription "Nicht nur im Winter, sondern das ganze Jahr über leben Eishockey- und Eislauf-Fans hier ihre Leidenschaft aus."@de,
        "Here ice hockey and ice skating fans live out their passion not only in winter, but all year round."@en,
        "Ici, les fans de hockey sur glace et de patinage s’adonnent à leur passion aussi en dehors de l’hiver."@fr,
        "Qui, gli amanti dell’hockey e del pattinaggio su ghiaccio possono vivere la propria passione tutto l’anno, non solo in inverno."@it ;
    schema:email "info@icecamp.ch" ;
    schema:geo _:Nca6dbec9ca6b4beba68e559d8a65b14c ;
    schema:identifier "102892" ;
