        "<p>Gratuit</p>"@fr,
        "<p>Gratis</p>"@it ;
    schema:telephone "+41 52 267 57 22" ;
    schema:url <https://stadt.winterthur.ch/themen/leben-in-winterthur/freizeit-und-sport/ausflugsziele-freiraeume/wildpark-bruderhaus> .

