        "<div class=\"table-container\"><table class=\"is-fullwidth table\"><thead><tr><th>Entrée</th><th>&nbsp;</th></tr></thead><tbody><tr><th>Adultes (à partir de 16 ans)</th><td>CHF 5</td></tr><tr><th>Jeunes (10-15 ans)</th><td>CHF 2</td></tr><tr><th>Visiteurs en possession d’une Zürich Card</th><td>gratuite</td></tr></tbody></table></div>"@fr,
