    namiont:specialOpeningHoursNote "<p><strong>Die Penthouse Lounge</strong><br> Dienstag bis Mittwoch, 17.00 &ndash; 2.00 Uhr<br> Donnerstag bis Samstag, 17.00 &ndash; 3.00 Uhr<p><strong>After-Party-Badezimmer-Bar im Penthouse</strong><br> Dienstag bis Mittwoch, 1.00 Uhr nachts - ab<br> Donnerstag bis Samstag, 2.00 Uhr morgens und sp&auml;ter</p></p>"@de,
        "<p><strong>The Penthouse Lounge</strong><br> Tuesday&nbsp;&ndash; Wednesday,&nbsp; 5.00pm &ndash; 2.00am<br> Thursday &ndash; Saturday , 5.00pm &ndash; 3.00am<p><strong>After-Party Bathroom Bar at The Penthouse</strong><br> Tuesday &ndash; Wednesday , 1.00am &ndash; onwards<br> Thursday &ndash; Saturday , 2.00am &ndash; onwards</p></p>"@en,
        "<p><strong>&laquo; Penthouse &raquo;</strong><br> Du mardi au mercredi, de 17h &agrave; 2h du matin<br> Du jeudi au samedi, de 17h &agrave; 3h du matin<p><strong>Bar de salle de bain de l'afterparty dans le penthouse</strong><br> Du mardi au mercredi, &agrave; 1h du matin<br> Du jeudi au samedi, &agrave; partir de 2h du matin</p></p>"@fr,
        "<p><strong>Attico</strong><br> Da marted&igrave; a mercoled&igrave;, dalle 17.00 alle 2.00.<br> Da gioved&igrave; a sabato, dalle 17.00 alle 3.00.<p><strong>Bar del bagno afterparty nell'attico</strong><br> Da marted&igrave; a mercoled&igrave;, dalle ore 1.00<br> Da gioved&igrave; a sabato, dalle 2.00 in poi</p></p>"@it ;
