            schema:contentUrl <https://www.zuerich.com/sites/default/files/keyvisual/web_zurich_biken_alp-egg_01.jpg> ] ;
    schema:license "CC BY-SA" ;
    schema:telephone "+41 31 318 01 28" ;
    schema:url <http://www.mountainbikeland.ch/en/lokale-routen/route-0480.html> .

