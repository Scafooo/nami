    schema:license "CC BY-SA" ;
    schema:priceRange "<p>Öffentliche Führungen (kostenlos)<br>Individuelle Gruppenführungen (kostenpflichtig)</p><table><tbody><tr><td>1&nbsp;– 15&nbsp;Personen</td><td>CHF&nbsp;230</td></tr><tr><td>16 – 31&nbsp;Personen</td><td>CHF 350</td></tr><tr><td>32 – 45&nbsp;Personen</td><td>CHF&nbsp;470</td></tr><tr><td>Sondertarif für Schulen</td><td>CHF&nbsp;100</td></tr></tbody></table>"@de,
        "<p>Public guided tours (free of charge)<br>Private group tours (fee payable)</p><table><tbody><tr><td>1 – 15 persons</td><td>CHF 230</td></tr><tr><td>16 –&nbsp; 31 persons</td><td>CHF 350</td></tr><tr><td>32 – 45 persons</td><td>CHF 470</td></tr><tr><td>Special rate for schools</td><td>CHF 100</td></tr></tbody></table>"@en,
        "<p>Visites guidées publiques (gratuites)<br>Visites guidées individuelles (payantes) pour les groupes</p><table><tbody><tr><td>1 à 15 personnes</td><td>CHF 230</td></tr><tr><td>16 à 31 personnes</td><td>CHF 350</td></tr><tr><td>32 à 45 personnes</td><td>CHF 470</td></tr><tr><td>Tarif spécial pour les écoles</td><td>CHF 100</td></tr></tbody></table>"@fr,
        "<p>Visite guidate pubbliche (gratuite)<br>Visite private di gruppo (a pagamento)</p><table><tbody><tr><td>1&nbsp;– 15 persone</td><td>CHF 230</td></tr><tr><td>16 – 31 persone</td><td>CHF 350</td></tr><tr><td>32 – 45 persone</td><td>CHF 470</td></tr><tr><td>Tariffa speciale per scolaresche</td><td>CHF 100</td></tr></tbody></table>"@it ;
    schema:telephone "+41 44 411 21 12" ;
    schema:url <https://www.stadt-zuerich.ch/de/stadtleben/sicherheit/zivilschutz/zivilschutzmuseum.html> .

