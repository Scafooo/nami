    geo:hasGeometry _:N51507de0aa1e469fa5156a63a560bfb8 ;
    namiont:detailedInformation "Konstante Welle"@de,
        "Mitten im urbanen Zürich-West"@de,
        "Professionelle Schulung"@de,
        "Endless wave"@en,
        "In the heart of urban Zürich-West"@en,
