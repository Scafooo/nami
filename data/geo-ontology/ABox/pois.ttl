    namiont:textTeaser "Ein Lieblingscafé vieler Zürcher ist das Café des Amis nahe dem Stadtzentrum."@de,
        "The Café des Amis close to the city center is a favorite of many Zurich locals."@en,
        "Le Café des Amis proche du centre-ville est le café préféré de nombreux Zurichois."@fr,
        "Uno dei caffè preferiti dagli zurighesi è il Café des Amis, vicino al centro."@it ;
    namiont:titleTeaser "Café des Amis"@de,
        "Café des Amis"@en,
        "Café des Amis"@fr,
        "Café des Amis"@it ;
    namiont:zurichCard false ;
    schema:address [ a schema:PostalAddress ;
            schema:addressCountry "CH" ;
            schema:addressLocality "Zürich" ;
            schema:postalCode "8037" ;
            schema:streetAddress "Nordstrasse 88" ] ;
    schema:copyrightHolder "Zürich Tourismus www.zuerich.com"@de,
