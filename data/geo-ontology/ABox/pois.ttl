    schema:priceRange "<div class=\"table-container\"><table class=\"table\"><thead><tr><th>Eintritt</th><th>&nbsp;</th></tr></thead><tbody><tr><th>Erwachsene</th><td>CHF 8</td></tr><tr><th>Jugendliche (16 – 19)</th><td>CHF 6</td></tr><tr><th>Kinder (6 – 15)</th><td>CHF 4</td></tr><tr><th>Zuschauer</th><td>CHF 2</td></tr><tr><th>Familienticket*</th><td>CHF 50</td></tr><tr><th>Zürich Card-Besitzer:innen</th><td>50% Ermässigung</td></tr></tbody></table></div><p>* Eintritt und Schlittschuhmiete für 2 Erwachsene mit 1 bis 4 Kindern bis 16 Jahre.</p>"@de,
        "<div class=\"table-container\"><table class=\"is-fullwidth table\"><thead><tr><th>Admission</th><th>&nbsp;</th></tr></thead><tbody><tr><th>Adults</th><td>CHF 8</td></tr><tr><th>Adolescents (16 – 19)</th><td>CHF 6</td></tr><tr><th>Children (6 – 15)</th><td>CHF 4</td></tr><tr><th>Spectators</th><td>CHF 2</td></tr><tr><th>Family ticket*</th><td>CHF 50</td></tr><tr><th>Zürich Card holders</th><td>50% discount</td></tr></tbody></table></div><p>* Admission for 2 adults with up to 4 children 16 or under, including skate hire.</p>"@en,
        "<div class=\"table-container\"><table class=\"is-fullwidth table\"><thead><tr><th>Entrée</th><th>&nbsp;</th></tr></thead><tbody><tr><th>Adultes</th><td>CHF 8</td></tr><tr><th>Adolescents (16 – 19)</th><td>CHF 6</td></tr><tr><th>Enfants (6 – 15)</th><td>CHF 4</td></tr><tr><th>Spectateurs</th><td>CHF 2</td></tr><tr><th>Visiteurs en possession d’une Zürich Card</th><td>50% de réduction</td></tr></tbody></table></div>"@fr,
