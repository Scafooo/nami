        <https://example.org/nami/data/category/184> ;
    geo:hasGeometry _:N0e3de3ef12144e938139627e794b7cfc ;
    namiont:detailedInformation "Gleich am Hauptbahnhof Zürich"@de,
        "Grosse Terrasse"@de,
        "Schweizer Klassiker"@de,
        "Directly opposite Zurich Main Train Station"@en,
        "Large terrace "@en,
