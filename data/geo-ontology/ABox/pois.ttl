    geo:hasGeometry _:Nf8f21620b3f04cc8ac3e7def0aa73a6d ;
    namiont:detailedInformation "Bau vom Architekturbüro Christ & Gantenbein"@de,
        "Grösster Lindt-Chocolate-Shop weltweit"@de,
        "Mit Café, Schokoladenkurs- und Event-Möglichkeiten"@de,
