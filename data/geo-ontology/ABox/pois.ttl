    geo:hasGeometry _:N3f654e2e899d4e1a951075d9cc6ec9b1 ;
    namiont:detailedInformation "Gemütlicher Rundweg ab Hombrechtikon"@de,
        "Seebad mit Floss und Spielplatz"@de,
        "Snacks & Getränke im Restaurant Hasel"@de,
        "Leisurely circular path from Hombrechtikon"@en,
        "Lido with a diving raft and playground"@en,
        "Snacks and drinks at the Hasel garden restaurant"@en,
