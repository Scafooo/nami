    namiont:textTeaser "Eine Schneeschuhwanderung durch die Winterlandschaft ist die reine Erholung für alle Naturliebhaber."@de,
        "A snowshoe hike through the peaceful winter landscape is pure relaxation for all nature lovers."@en,
        "Une balade à raquettes dans un paysage d'hiver  –  source de détente pour les amateurs de la nature"@fr,
        "Un'escursione con le racchette da neve attraverso il paesaggio invernale è un'esperienza rigenerativa unica per tutti gli amanti della natura"@it ;
    namiont:titleTeaser "Schneeschuhwandern in Amden"@de,
        "Amden snowshoe walking"@en,
        "Balades à raquettes"@fr,
        "Ciaspolate ad Amden"@it ;
    namiont:zurichCard false ;
    schema:address [ a schema:PostalAddress ;
            schema:addressCountry "CH" ;
            schema:addressLocality "Amden" ;
            schema:postalCode "8873" ;
