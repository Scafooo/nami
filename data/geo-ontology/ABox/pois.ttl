            schema:contentUrl <https://www.zuerich.com/sites/default/files/web_zuerich_bar_am_wasser_1280x960_25855.jpg> ] ;
    schema:license "CC BY-SA" ;
    schema:openingHours "Mo,Tu,We,Th,Fr,Sa 08:00:00-00:00:00" ;
    schema:url <https://www.baramwasser.ch> .

