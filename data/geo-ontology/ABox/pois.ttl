    namiont:osmId "344552961" ;
    namiont:placeType namiont:Outdoors ;
    namiont:textTeaser "Idyllisch gelegen ist das Freibad beim Dolder, das bei Einheimischen wie Gästen überaus beliebt ist."@de,
        "The idyllic outdoor swimming facility by the Dolder is very popular with locals and guests alike."@en,
        "La piscine en plein air bien située et proche du Dolder est appréciée des locaux comme des touristes."@fr,
        "La popolare piscina scoperta nei pressi del Dolder si trova in posizione incantevole."@it ;
    namiont:titleTeaser "Dolder Wellenbad"@de,
        "Dolder Wellenbad"@en,
        "Dolder Wellenbad"@fr,
        "Dolder Wellenbad"@it ;
