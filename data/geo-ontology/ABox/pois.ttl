    dct:subject <https://example.org/nami/data/category/76> ;
    geo:hasGeometry _:N1fc4f6725ab54ec79f2d4900a037b6da ;
    namiont:textTeaser "Design zu bezahlbaren Preisen, in einem Hotel, das sich um die schönsten Dinge der Schweiz dreht."@de,
        "Design at affordable prices in a hotel that is dedicated to the most beautiful things in Switzerland."@en,
        "Dans cet hôtel aux prix raisonnables, tout tourne autour des plus belles curiosités de Suisse."@fr,
        "Design a prezzi abbordabili, in un hotel dedicato agli aspetti più belli della Svizzera."@it ;
    namiont:titleTeaser "Motel One Zürich"@de,
        "Motel One Zurich"@en,
        "Motel One Zurich"@fr,
        "Motel One Zürich"@it ;
    schema:address [ a schema:PostalAddress ;
