    namiont:specialOpeningHoursNote "<p>Mehr unter&nbsp;<a href=\"http://www.hammambasar.ch/oeffnungszeiten\" target=\"_blank\">hammambasar.ch</a></p>"@de,
        "<p>More information on&nbsp;<a href=\"http://www.hammambasar.ch/oeffnungszeiten\" target=\"_blank\">hammambasar.ch</a></p>"@en,
        "<p>Hammam<br>Du mardi au vendredi, 11h &ndash; 20h<br>Samedi, 10h&nbsp;&ndash; 20h<br>Dimanche, 10h &ndash; 18h<p>Femmes&nbsp;: mardi, jeudi, vendredi, dimanche<br>Femmes et hommes : mercredi et samedi<br>Enfants : &agrave; partir de 4 ans</p><p>Cosm&eacute;tique<br>Femmes et hommes : du mardi au dimanche sur rendez-vous</p><p>Salon<br>Du mardi au vendredi, 11h30 &ndash; 22h30<br>Samedi, 10.00 &ndash; 22.30<br>Dimanche, 10.00 &ndash; 17.00</p><p>Bazar<br>Du mardi au vendredi, 11h &ndash; 18h30<br>Samedi, 11h &ndash; 18h</p><p>Pour&nbsp;en savoir plus: <a href=\"https://www.hammambasar.ch/oeffnungszeiten\" target=\"_blank\">www.hammambasar.ch</a></p></p>"@fr,
        "<p>Pi&ugrave; informazioni su&nbsp;<a href=\"https://www.hammambasar.ch/oeffnungszeiten\" target=\"_blank\">hammambasar.ch</a></p>"@it ;
    namiont:textTeaser "Hammam, Basar und Salon: Gesteigertes Wohlbefinden durch Reinigung und maghrebinische Spezialitäten."@de,
        "Hammam, bazaar and salon – enhance your well-being with cleansing rituals and Maghrebian specialties."@en,
        "Hammam, bazar et salon : bien-être accru grâce à une purification et des spécialités maghrébines."@fr,
        "Hammam, Basar e Salon: più benessere grazie a trattamenti di bellezza e specialità magrebine."@it ;
    namiont:titleTeaser "Hammam Basar + Salon"@de,
        "Hammam Basar + Salon"@en,
        "Hammam Basar + Salon"@fr,
