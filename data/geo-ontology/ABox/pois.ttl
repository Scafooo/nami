    geo:hasGeometry _:N11052abe42e44a1aa699cab1bfc81d41 ;
    namiont:detailedInformation "800 Jahre Stadt- und Kulturgeschichte"@de,
        "Kombination aus alter und neuer Architektur"@de,
        "Wechselausstellung"@de,
