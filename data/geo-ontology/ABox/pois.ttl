            schema:contentUrl <https://www.zuerich.com/sites/default/files/keyvisual/web_zurich_natur-und-sport_goldingertal_01.jpg> ] ;
    schema:license "CC BY-SA" ;
    schema:url <https://www.goldingertal.ch> .

