    namiont:textTeaser "Abends wird der Fokus auf Schweizer Kulinarik gesetzt mit einem Zwinkern zu saisonalen Klassikern."@de,
        "In the evening, the focus is on Swiss cuisine with a nod to seasonal classics."@en,
        "Le soir l’accent est mis sur la gastronomie suisse avec un clin d’œil aux classiques de saisons."@fr,
        "Di sera è la gastronomia svizzera a farla da padrona, con un debole per i classici stagionali."@it ;
    namiont:titleTeaser "Sedartis"@de,
        "Sedartis"@en,
        "Sedartis"@fr,
        "Sedartis"@it ;
    namiont:zurichCard false ;
    schema:address [ a schema:PostalAddress ;
            schema:addressCountry "CH" ;
            schema:addressLocality "Thalwil" ;
            schema:postalCode "8800" ;
            schema:streetAddress "Bahnhofstrasse 16" ] ;
    schema:copyrightHolder "Zürich Tourismus www.zuerich.com"@de,
        "Zurich Tourism www.zuerich.com"@en,
        "Zürich Tourisme www.zuerich.com"@fr,
