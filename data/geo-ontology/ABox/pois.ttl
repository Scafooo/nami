    dct:subject <https://example.org/nami/data/category/83> ;
    geo:hasGeometry _:N292b52721e6e4785936eb9d5b3bb2f10 ;
    namiont:customType "HolidayApartment" ;
    namiont:textTeaser "Grosszügige und luxuriöse Appartements mit hohen Räumen finden anspruchsvolle Gäste am Zürichberg."@de,
        "Discerning guests find spacious and luxurious apartments with high ceilings on the Zürichberg."@en,
