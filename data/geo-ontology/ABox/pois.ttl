    namiont:specialOpeningHoursNote "<p><strong>November bis Februar</strong><br>Montag bis Freitag 9.00 &ndash; 17.30 Uhr<br>Samstag 10.00 &ndash; 16.00 Uhr<p><br><strong>M&auml;rz bis Oktober:</strong><br>Montag bis Freitag 9.00 &ndash; 18.00 Uhr<br>Samstag 10.00 &ndash; 17.00 Uhr<br><br><strong>Geschlossen an Sonn- und Feiertagen</strong></p><p>&nbsp;</p></p>"@de,
        "<p><strong>November to February</strong><br>Monday to Friday, 9.00am &ndash; 5.30pm<br>Saturday, 10.00am &ndash; 4.00pm<p><strong>March to October</strong><br>Monday to Friday, 9.00am &ndash; 6.00pm<br>Saturday, 10.00am &ndash; 5.00pm</p><p>Closed on Sundays and public holidays</p></p>"@en,
        "<p><strong>De novembre &agrave; f&eacute;vrier</strong><br>Du lundi au vendredi, 9h &ndash; 17h30<br>Samedi, 10h &ndash; 16h<p><strong>De mars &agrave; octobre</strong><br>Du lundi au vendredi, 9h &ndash; 18h<br>Samedi, 10h &ndash; 17h</p><p>Ferm&eacute; les dimanches et jours f&eacute;ri&eacute;s</p></p>"@fr,
