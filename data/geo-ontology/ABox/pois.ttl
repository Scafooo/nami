    namiont:detailedInformation "Einheimische Tierarten"@de,
        "Naturerlebnispark vor den Toren der Stadt"@de,
        "Naturschutzgebiet"@de,
        "Native animal species"@en,
        "Nature discovery park at the gateway to the city"@en,
        "Nature reserve"@en,
        "Espèces animales indigènes"@fr,
        "Parc de découverte de la nature aux portes de la ville"@fr,
        "Réserve naturelle"@fr,
        "Fauna autoctona"@it,
        "Parco naturale didattico alle porte della città"@it,
        "Riserva naturale"@it ;
    namiont:osmId "149313708" ;
    namiont:placeType namiont:Outdoors ;
    namiont:specialOpeningHoursNote "<p><strong>Langenberg Ost</strong><br>Ein Grossteil der Tieranlagen ist 365 Tage w&auml;hrend 24 Stunden frei zug&auml;nglich.<p><strong>Langenberg West</strong><br>T&auml;glich, 9 .00 &ndash;&nbsp;16.00&nbsp; Uhr</p></p>"@de,
        "<p><strong>Langenberg Ost</strong><br>Most of the park's exhibits are accessible year round 24 / 7.<p><strong>Langenberg West</strong><br>Daily,&nbsp;9am&nbsp;&ndash; 4pm</p></p>"@en,
        "<p><strong>&nbsp;Langenberg Est</strong><br>Une grande partie du parc est&nbsp;accessible gratuitement, toute l'ann&eacute;e, 24 heures sur 24.<p><strong>Langenberg Ouest</strong><br>Tous les jours, 9h&nbsp;&ndash; 16h</p></p>"@fr,
        "<p><strong>Langenberg&nbsp;Ovest</strong><br>Una parte degli spazi &egrave; accessibile tutto l'anno, 24 ore su 24.<p><strong>Langenberg&nbsp;Est</strong><br>Tutti i giorni, 9.00 &ndash; 16.00</p></p>"@it ;
    namiont:textTeaser "Wolf & Co. – Im Tierpark Langenberg westlich des Zürichsees begegnet man den Wildtieren der Schweiz."@de,
        "Wolfs etc. – Explore the wild animals of Switzerland at the Langenberg wildlife park, west of Lake Zurich."@en,
        "Loup & Co. : Au Tierpark Langenberg vous rencontrerez les animaux sauvages de la Suisse."@fr,
        "Alla riserva naturale di Langenberg, a ovest del Lago di Zurigo, si incontrano gli animali selvatici della Svizzera."@it ;
    namiont:titleTeaser "Tierpark Langenberg"@de,
        "Langenberg Wildlife Park"@en,
        "Parc naturel Langenberg"@fr,
        "Riserva naturale di Langenberg"@it ;
    namiont:zurichCard false ;
    schema:address [ a schema:PostalAddress ;
            schema:addressCountry "CH" ;
            schema:addressLocality "Langnau am Albis" ;
            schema:postalCode "8135" ;
            schema:streetAddress "Albisstrasse 4" ] ;
    schema:copyrightHolder "Zürich Tourismus www.zuerich.com"@de,
        "Zurich Tourism www.zuerich.com"@en,
        "Zürich Tourisme www.zuerich.com"@fr,
        "Zürich Tourismo www.zuerich.com"@it ;
    schema:dateModified "2025-06-26T11:02:00"^^xsd:dateTime ;
    schema:dayOfWeek schema:Friday,
        schema:Monday,
        schema:Saturday,
        schema:Sunday,
        schema:Thursday,
        schema:Tuesday,
        schema:Wednesday ;
    schema:description "<p>Vor den Toren der Stadt Z&uuml;rich leben W&ouml;lfe, Braunb&auml;ren, Elche, Wildschweine und zahlreiche andere Wildtiere im Tierpark Langenberg.<p>Auf verschiedenen Rundwegen durch den Wald kann man die Tiere in ihrer nat&uuml;rlichen Umgebung beobachten. Diese sind nicht in kleine Gehege gezw&auml;ngt, sondern haben weitl&auml;ufige Anlagen, in denen sie sich auch zur&uuml;ckziehen und wie in freier Natur verhalten k&ouml;nnen.</p></p>"@de,
        "<p>Wolves, brown bears, elks, wild boar and many other wild animals live at the Langenberg wildlife park, outside the gateway to the city of Zurich.<p>The animals can be observed in their natural environment on various circular routes through the forest. The animals are not forced into small enclosures and instead have plenty of room to roam where they can also retreat or behave as they would in nature.</p></p>"@en,
        "<p>Aux portes de la ville de Zurich vivent&nbsp; loups, ours, &eacute;lans, sangliers et de nombreux&nbsp; autres animaux sauvages du Tierpark Langenberg.<p>A travers les diff&eacute;rents parcours forestiers, vous pourrez observer les animaux dans leur habitat naturel. Ces animaux ne sont pas dans de petits enclos, mais dans de vastes complexes o&ugrave; ils peuvent se retirer et se comporter comme s'ils se trouvaient en pleine nature.</p></p>"@fr,
        "<p>Alle porte di Zurigo, nella riserva naturale di Langenberg, vivono lupi, orsi bruni, alci, cinghiali e numerosi altri animali selvatici.<p>Su diversi percorsi circolari che attraversano il bosco &egrave; possibile osservare gli animali nel loro habitat naturale. Questi non sono costretti in piccole gabbie, ma hanno a disposizione ampi spazi, dove possono anche nascondersi e vivere come in libert&agrave;.</p></p>"@it ;
    schema:disambiguatingDescription "Wolf & Co. – Im Tierpark Langenberg westlich des Zürichsees begegnet man den Wildtieren der Schweiz."@de,
        "Wolfs etc. – Explore the wild animals of Switzerland at the Langenberg wildlife park, west of Lake Zurich."@en,
        "Loup & Co. : Au Tierpark (parc animalier) Langenberg, à l'ouest du lac de Zurich, vous rencontrerez les animaux sauvages de la Suisse."@fr,
        "Alla riserva naturale di Langenberg, a ovest del Lago di Zurigo, si incontrano gli animali selvatici della Svizzera."@it ;
    schema:email "info@wildnispark.ch" ;
