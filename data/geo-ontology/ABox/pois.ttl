                "Municipio di Zurigo"@it ;
            schema:contentUrl <https://www.zuerich.com/sites/default/files/keyvisual/web_zurich_sehenswuerigkeiten_stadthaus_01.jpg> ] ;
    schema:license "CC BY-SA" ;
    schema:openingHours "Mo,Tu,We,Th,Fr 08:00:00-18:00:00",
        "Sa 08:00:00-12:00:00" ;
    schema:priceRange "<p>Eintritt frei</p>"@de,
        "<p>Free admission</p>"@en,
        "<p>Entrée libre</p>"@fr,
        "<p>Ingresso gratuito</p>"@it ;
    schema:telephone "+41 44 412 11 11" ;
    schema:url <https://www.stadt-zuerich.ch/de/stadtleben/kultur/kultur-leben/kulturangebote/stadthaus-ausstellungen.html> .

