        [ a schema:ImageObject ;
            schema:contentUrl <https://www.zuerich.com/sites/default/files/web_zuerich_uetliberg_schlitteln_1280x960_25501.jpg> ],
        [ a schema:ImageObject ;
            schema:contentUrl <https://www.zuerich.com/sites/default/files/web_zuerich_uetliberg_schlitteln_1280x960_25507.jpg> ],
        [ a schema:ImageObject ;
            schema:contentUrl <https://www.zuerich.com/sites/default/files/web_zuerich_uetliberg_schlitteln_1280x960_25504.jpg> ] ;
    schema:telephone "+41 44 457 66 66" ;
    schema:url <https://www.utokulm.ch/uetliberg> .

