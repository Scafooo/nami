            schema:contentUrl <https://www.zuerich.com/sites/default/files/web_zuerich_kino_arena_cinema_sihlcity_1280x960_5952.jpg> ] ;
    schema:license "CC BY-SA" ;
    schema:telephone "+41 900 912 912" ;
    schema:url <https://www.arena.ch/de/sihlcity> .

