                "Cimitero Sihlfeld"@it ;
            schema:contentUrl <https://www.zuerich.com/sites/default/files/web_zuerich_friedhof_sihlfeld_1280x960_29746.jpg> ] ;
    schema:license "CC BY-SA" ;
    schema:telephone "+41 44 412 06 40" ;
    schema:url <https://www.stadt-zuerich.ch/de/lebenslagen/tod/friedhoefe/friedhof-sihlfeld.html> .

