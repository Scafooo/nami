            schema:contentUrl <https://www.zuerich.com/sites/default/files/web_zuerich_jogging_1280x960_22459.jpg> ] ;
    schema:license "CC BY-SA" ;
    schema:telephone "+41 44 254 25 00" ;
    schema:url <https://www.zoo.ch> .

