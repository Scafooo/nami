    namiont:textTeaser "Unweit von Rapperswil-Jona liegen zwei Inseln im Zürichsee – die kleinere ist die Insel Lützelau"@de,
        "There are two islands in Lake Zurich not far from Rapperswil-Jona. The smaller one is Lützelau Island"@en,
        "Près de Rapperswil-Jona se trouvent deux îles sur le lac, la plus petite s'appelle Lützelau"@fr,
        "Non lontano da Rapperswil-Jona si trovano due isole: la più piccola è l'Isola di Lützelau"@it ;
    namiont:titleTeaser "Insel Lützelau"@de,
        "Lützelau Island"@en,
        "L'île de Lützelau"@fr,
        "Isola di Lützelau"@it ;
    namiont:zurichCard false ;
    schema:address [ a schema:PostalAddress ;
            schema:addressCountry "CH" ;
            schema:addressLocality "Rapperswil" ;
            schema:postalCode "8640" ] ;
    schema:copyrightHolder "Zürich Tourismus www.zuerich.com"@de,
