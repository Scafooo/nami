    namiont:specialOpeningHoursNote "<p>Jeden Sonntag serviert La R&ocirc;tisserie von 11.30 &ndash; 15.00 Uhr einen Brunch.</p>"@de,
        "<p>Every Sunday, La R&ocirc;tisserie serves brunch from 11.30am &ndash; 3.00pm.</p>"@en,
