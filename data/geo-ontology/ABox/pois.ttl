    geo:hasGeometry _:Nca460232264847cd88ff6cfe9a932871 ;
    namiont:textTeaser "Design und Lifestyle Hotel mit einzigartigen Zimmern, sieben Restaurants, Wellness- und Spa-Bereich und Blick auf Zürichs Skyline."@de,
        "Design and lifestyle hotel with unique rooms, seven restaurants, a wellness and spa area, and a view of Zurich’s skyline."@en,
        "Hôtel design et lifestyle avec des chambres uniques, sept restaurants, un espace bien-être et spa et une vue sur la ligne d’horizon de Zurich."@fr,
        "Design hotel con camere favolose, sette ristoranti, area benessere, SPA e vista sulla skyline zurighese."@it ;
    namiont:titleTeaser "FIVE Zürich"@de,
        "FIVE Zurich"@en,
        "FIVE Zürich"@fr,
        "FIVE Zürich"@it ;
    schema:address [ a schema:PostalAddress ;
            schema:addressCountry "CH" ;
            schema:addressLocality "Zürich" ;
            schema:postalCode "8055" ;
            schema:streetAddress "Döltschiweg 234" ] ;
