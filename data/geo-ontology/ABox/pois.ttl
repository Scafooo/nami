    geo:hasGeometry _:N13831305ddf34cd38cc9c9fbabd59b82 ;
    namiont:detailedInformation "4.5 km Länge"@de,
        "430 Höhenmeter"@de,
        "Anspruchsvoll"@de,
        "Rodelmiete möglich"@de,
