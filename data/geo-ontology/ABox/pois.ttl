            schema:contentUrl <https://www.zuerich.com/sites/default/files/keyvisual/web_zuerich_weihnachtsmarkt_lintheschergasse.jpg> ] ;
    schema:license "CC BY-SA" ;
    schema:url <https://www.city-weihnachtsmarkt.ch/> .

