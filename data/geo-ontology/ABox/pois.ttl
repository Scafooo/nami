        "<table class=\"table\"><tbody><tr><td><strong>Adultes à partir de 18 ans</strong></td><td>CHF 10</td></tr><tr><td><strong>Jeunes de 12 à 18 ans 8 CHF</strong></td><td>CHF 8</td></tr><tr><td><strong>Enfants jusqu'à 12 ans</strong></td><td>gratuite</td></tr><tr><td><strong>Concessions</strong></td><td>CHF 8</td></tr><tr><td><strong>Visiteurs en possession d’une Zürich Card</strong></td><td>gratuite</td></tr></tbody></table>"@fr,
        "<table class=\"table\"><tbody><tr><td><strong>Adulti dai 18 anni</strong></td><td>CHF 10</td></tr><tr><td><strong>Ragazzi dai 12 ai&nbsp;18 anni</strong></td><td>CHF 8</td></tr><tr><td><strong>Bambini fino ai 12 anni</strong></td><td>gratuito</td></tr><tr><td><strong>Studenti</strong></td><td>CHF 8</td></tr><tr><td><strong>Visitatori in possesso di una Zürich Card</strong></td><td>gratuito</td></tr></tbody></table>"@it ;
