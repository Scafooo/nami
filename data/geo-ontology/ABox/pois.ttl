            schema:caption "Club Gonzo"@en ;
            schema:contentUrl <https://www.zuerich.com/sites/default/files/keyvisual/web_zurich_nightlife_gonzo_03.jpg> ] ;
    schema:license "CC BY-SA" ;
    schema:openingHours "Fr,Sa 23:00:00-06:00:00",
        "We,Th 23:00:00-04:00:00" ;
    schema:url <https://www.gonzoclub.ch> .

