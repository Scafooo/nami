    namiont:customType "HolidayHouse" ;
    namiont:textTeaser "Mit Blick auf den Zürichsee lädt das Chalet Elvira in Witikon (ZH) zum Verweilen und Entspannen ein."@de,
        "Surrounded by nature yet still in the city: a charming chalet with room for up to 5 guests."@en,
        "En pleine nature mais cependant en ville : ce charmant chalet peut accueillir jusqu’à 5 personnes."@fr,
        "In mezzo alla natura, eppure in città: un pittoresco chalet che può ospitare fino a 5 persone."@it ;
    namiont:titleTeaser "Chalet Elvira"@de,
        "Chalet Elvira"@en,
        "Chalet Elvira"@fr,
        "Chalet Elvira"@it ;
    schema:address [ a schema:PostalAddress ;
            schema:addressCountry "CH" ;
            schema:addressLocality "Zürich" ;
            schema:postalCode "8053" ;
