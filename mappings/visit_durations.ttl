# Typical visit duration, in minutes, per kind of place (paper, Sec. 4.4).
# A place takes the longest duration among the kinds it is an instance of;
# a place of no listed kind takes the default of the tour composer.
@prefix nami: <https://example.org/nami/ontology#> .
@prefix wd:  <http://www.wikidata.org/entity/> .

wd:Q33506    nami:visitMinutes 90 .   # museum
wd:Q207694   nami:visitMinutes 90 .   # art museum
