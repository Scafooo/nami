wd:Q3918     nami:visitMinutes 20 .   # university
wd:Q7075     nami:visitMinutes 20 .   # library
wd:Q24354    nami:visitMinutes 15 .   # theatre building
wd:Q41176    nami:visitMinutes 10 .   # building
